@using MonoNotes.Core.Models
@using MonoNotes.Storage
@inject WriteSpaceRepository Repository

@code {
    [Parameter] public EventCallback<string> OnWorkSelected { get; set; }

    // 🌟 向父组件传递全局菜单切换的信号
    [Parameter] public EventCallback<string> OnGlobalMenuSelected { get; set; }

    private List<WorkMeta> Works = new();

    // 记录当前选中的全局菜单项
    private string CurrentMenu = "dashboard";

    protected override async Task OnInitializedAsync()
    {
        var allWorks = await Repository.GetAllWorksAsync();
        // 🌟 修复：快捷书架必须过滤掉回收站里的书
        Works = allWorks.Where(w => !w.IsDeleted).OrderByDescending(w => w.LastEditedAt).ToList();
    }

    // 🌟 菜单点击事件
    private async Task SelectMenu(string menu)
    {
        CurrentMenu = menu;
        await OnGlobalMenuSelected.InvokeAsync(menu);
    }

    // 🌟 追加这个方法，让母画面(父组件)可以强制刷新快捷书架
    public async Task RefreshAsync()
    {
        var allWorks = await Repository.GetAllWorksAsync();
        Works = allWorks.Where(w => !w.IsDeleted).OrderByDescending(w => w.LastEditedAt).ToList();
        StateHasChanged();
    }
}

<div class="global-sidebar-container">
    <div class="sidebar-header">
        <div class="workspace-name">
            <span class="icon">💻</span> MonoDraft 写作台
        </div>
    </div>

    <div class="sidebar-nav">
        <div class="nav-item @(CurrentMenu == "dashboard" ? "active" : "")" @onclick="@(() => SelectMenu("dashboard"))">
            <span class="icon">🏠</span> 工作台大厅
        </div>
        <div class="nav-item @(CurrentMenu == "materials" ? "active" : "")" @onclick="@(() => SelectMenu("materials"))">
            <span class="icon">🌍</span> 全局资源设定集
        </div>
        <div class="nav-item @(CurrentMenu == "trash" ? "active" : "")" @onclick="@(() => SelectMenu("trash"))">
            <span class="icon">🗑️</span> 回收站
        </div>
    </div>

    <div class="works-section">
        <div class="section-title">
            <span>📚 快捷书架</span>
            <span class="count">@Works.Count 本</span>
        </div>

        <div class="works-list">
            @if (!Works.Any())
            {
                <div class="empty-hint">暂无作品，请在右侧新建</div>
            }
            else
            {
                @foreach (var work in Works)
                {
                    <div class="work-item" @onclick="() => OnWorkSelected.InvokeAsync(work.Id)">
                        <span class="work-icon">
                            @(work.Status == "serializing" ? "🟢" : "📖")
                        </span>
                        <span class="work-title" title="@work.Title">@work.Title</span>
                    </div>
                }
            }
        </div>
    </div>

    <div class="sidebar-footer">
        <div class="nav-item">
            <span class="icon">⚙️</span> 软件设置
        </div>
    </div>
</div>
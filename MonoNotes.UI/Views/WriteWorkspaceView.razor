@code {
    private string? ActiveWorkId { get; set; } = null;

    // 🌟 默认值改为 editor，这样一进入小说，左侧的"正文"就会默认高亮
    private string CurrentSubView { get; set; } = "editor";

    private string GlobalSubView { get; set; } = "dashboard";
    private MonoNotes.UI.Views.WorkSidebar _workSidebar;

    private string ActiveVolumeId { get; set; } = string.Empty;
    private string ActiveChapterId { get; set; } = string.Empty;

    private void HandleGlobalMenuChanged(string menuName)
    {
        GlobalSubView = menuName;
        StateHasChanged();
    }

    private void EnterWork(string workId)
    {
        ActiveWorkId = workId;
        ActiveVolumeId = string.Empty;
        ActiveChapterId = string.Empty;
        CurrentSubView = "editor"; // 🌟 初始化为 editor，配合下面的路由拦截，完美呈现大屏
        StateHasChanged();
    }

    private void ReturnToGlobal()
    {
        ActiveWorkId = null;
        StateHasChanged();
    }

    // 🌟 接收面板上的快捷入口点击事件，并切换视图
    private void HandleSubViewChanged(string viewName)
    {
        CurrentSubView = viewName;
        StateHasChanged();
    }

    private void HandleChapterSelected(string chapterId)
    {
        ActiveChapterId = chapterId;
        ActiveVolumeId = string.Empty;

        if (CurrentSubView != "editor" && CurrentSubView != "outline")
        {
            CurrentSubView = "editor";
        }
        StateHasChanged();
    }

    private void HandleVolumeSelected(string volumeId)
    {
        ActiveVolumeId = volumeId;
        ActiveChapterId = string.Empty;

        if (CurrentSubView == "editor")
        {
            CurrentSubView = "outline";
        }
        StateHasChanged();
    }

    private async Task HandleIndexUpdated()
    {
        if (_workSidebar != null)
        {
            await _workSidebar.RefreshAsync();
        }
    }

    private void HandleEnterEditorFromOverview(string chapterId)
    {
        if (!string.IsNullOrEmpty(chapterId))
        {
            ActiveChapterId = chapterId;
        }
        CurrentSubView = "editor";
        StateHasChanged();
    }
}

<div class="write-workspace-layout">
    <div class="sidebar-region">
        @if (string.IsNullOrEmpty(ActiveWorkId))
        {
            <GlobalSidebar OnWorkSelected="EnterWork" OnGlobalMenuSelected="HandleGlobalMenuChanged" />
        }
        else
        {
            @* <WorkSidebar @ref="_workSidebar"
                         CurrentWorkId="@ActiveWorkId"
                         ActiveSubView="@CurrentSubView"
                         OnReturnClicked="ReturnToGlobal"
                         OnSubViewSelected="HandleSubViewChanged"
                         OnChapterSelected="HandleChapterSelected"
                         OnVolumeSelected="HandleVolumeSelected" /> *@

           
                <WorkSidebar @ref="_workSidebar"
                             CurrentWorkId="@ActiveWorkId"
                             CurrentVolumeId="@ActiveVolumeId" 
                             CurrentChapterId="@ActiveChapterId" 
                             ActiveSubView="@CurrentSubView"
                             OnReturnClicked="ReturnToGlobal"
                             OnSubViewSelected="HandleSubViewChanged"
                             OnChapterSelected="HandleChapterSelected"
                             OnVolumeSelected="HandleVolumeSelected" />
            
        }
    </div>

    <div class="main-content-region">
        @if (string.IsNullOrEmpty(ActiveWorkId))
        {
            @if (GlobalSubView == "dashboard")
            {
                <GlobalDashboard OnWorkSelected="EnterWork" />
            }
            else if (GlobalSubView == "materials")
            {
                <GlobalMaterialsView />
            }
            else if (GlobalSubView == "trash")
            {
                <div style="display:flex; justify-content:center; align-items:center; height:100%; color:#999;">
                    <h2>🗑️ 回收站开发中...</h2>
                </div>
            }
        }
        else
        {
            @if (CurrentSubView == "overview" || (CurrentSubView == "editor" && string.IsNullOrEmpty(ActiveChapterId)))
            {
                <WorkOverviewDesk CurrentWorkId="@ActiveWorkId"
                                  OnEnterEditor="HandleEnterEditorFromOverview"
                                  OnNavigate="HandleSubViewChanged" />
            }
            else if (CurrentSubView == "editor" && !string.IsNullOrEmpty(ActiveChapterId))
            {
                <WorkEditorDesk CurrentWorkId="@ActiveWorkId"
                                CurrentChapterId="@ActiveChapterId"
                                OnTitleChanged="HandleIndexUpdated"
                                OnSwitchChapter="HandleChapterSelected" />
            
            }
            else if (CurrentSubView == "outline")
            {
                <WorkOutlineDesk CurrentWorkId="@ActiveWorkId"
                                 CurrentVolumeId="@ActiveVolumeId"
                                 CurrentChapterId="@ActiveChapterId"
                                 OnTitleChanged="HandleIndexUpdated" />
            }
            else if (CurrentSubView == "foreshadowing")
            {
                <ForeshadowingBoard CurrentWorkId="@ActiveWorkId" />
            }
            else if (CurrentSubView == "details")
            {
                <WorkDetailsView CurrentWorkId="@ActiveWorkId" />
            }
            else if (CurrentSubView == "materials")
            {
                <WorkMaterialsView CurrentWorkId="@ActiveWorkId" />
            }
        }
    </div>
</div>
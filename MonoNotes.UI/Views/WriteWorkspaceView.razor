@code {
    private string? ActiveWorkId { get; set; } = null;
    private string CurrentSubView { get; set; } = "editor";

    private MonoNotes.UI.Views.WorkSidebar _workSidebar;

    private void EnterWork(string workId)
    {
        ActiveWorkId = workId;
        CurrentSubView = "overview";
        StateHasChanged();
    }

    private void ReturnToGlobal()
    {
        ActiveWorkId = null;
        StateHasChanged();
    }

    private void HandleSubViewChanged(string viewName)
    {
        CurrentSubView = viewName;
    }

    private string ActiveChapterId { get; set; } = string.Empty;

    private void HandleChapterSelected(string chapterId)
    {
        ActiveChapterId = chapterId;
        CurrentSubView = "editor";
    }

    private async Task HandleIndexUpdated()
    {
        if (_workSidebar != null)
        {
            await _workSidebar.RefreshAsync();
        }
    }

    // 🌟 新增：接收从控制台传来的章节ID，并进入正文模式
    private void HandleEnterEditorFromOverview(string chapterId)
    {
        if (!string.IsNullOrEmpty(chapterId))
        {
            ActiveChapterId = chapterId;
        }
        CurrentSubView = "editor";
        StateHasChanged();
    }
}

<div class="write-workspace-layout">
    <div class="sidebar-region">
        @if (string.IsNullOrEmpty(ActiveWorkId))
        {
            <GlobalSidebar OnWorkSelected="EnterWork" />
        }
        else
        {
            <WorkSidebar @ref="_workSidebar"
                         CurrentWorkId="@ActiveWorkId"
                         ActiveSubView="@CurrentSubView"
                         OnReturnClicked="ReturnToGlobal"
                         OnSubViewSelected="HandleSubViewChanged"
                         OnChapterSelected="HandleChapterSelected" />
        }
    </div>

    <div class="main-content-region">
        @if (string.IsNullOrEmpty(ActiveWorkId))
        {
            <GlobalDashboard OnWorkSelected="EnterWork" />
        }
        else
        {
            @if (CurrentSubView == "overview")
            {
                <WorkOverviewDesk CurrentWorkId="@ActiveWorkId"
                                  OnEnterEditor="HandleEnterEditorFromOverview" />
            }
            else if (CurrentSubView == "editor")
            {
                <WorkEditorDesk CurrentWorkId="@ActiveWorkId"
                                CurrentChapterId="@ActiveChapterId"
                                OnTitleChanged="HandleIndexUpdated" />
            }
            else if (CurrentSubView == "foreshadowing")
            {
                <ForeshadowingBoard CurrentWorkId="@ActiveWorkId" />
            }
            else if (CurrentSubView == "details")
            {
                <WorkDetailsView CurrentWorkId="@ActiveWorkId" />
            }
        }
    </div>
</div>
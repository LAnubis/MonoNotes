@using Microsoft.AspNetCore.Components.Forms
@using MonoNotes.Core.Models
@using MonoNotes.Storage
@inject WriteSpaceRepository Repository

@code {
    [Parameter] public EventCallback<string> OnWorkSelected { get; set; }

    // 🌟 新增：通知母画面作品列表发生变动
    [Parameter] public EventCallback OnWorkListChanged { get; set; }

    private List<WorkMeta> Works = new();
    private bool IsGridView = true;

    private int TodayWordCount = 0;
    private int TotalWordCount = 0;
    private Dictionary<string, int> DailyStats = new();
    private List<DateTime> HeatmapDays = Enumerable.Range(0, 90).Select(i => DateTime.Now.Date.AddDays(-89 + i)).ToList();

    private bool ShowImportModal = false;
    private bool IsParsing = false;
    private bool IsSaving = false;
    private ImportPreviewWork? PreviewWork = null;

    private void CloseImportModal()
    {
        ShowImportModal = false;
        PreviewWork = null;
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        ShowImportModal = true;
        IsParsing = true;
        PreviewWork = null;
        StateHasChanged();
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 50);
            await Task.Delay(500);
            PreviewWork = await ImportEngine.ParseStreamAsync(stream, file.Name);
        }
        catch (Exception ex) { Console.WriteLine($"解析失败: {ex.Message}"); }
        finally { IsParsing = false; StateHasChanged(); }
    }

    private async Task ConfirmImport()
    {
        if (PreviewWork == null) return;
        IsSaving = true;
        StateHasChanged();
        string newWorkId = await ImportEngine.ExecuteImportAsync(Repository, PreviewWork);
        IsSaving = false;
        ShowImportModal = false;
        await LoadWorksAsync();

        // 🌟 导入成功后触发刷新通知
        if (OnWorkListChanged.HasDelegate) { await OnWorkListChanged.InvokeAsync(); }

        await OnWorkSelected.InvokeAsync(newWorkId);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWorksAsync();
        await LoadStatsAsync();
    }

    private async Task LoadWorksAsync()
    {
        var allWorks = await Repository.GetAllWorksAsync();
        Works = allWorks.Where(w => !w.IsDeleted).ToList();
    }

    private async Task MoveToTrash(string workId)
    {
        await Repository.MoveWorkToTrashAsync(workId);
        await LoadWorksAsync();

        // 🌟 放入回收站后触发刷新通知
        if (OnWorkListChanged.HasDelegate) { await OnWorkListChanged.InvokeAsync(); }
        StateHasChanged();
    }

    private async Task LoadStatsAsync()
    {
        DailyStats = await Repository.GetDailyStatsAsync();
        string todayStr = DateTime.Now.ToString("yyyy-MM-dd");
        if (DailyStats.ContainsKey(todayStr)) TodayWordCount = DailyStats[todayStr];
        TotalWordCount = DailyStats.Values.Sum();
    }

    private async Task CreateNewWork()
    {
        var newWork = await Repository.CreateNewWorkAsync("未命名新作", "novel");

        // 🌟 新建成功后触发刷新通知
        if (OnWorkListChanged.HasDelegate) { await OnWorkListChanged.InvokeAsync(); }

        await OnWorkSelected.InvokeAsync(newWork.Id);
    }

    private void ToggleView(bool gridView) { IsGridView = gridView; }
    private string GetHeatColor(int words)
    {
        if (words == 0) return "#ebedf0";
        if (words < 1000) return "#9be9a8";
        if (words < 3000) return "#40c463";
        if (words < 6000) return "#30a14e";
        return "#216e39";
    }

    private string GetStatusText(string status) => status switch
    {
        "serializing" => "连载中",
        "finished" => "已完结",
        "paused" => "暂停更新",
        _ => "构思草稿"
    };
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="header-titles">
            <h1>👋 欢迎回到写作台</h1>
            <p class="subtitle">键盘敲击的每一次，都是世界运转的齿轮。</p>
        </div>
        <div class="header-actions">
            <InputFile id="file-import" OnChange="HandleFileUpload" accept=".txt,.md" style="display:none;" />
            <label for="file-import" class="btn-outline-large" title="支持 TXT / MD 格式">
                <span class="icon">📥</span> 本地导入
            </label>
            <button class="btn-primary-large" @onclick="CreateNewWork">
                <span class="icon">➕</span> 新建作品
            </button>
        </div>
    </div>

    <div class="dashboard-stats-row">
        <div class="stat-card primary">
            <div class="stat-label">🔥 今日打字 (字)</div>
            <div class="stat-value">@TodayWordCount.ToString("N0")</div>
            <div class="stat-desc">保持热爱，笔耕不辍</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">📚 累计创作 (字)</div>
            <div class="stat-value">@TotalWordCount.ToString("N0")</div>
            <div class="stat-desc">所有作品总和</div>
        </div>
        <div class="stat-card heatmap-card">
            <div class="heatmap-header">
                <div class="stat-label">近 90 天创作热力图</div>
                <div class="heat-legend">
                    <span>少</span>
                    <div class="heat-box" style="background-color: #ebedf0;"></div>
                    <div class="heat-box" style="background-color: #9be9a8;"></div>
                    <div class="heat-box" style="background-color: #40c463;"></div>
                    <div class="heat-box" style="background-color: #30a14e;"></div>
                    <div class="heat-box" style="background-color: #216e39;"></div>
                    <span>多</span>
                </div>
            </div>
            <div class="heatmap-grid">
                @foreach (var day in HeatmapDays)
                {
                    string dateKey = day.ToString("yyyy-MM-dd");
                    int words = DailyStats.ContainsKey(dateKey) ? DailyStats[dateKey] : 0;
                    string color = GetHeatColor(words);
                    <div class="heat-box" style="background-color: @color;" title="@dateKey : 写作 @words 字"></div>
                }
            </div>
        </div>
    </div>

    <div class="works-section">
        <div class="section-header">
            <h2>📚 我的作品库 <span class="header-tip">(共 @Works.Count 部)</span></h2>
            <div class="view-toggle-group">
                <button class="view-btn @(IsGridView ? "active" : "")" title="网格视图" @onclick="() => ToggleView(true)">🔲</button>
                <button class="view-btn @(!IsGridView ? "active" : "")" title="列表视图" @onclick="() => ToggleView(false)">📄</button>
            </div>
        </div>

        @if (!Works.Any())
        {
            <div class="empty-state">
                <span class="empty-icon">📭</span>
                <p>大厅暂无作品，点击右上角新建，或者去回收站看一眼吧！</p>
            </div>
        }
        else
        {
            @if (IsGridView)
            {
                <div class="books-grid">
                    @foreach (var work in Works)
                    {
                        <div class="book-card" @onclick="() => OnWorkSelected.InvokeAsync(work.Id)">
                            <div class="cover-box">
                                @if (string.IsNullOrEmpty(work.CoverUrl))
                                {
                                    <div class="no-cover"><span>@(work.Title.FirstOrDefault())</span></div>
                                }
                                else
                                {
                                    <img src="@work.CoverUrl" alt="封面" />
                                }
                                <div class="hover-overlay">
                                    <span class="enter-text">进入写作</span>
                                    <button class="btn-trash" title="移入回收站" @onclick:stopPropagation="true" @onclick="() => MoveToTrash(work.Id)">🗑️</button>
                                </div>
                            </div>
                            <div class="book-info">
                                <h4 class="book-title" title="@work.Title">@work.Title</h4>
                                <div class="book-meta">
                                    <span class="status-dot @work.Status"></span>
                                    <span class="time-text">更新于 @work.LastEditedAt.ToString("MM-dd")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="recent-works-list">
                    @foreach (var work in Works)
                    {
                        <div class="list-item-card" @onclick="() => OnWorkSelected.InvokeAsync(work.Id)">
                            <div class="item-cover">
                                @if (string.IsNullOrEmpty(work.CoverUrl))
                                {
                                    <span class="no-cover-icon">📖</span>
                                }
                                else
                                {
                                    <img src="@work.CoverUrl" alt="cover" />
                                }
                            </div>
                            <div class="item-info">
                                <div class="item-title" title="@work.Title">@work.Title</div>
                                <div class="item-meta"><span class="item-time">最近修改: @work.LastEditedAt.ToString("yyyy-MM-dd HH:mm")</span></div>
                            </div>
                            <div class="item-actions">
                                <div class="work-status @work.Status">@GetStatusText(work.Status)</div>
                                <button class="btn-trash-list" title="移入回收站" @onclick:stopPropagation="true" @onclick="() => MoveToTrash(work.Id)">🗑️ 删除</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@if (ShowImportModal)
{
    <div class="modal-overlay" @onclick="CloseImportModal"></div>
    <div class="import-modal">
        <div class="modal-header">
            <h3>📥 智能分章解析引擎</h3>
            <button class="close-btn" @onclick="CloseImportModal">✖</button>
        </div>

        <div class="modal-body">
            @if (IsParsing)
            {
                <div class="parsing-state">
                    <div class="spinner">🌀</div>
                    <p>正在用正则嗅探文件结构，切分卷章中...</p>
                </div>
            }
            else if (PreviewWork != null)
            {
                <div class="preview-stats">
                    <span class="stat-badge">📊 检测到: @PreviewWork.Volumes.Count 卷</span>
                    <span class="stat-badge">📑 共: @PreviewWork.Volumes.Sum(v => v.Chapters.Count) 章</span>
                    <span class="stat-badge">✍️ 约: @PreviewWork.TotalWords.ToString("N0") 字</span>
                </div>

                <div class="preview-tree hide-scrollbar">
                    @foreach (var vol in PreviewWork.Volumes)
                    {
                        <div class="tree-volume">
                            <div class="vol-title">📁 @vol.Title</div>
                            <div class="tree-chapters">
                                @foreach (var chap in vol.Chapters)
                                {
                                    <div class="chap-item">
                                        <span class="chap-name">📄 @chap.Title</span>
                                        <span class="chap-words">@chap.WordCount 字</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-actions">
                    <button class="btn-cancel" @onclick="CloseImportModal" disabled="@IsSaving">取消</button>
                    <button class="btn-primary-large" @onclick="ConfirmImport" disabled="@IsSaving">
                        @(IsSaving ? "🚀 正在生成宇宙..." : "✅ 确认无误，生成作品")
                    </button>
                </div>
            }
        </div>
    </div>
}


@using MonoNotes.Core.Models
@using MonoNotes.Storage
@inject WriteSpaceRepository Repository

@code {
    [Parameter]
    public EventCallback<string> OnWorkSelected { get; set; }

    // 获取当天的问候语
    private string Greeting => DateTime.Now.Hour switch
    {
        < 6 => "夜深了，注意休息，",
        < 12 => "早安，今天也要文思泉涌，",
        < 18 => "下午好，喝杯咖啡继续创作吧，",
        _ => "晚上好，属于你的世界正在展开，"
    };

    // 🌟 换成真实的元数据列表
    private List<WorkMeta> RecentWorks = new();

    // 全库总字数统计
    private int TotalWordCount => RecentWorks.Sum(w => w.WordCountCache);

    // 页面初始化时，从硬盘读取所有作品
    protected override async Task OnInitializedAsync()
    {
        await LoadWorksAsync();
    }

    private async Task LoadWorksAsync()
    {
        // 🌟 真正从底层 JSON 索引中读取数据
        RecentWorks = await Repository.GetAllWorksAsync();
    }

    // 🌟 实现新建作品的核心逻辑
    private async Task CreateNewWork()
    {
        // 1. 在硬盘上创建文件夹和基础的 JSON 索引
        var newWork = await Repository.CreateNewWorkAsync("未命名小说", "novel");

        // 2. 重新加载列表，让新书出现在页面上
        await LoadWorksAsync();

        // 3. （可选）如果你希望新建后直接进入这本新书，取消下面这句的注释
        // await OnWorkSelected.InvokeAsync(newWork.Id);
    }

    // 模拟的当月打卡热力数据 (这部分未来可以挂载到真实的打卡表上，暂时保留 UI)
    private int[] HeatmapData = new int[30]
    {
        0, 1, 3, 4, 2, 0, 1, 2, 4, 4, 3, 1, 0, 2, 3, 3, 4, 1, 0, 2, 3, 4, 2, 1, 1, 0, 3, 4, 2, 4
    };
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="header-text">
            <h2>@Greeting 大作家。</h2>
            <p class="subtitle">今天是你坚持写作的第 <strong>142</strong> 天，继续创造奇迹吧。</p>
        </div>
        <button class="primary-btn" @onclick="CreateNewWork">➕ 新建作品</button>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon" style="background: #e3f2fd; color: #1976d2;">📝</div>
            <div class="stat-info">
                <div class="stat-value">0 <span class="stat-unit">字</span></div>
                <div class="stat-label">今日已写 (目标 5000)</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #f3e5f5; color: #7b1fa2;">📚</div>
            <div class="stat-info">
                <div class="stat-value">@TotalWordCount.ToString("N0") <span class="stat-unit">字</span></div>
                <div class="stat-label">全库总字数</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #e8f5e9; color: #388e3c;">🔥</div>
            <div class="stat-info">
                <div class="stat-value">12 <span class="stat-unit">天</span></div>
                <div class="stat-label">当前连续打卡</div>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="recent-works-section">
            <h3 class="section-title">最近编辑</h3>
            <div class="works-list">
                @if (!RecentWorks.Any())
                {
                    <div style="text-align: center; color: #999; padding: 40px 0;">
                        <div style="font-size: 40px; margin-bottom: 10px;">📭</div>
                        这里空空如也，点击右上角新建第一部作品吧！
                    </div>
                }
                else
                {
                    @foreach (var work in RecentWorks)
                    {
                        <div class="work-card">
                            <div class="work-icon">@(work.WorkType == "novel" ? "📖" : "📝")</div>
                            <div class="work-details">
                                <h4 class="work-title">@work.Title</h4>
                                <div class="work-meta">
                                    <span>@work.WordCountCache.ToString("N0") 字</span>
                                    <span class="separator">•</span>
                                    <span>@work.LastEditedAt.ToString("MM-dd HH:mm") 修改</span>
                                </div>
                            </div>
                            <button class="open-btn" @onclick="() => OnWorkSelected.InvokeAsync(work.Id)">进入写作</button>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="heatmap-section">
            <h3 class="section-title">近30天创作热力图</h3>
            <div class="heatmap-card">
                <div class="heatmap-grid">
                    @foreach (var level in HeatmapData)
                    {
                        <div class="heatmap-cell level-@level"></div>
                    }
                </div>
                <div class="heatmap-legend">
                    <span>少</span>
                    <div class="legend-color level-0"></div>
                    <div class="legend-color level-1"></div>
                    <div class="legend-color level-2"></div>
                    <div class="legend-color level-3"></div>
                    <div class="legend-color level-4"></div>
                    <span>多</span>
                </div>
            </div>
        </div>
    </div>
</div>
@using Microsoft.JSInterop
@using System.IO
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@inject MonoNotes.Core.Interfaces.INoteRepository NoteRepository

<div id="@_editorId" class="vditor-container" style="height: 100%;"></div>

@code {
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ContentChanged { get; set; }

    // 🌟 接收当前笔记所在的文件夹路径（用于计算相对路径）
    [Parameter] public string CurrentFolder { get; set; } = string.Empty;

    private readonly string _editorId = "editor-" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<MarkdownEditor>? _dotNetHelper;
    private bool _isInitialized = false;
    private string _lastRenderedContent = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            _lastRenderedContent = Content;
            // 初始化 Vditor，并将 C# 引用传给 JS
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.initVditor", _editorId, Content, _dotNetHelper);
            _isInitialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // 当外部切换笔记时，更新编辑器内容
        if (_isInitialized && Content != _lastRenderedContent)
        {
            _lastRenderedContent = Content;
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.setVditorContent", _editorId, Content);
        }
    }

    // 供 JS 实时回传内容
    [JSInvokable]
    public async Task UpdateContent(string newContent)
    {
        if (Content != newContent)
        {
            Content = newContent;
            _lastRenderedContent = newContent;
            await ContentChanged.InvokeAsync(newContent);
        }
    }

    // 🌟 核心拦截器：供 JS 调用的图片保存接口
    [JSInvokable]
    public async Task<string> UploadImageAsync(string base64Data, string fileName)
    {
        var base64Span = base64Data.Contains(',') ? base64Data.Split(',')[1] : base64Data;
        var bytes = Convert.FromBase64String(base64Span);

        var ext = Path.GetExtension(fileName);
        if (string.IsNullOrEmpty(ext)) ext = ".png";

        var savedFileName = await NoteRepository.SaveAssetAsync(bytes, ext);

        // 🌟 降维打击：永远返回虚拟域名的绝对路径
        // 这样不仅能在 Vditor 中瞬间显示，而且再也不用算 ../../ 了！
        return $"https://mononotes.local/.assets/{savedFileName}";
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetHelper?.Dispose();
    }
}
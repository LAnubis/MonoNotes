@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div id="@_editorId" class="tui-editor-container" style="height: 100%;"></div>

<style>
    /* 1. 隐藏编辑器外层丑陋的边框 */
    .tui-editor-container .toastui-editor-defaultUI {
        border: none !important;
    }

    /* 2. 【核心修复】将菜单栏高度大幅压缩，融入背景 */
    .tui-editor-container .toastui-editor-defaultUI-toolbar {
        height: 40px !important; /* 原本大概是60px，直接压低 */
        padding: 0 10px !important;
        border-bottom: 1px solid rgba(55, 53, 47, 0.09) !important;
        background: transparent !important;
    }

    /* 3. 让菜单里的按钮容器贴合高度 */
    .tui-editor-container .toastui-editor-toolbar-group {
        height: 40px !important;
    }

    /* 4. （可选）把里面的工具图标稍微缩小一点，更显精致 */
    .tui-editor-container .toastui-editor-defaultUI-toolbar button {
        width: 28px !important;
        height: 28px !important;
        margin: 0 2px !important;
    }

    /* 5. 调整编辑器主体区顶部的间距 */
    .tui-editor-container .toastui-editor-main {
        margin-top: 5px !important;
    }
</style>

@code {
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ContentChanged { get; set; }

    // 为每个编辑器实例生成唯一 ID
    private readonly string _editorId = "editor-" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<MarkdownEditor>? _dotNetHelper;
    private bool _isInitialized = false;
    private string _lastRenderedContent = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            _lastRenderedContent = Content;
            // 将唯一的 ID 传给 JS
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.init", _editorId, _dotNetHelper, Content);
            _isInitialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isInitialized && Content != _lastRenderedContent)
        {
            _lastRenderedContent = Content;
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.setContent", _editorId, Content);
        }
    }

    [JSInvokable]
    public async Task UpdateContent(string newContent)
    {
        if (Content != newContent)
        {
            Content = newContent;
            _lastRenderedContent = newContent;
            await ContentChanged.InvokeAsync(newContent);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetHelper?.Dispose();
    }
}
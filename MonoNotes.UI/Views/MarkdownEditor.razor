@using Microsoft.JSInterop
@using System.IO
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@inject MonoNotes.Core.Interfaces.INoteRepository NoteRepository

<div id="@_editorId" class="vditor-container" style="height: 100%;"></div>
<style>
    /* ========================================== */
    /* 🎨 Vditor 大纲：与标题完美平齐的终极形态    */
    /* ========================================== */

    /* 1. 拆除 Vditor 自带的定位，允许大纲越狱 */
    .vditor, .vditor-content {
        position: static !important;
        border: none !important;
    }

    /* 2. 编辑器内容区正常滚动 */
    .vditor-ir, .vditor-wysiwyg {
        height: 100% !important;
        overflow-y: auto !important;
    }

    /* 3. 🌟 核心越狱：大纲绝对定位（悬浮面板形态） */
    .vditor-outline {
        position: absolute !important;
        /* 👇 调整这三个值来控制空隙大小 */
        top: 20px !important; /* 距离顶部 20px */
        bottom: 20px !important; /* 距离底部 20px */
        right: 20px !important; /* 距离右侧 20px */

        width: 240px !important;
        height: auto !important; /* 🌟 核心：放弃 100% 高度，让 top 和 bottom 自动撑开它 */

        display: block !important;
        z-index: 100 !important;
        /* 🎨 悬浮卡片视觉美化 */
        background-color: #fcfcfc !important; /* 给定一个极其淡的纯净底色 */
        border: 1px solid rgba(55, 53, 47, 0.06) !important; /* 加上全包围的超淡边框 */
        border-radius: 12px !important; /* 🌟 增加高级圆角 */
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04) !important; /* 🌟 增加弥散的悬浮阴影 */

        padding: 16px 12px 24px 12px !important;
        overflow-y: auto !important;
    }

        /* 4. 极简视网膜级滚动条 */
        .vditor-outline::-webkit-scrollbar {
            width: 4px !important;
            background: transparent !important;
        }

        .vditor-outline::-webkit-scrollbar-thumb {
            background: rgba(55, 53, 47, 0.1) !important;
            border-radius: 4px !important;
        }

    /* 5. 顶部“目录”文字美化 */
    .vditor-outline__title {
        display: block !important;
        font-size: 11px !important;
        font-weight: 600 !important;
        color: rgba(55, 53, 47, 0.4) !important;
        margin-bottom: 14px !important;
        padding-left: 8px !important;
    }

    /* 6. 多级树状缩进精细调优 */
    .vditor-outline ul {
        margin: 0 !important;
        padding-left: 12px !important;
        list-style: none !important;
    }

    .vditor-outline > ul {
        padding-left: 0 !important;
    }

    .vditor-outline li {
        margin: 3px 0 !important;
    }

    /* 7. 标题文本交互样式 */
    .vditor-outline ul li > span {
        color: rgba(55, 53, 47, 0.6) !important;
        font-size: 13px !important;
        line-height: 1.5 !important;
        border-radius: 5px !important;
        padding: 5px 10px 5px 8px !important;
        display: block !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        cursor: pointer !important;
        transition: all 0.15s ease !important;
        border-left: 3px solid transparent !important;
    }

        .vditor-outline ul li > span:hover {
            background-color: rgba(55, 53, 47, 0.04) !important;
            color: rgba(55, 53, 47, 0.85) !important;
        }

    /* 8. 🌟 当前阅读进度的高亮指示器 */
    .vditor-outline ul li.vditor-outline__item--current > span {
        color: #2eaadc !important;
        font-weight: 600 !important;
        background-color: rgba(46, 170, 220, 0.06) !important;
        border-left: 3px solid #2eaadc !important;
        border-radius: 0 5px 5px 0 !important;
        padding-left: 5px !important;
    }
</style>
@code {
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ContentChanged { get; set; }

    // 🌟 接收当前笔记所在的文件夹路径（用于计算相对路径）
    [Parameter] public string CurrentFolder { get; set; } = string.Empty;

    private readonly string _editorId = "editor-" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<MarkdownEditor>? _dotNetHelper;
    private bool _isInitialized = false;
    private string _lastRenderedContent = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            _lastRenderedContent = Content;
            // 初始化 Vditor，并将 C# 引用传给 JS
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.initVditor", _editorId, Content, _dotNetHelper);
            _isInitialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // 当外部切换笔记时，更新编辑器内容
        if (_isInitialized && Content != _lastRenderedContent)
        {
            _lastRenderedContent = Content;
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.setVditorContent", _editorId, Content);
        }
    }

    // 供 JS 实时回传内容
    [JSInvokable]
    public async Task UpdateContent(string newContent)
    {
        if (Content != newContent)
        {
            Content = newContent;
            _lastRenderedContent = newContent;
            await ContentChanged.InvokeAsync(newContent);
        }
    }

    // 🌟 核心拦截器：供 JS 调用的图片保存接口
    [JSInvokable]
    public async Task<string> UploadImageAsync(string base64Data, string fileName)
    {
        var base64Span = base64Data.Contains(',') ? base64Data.Split(',')[1] : base64Data;
        var bytes = Convert.FromBase64String(base64Span);

        var ext = Path.GetExtension(fileName);
        if (string.IsNullOrEmpty(ext)) ext = ".png";

        var savedFileName = await NoteRepository.SaveAssetAsync(bytes, ext);

        // 🌟 降维打击：永远返回虚拟域名的绝对路径
        // 这样不仅能在 Vditor 中瞬间显示，而且再也不用算 ../../ 了！
        return $"https://mononotes.local/.assets/{savedFileName}";
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetHelper?.Dispose();
    }
}
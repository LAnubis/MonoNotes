@using Microsoft.JSInterop
@using System.IO
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@inject MonoNotes.Core.Interfaces.INoteRepository NoteRepository

<div id="@_editorId" class="vditor-container" style="height: 100%;"></div>

<style>
    /* 1. 恢复 Vditor 容器的原生定位，绝不能破坏其结构 */
    .vditor, .vditor-content {
        border: none !important;
        background: transparent !important;
    }

    /* 2. 🌟 核心防穿透：用 Padding 挤压工具栏和正文，让出右侧 260px 空间给我们的自定义双塔面板 */
    .vditor-toolbar {
        padding-right: 260px !important;
    }

    .vditor-ir, .vditor-wysiwyg {
        height: 100% !important;
        overflow-y: auto !important;
        padding-right: 260px !important;
    }
        /* 🌟 彻底消灭超链接！劫持 mark 标签，Blazor 绝对无法拦截！ */
        .vditor-ir mark {
            background-color: transparent !important; /* 去掉默认的黄色高亮背景 */
            color: #2eaadc !important; /* 字体变蓝 */
            text-decoration: underline wavy #2eaadc !important; /* 加上波浪线 */
            text-decoration-skip-ink: auto;
            /* 核心：保持普通的文本输入光标（像 | 一样），完全消除超链接的错觉 */
            cursor: text !important;
            font-weight: 500;
        }
</style>

@code {
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ContentChanged { get; set; }
    [Parameter] public string CurrentFolder { get; set; } = string.Empty;
    [Parameter] public IEnumerable<MonoNotes.Core.Models.NoteIndexItem> GlobalIndex { get; set; } = Array.Empty<MonoNotes.Core.Models.NoteIndexItem>();
    [Parameter] public EventCallback<string> OnInternalLinkClick { get; set; }
    [Parameter] public EventCallback OnOpenInsertModal { get; set; }
    private readonly string _editorId = "editor-" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<MarkdownEditor>? _dotNetHelper;
    private bool _isInitialized = false;
    private string _lastRenderedContent = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            _lastRenderedContent = Content;
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.initVditor", _editorId, Content, _dotNetHelper);
            _isInitialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isInitialized && Content != _lastRenderedContent)
        {
            _lastRenderedContent = Content;
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.setVditorContent", _editorId, Content);
        }
    }

    [JSInvokable]
    public async Task UpdateContent(string newContent)
    {
        if (Content != newContent)
        {
            Content = newContent;
            _lastRenderedContent = newContent;
            await ContentChanged.InvokeAsync(newContent);
        }
    }

    [JSInvokable]
    public async Task<string> UploadImageAsync(string base64Data, string fileName)
    {
        var base64Span = base64Data.Contains(',') ? base64Data.Split(',')[1] : base64Data;
        var bytes = Convert.FromBase64String(base64Span);
        var ext = Path.GetExtension(fileName);
        if (string.IsNullOrEmpty(ext)) ext = ".png";
        var savedFileName = await NoteRepository.SaveAssetAsync(bytes, ext);
        return $"{MonoNotes.Core.AppConstants.ImageBaseUrl}/Workspaces/{NoteRepository.CurrentWorkspace}/.assets/{savedFileName}";
    }


    [JSInvokable]
    public async Task TriggerInternalLink(string targetTitle)
    {
        if (OnInternalLinkClick.HasDelegate)
        {
            await OnInternalLinkClick.InvokeAsync(targetTitle);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetHelper?.Dispose();
    }

    // 🌟 新增：对外暴露的滚动跳转方法
    public async Task ScrollToHeadingAsync(string headingText)
    {
        if (_isInitialized)
        {
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.scrollToHeading", _editorId, headingText);
        }
    }

    [JSInvokable]
    public async Task TriggerInsertNoteModal()
    {
        Console.WriteLine("【后端 C#】TriggerInsertNoteModal 桥梁方法被触发！");
        if (OnOpenInsertModal.HasDelegate)
        {
            await OnOpenInsertModal.InvokeAsync();
        }
    }

    // 2. C# 拿到结果后呼叫 JS 把文字插进光标处
    public async Task InsertTextAsync(string text)
    {
        if (_isInitialized)
        {
            await JSRuntime.InvokeVoidAsync("MonoNotesEditor.insertTextAtCursor", _editorId, text);
        }
    }
}
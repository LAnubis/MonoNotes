@code {
    [Parameter]
    public string CurrentWorkId { get; set; } = string.Empty;

    // 内部定义的实体（实际开发中请移到 Core/Models 里）
    public class AnchorCard
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public string Title { get; set; } = string.Empty;
        public string Note { get; set; } = string.Empty;
        public string SourceChapter { get; set; } = string.Empty;
        public string Status { get; set; } = "planted"; // planted, pending, resolved, abandoned
        public string Confidence { get; set; } = "valid"; // valid, moved, uncertain
    }

    // 模拟伏笔数据
    private List<AnchorCard> Anchors = new()
    {
        new AnchorCard { Title = "黑色古朴戒指", Note = "里面藏着药老，关键时刻会苏醒吸收斗气", SourceChapter = "第1章 雨夜惊变", Status = "planted" },
        new AnchorCard { Title = "三年之约", Note = "云岚宗退婚，约定三年后上山挑战", SourceChapter = "第3章 远行", Status = "pending" },
        new AnchorCard { Title = "神秘的残破地图", Note = "指向净莲妖火，需要集齐四份", SourceChapter = "第12章 黑岩城", Status = "planted", Confidence = "uncertain" },
        new AnchorCard { Title = "后山的神秘山洞", Note = "原计划作为奇遇地点，后因节奏太拖沓作废", SourceChapter = "大纲设定", Status = "abandoned" },
        new AnchorCard { Title = "筑基灵液的药方", Note = "炼药师公会考核时用到了", SourceChapter = "第20章 震撼全场", Status = "resolved" }
    };

    // 辅助方法：按状态筛选卡片
    private IEnumerable<AnchorCard> GetCardsByStatus(string status) => Anchors.Where(a => a.Status == status);
}

<div class="board-container">
    <div class="board-header">
        <div class="header-left">
            <h2>💡 伏笔与暗线看板</h2>
            <span class="subtitle">拖拽卡片以更改状态，点击卡片反向定位正文</span>
        </div>
        <button class="primary-btn">➕ 手动添加伏笔</button>
    </div>

    <div class="kanban-track">

        <div class="kanban-column">
            <div class="column-header">
                <h3>🌱 已埋下 <span class="count">@GetCardsByStatus("planted").Count()</span></h3>
            </div>
            <div class="card-list">
                @foreach (var card in GetCardsByStatus("planted"))
                {
                    <div class="anchor-card border-blue">
                        <div class="card-title">@card.Title</div>
                        <div class="card-note">@card.Note</div>
                        <div class="card-footer">
                            <span class="source-tag">📍 @card.SourceChapter</span>
                            @if (card.Confidence == "uncertain")
                            {
                                <span class="warn-tag" title="正文被修改，定位可能偏移">⚠️ 定位偏移</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="kanban-column">
            <div class="column-header">
                <h3>⏳ 待回收 <span class="count">@GetCardsByStatus("pending").Count()</span></h3>
            </div>
            <div class="card-list">
                @foreach (var card in GetCardsByStatus("pending"))
                {
                    <div class="anchor-card border-orange">
                        <div class="card-title">@card.Title</div>
                        <div class="card-note">@card.Note</div>
                        <div class="card-footer">
                            <span class="source-tag">📍 @card.SourceChapter</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="kanban-column">
            <div class="column-header">
                <h3>✅ 已回收 <span class="count">@GetCardsByStatus("resolved").Count()</span></h3>
            </div>
            <div class="card-list">
                @foreach (var card in GetCardsByStatus("resolved"))
                {
                    <div class="anchor-card border-green">
                        <div class="card-title">@card.Title</div>
                        <div class="card-note" style="text-decoration: line-through; color:#aaa;">@card.Note</div>
                        <div class="card-footer">
                            <span class="source-tag">📍 @card.SourceChapter</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="kanban-column">
            <div class="column-header">
                <h3>🗑️ 已废弃 <span class="count">@GetCardsByStatus("abandoned").Count()</span></h3>
            </div>
            <div class="card-list">
                @foreach (var card in GetCardsByStatus("abandoned"))
                {
                    <div class="anchor-card border-gray">
                        <div class="card-title" style="color: #999;">@card.Title</div>
                        <div class="card-note">@card.Note</div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
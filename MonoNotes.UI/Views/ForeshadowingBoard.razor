@using MonoNotes.Core.Models
@using MonoNotes.Storage
@inject WriteSpaceRepository Repository

@code {
    [Parameter] public string CurrentWorkId { get; set; } = string.Empty;

    private List<ForeshadowItem> AllForeshadows = new();

    // 分为两组：待填坑 和 已回收
    private List<ForeshadowItem> OpenForeshadows => AllForeshadows.Where(f => !f.IsResolved).OrderByDescending(f => f.CreatedAt).ToList();
    private List<ForeshadowItem> ResolvedForeshadows => AllForeshadows.Where(f => f.IsResolved).OrderByDescending(f => f.ResolvedAt).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(CurrentWorkId))
        {
            AllForeshadows = await Repository.GetForeshadowsAsync(CurrentWorkId);
        }
    }

    // 🌟 一键填坑回收！
    private async Task ResolveForeshadow(ForeshadowItem item)
    {
        item.IsResolved = true;
        item.ResolvedAt = DateTime.Now;
        // 这里只是做一个概念记录，实际上如果未来引入了“在某章填坑”，可以将当前的 ChapterId 记录进来
        item.ResolvedInChapterName = "未知章节填坑";

        await Repository.SaveForeshadowsAsync(CurrentWorkId, AllForeshadows);
    }

    // 🌟 不想填了，直接删除
    private async Task DeleteForeshadow(ForeshadowItem item)
    {
        AllForeshadows.Remove(item);
        await Repository.SaveForeshadowsAsync(CurrentWorkId, AllForeshadows);
    }
}

<div class="board-container">
    <div class="board-header">
        <h2>💡 伏笔与填坑看板</h2>
        <p>所有挖过的坑都在这里追踪，保证小说逻辑严密，战力不崩塌。</p>
    </div>

    <div class="board-columns">

        <div class="column open-column">
            <div class="col-title">
                <span class="icon">🕳️</span> 挖坑中 / 待回收 <span class="badge">@OpenForeshadows.Count</span>
            </div>

            <div class="card-list hide-scrollbar">
                @if (!OpenForeshadows.Any())
                {
                    <div class="empty-col">太棒了，目前没有任何遗留的坑！</div>
                }
                @foreach (var item in OpenForeshadows)
                {
                    <div class="foreshadow-card open-card">
                        <div class="card-meta">
                            <span class="chapter-tag">挖坑于: @item.CreatedInChapterName</span>
                            <span class="time-tag">@item.CreatedAt.ToString("MM-dd")</span>
                        </div>
                        <div class="card-desc">@item.Description</div>
                        <div class="card-actions">
                            <button class="btn-danger" @onclick="() => DeleteForeshadow(item)">🗑️ 废弃此坑</button>
                            <button class="btn-resolve" @onclick="() => ResolveForeshadow(item)">✅ 标记为已填坑</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="column resolved-column">
            <div class="col-title">
                <span class="icon">✅</span> 已填坑 / 成功回收 <span class="badge badge-green">@ResolvedForeshadows.Count</span>
            </div>

            <div class="card-list hide-scrollbar">
                @if (!ResolvedForeshadows.Any())
                {
                    <div class="empty-col">还没填过任何坑... 读者要寄刀片啦！</div>
                }
                @foreach (var item in ResolvedForeshadows)
                {
                    <div class="foreshadow-card resolved-card">
                        <div class="card-meta">
                            <span class="chapter-tag" style="text-decoration: line-through; opacity: 0.6;">挖坑于: @item.CreatedInChapterName</span>
                            <span class="resolve-tag">✔️ 回收于: @item.ResolvedAt?.ToString("MM-dd")</span>
                        </div>
                        <div class="card-desc" style="color:#666;">@item.Description</div>
                        <div class="card-actions" style="justify-content: flex-end;">
                            <button class="btn-danger" style="opacity: 0.5;" @onclick="() => DeleteForeshadow(item)">彻底删除</button>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>


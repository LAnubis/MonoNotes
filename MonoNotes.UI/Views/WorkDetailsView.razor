@using MonoNotes.Core.Models
@using MonoNotes.Core.Utils
@using MonoNotes.Storage
@inject WriteSpaceRepository Repository

@code {
    [Parameter] public string CurrentWorkId { get; set; } = string.Empty;

    private WorkMeta? Meta;
    private string SaveStatus = "";

    protected override async Task OnParametersSetAsync()
    {
        var allWorks = await Repository.GetAllWorksAsync();
        Meta = allWorks.FirstOrDefault(w => w.Id == CurrentWorkId);
    }

    private async Task SaveDetails()
    {
        if (Meta != null)
        {
            SaveStatus = "正在保存...";

            // 🌟 核心修复：直接调用仓储层的保存方法，不再让 UI 碰文件路径
            await Repository.SaveWorkMetaAsync(Meta);

            SaveStatus = "✅ 已保存";

            // 2秒后清除提示
            await Task.Delay(2000);
            SaveStatus = "";
            StateHasChanged();
        }
    }
}

<div class="details-container">
    @if (Meta == null)
    {
        <div style="color: #999;">正在加载小说详情...</div>
    }
    else
    {
        <div class="details-header">
            <h2 style="margin: 0;">📖 小说档案管理</h2>
            <div style="display:flex; align-items:center; gap: 12px;">
                <span style="color: #4caf50; font-size: 13px;">@SaveStatus</span>
                <button class="save-btn" @onclick="SaveDetails">💾 保存修改</button>
            </div>
        </div>

        <div class="details-body">
            <div class="cover-panel">
                <div class="cover-image-box">
                    @if (string.IsNullOrEmpty(Meta.CoverUrl))
                    {
                        <div class="no-cover">
                            <span style="font-size: 32px;">📷</span><br>
                            <span>暂无封面</span>
                        </div>
                    }
                    else
                    {
                        <img src="@Meta.CoverUrl" alt="封面" style="width:100%; height:100%; object-fit:cover; border-radius:8px;" />
                    }
                </div>

                <div class="form-group">
                    <label>作品状态</label>
                    <select class="form-control" @bind="Meta.Status">
                        <option value="drafting">📝 构思草稿</option>
                        <option value="serializing">🟢 连载中</option>
                        <option value="finished">🔴 已完结</option>
                        <option value="paused">⏸️ 暂停更新</option>
                    </select>
                </div>
            </div>

            <div class="info-panel">
                <div class="form-group">
                    <label>作品名称</label>
                    <input type="text" class="form-control title-input" @bind="Meta.Title" />
                </div>

                <div class="form-group">
                    <label>标签 (用逗号分隔，如：科幻, 赛博朋克)</label>
                    <input type="text" class="form-control" @bind="Meta.Tags" placeholder="例如：穿越, 修仙, 爽文" />
                </div>

                <div class="form-group" style="flex: 1; display: flex; flex-direction: column;">
                    <label>内容简介 (大纲/卖点)</label>
                    <textarea class="form-control" style="flex:1; resize:none; line-height: 1.6;" @bind="Meta.Synopsis" placeholder="在这里写下你的核心创意与大纲..."></textarea>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .details-container {
        padding: 40px;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        background-color: #fcfcfc;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #eee;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .save-btn {
        background: #1976d2;
        color: #fff;
        border: none;
        padding: 8px 20px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
        transition: background 0.2s;
    }

        .save-btn:hover {
            background: #1565c0;
        }

    .details-body {
        display: flex;
        gap: 40px;
        flex: 1;
        min-height: 0;
        max-width: 1000px;
        margin: 0 auto;
        width: 100%;
    }

    .cover-panel {
        width: 240px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .info-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .cover-image-box {
        width: 100%;
        aspect-ratio: 3 / 4;
        background: #eee;
        border-radius: 8px;
        border: 1px dashed #ccc;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #999;
    }

    .no-cover {
        text-align: center;
        font-size: 13px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .form-group label {
            font-size: 13px;
            color: #666;
            font-weight: bold;
        }

    .form-control {
        border: 1px solid #ddd;
        padding: 10px 14px;
        border-radius: 6px;
        font-family: inherit;
        font-size: 14px;
        background: #fff;
        outline: none;
        transition: border 0.2s;
    }

        .form-control:focus {
            border-color: #1976d2;
            box-shadow: 0 0 0 2px rgba(25,118,210,0.1);
        }

    .title-input {
        font-size: 20px;
        font-weight: bold;
        color: #222;
    }
</style>
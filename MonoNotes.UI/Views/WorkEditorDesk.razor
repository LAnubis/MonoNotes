@using MonoNotes.Core.Models
@using MonoNotes.Storage
@using System.Text.RegularExpressions
@inject WriteSpaceRepository Repository
@inject IJSRuntime JS
@implements IDisposable

@code {
    [Parameter] public string CurrentWorkId { get; set; } = string.Empty;
    [Parameter] public string CurrentChapterId { get; set; } = string.Empty;
    private bool _shouldInitVditor = false;
    [Parameter] public EventCallback OnTitleChanged { get; set; }

    // 🌟 新增：用于通知父组件（工作台布局）切换当前章节
    [Parameter] public EventCallback<string> OnSwitchChapter { get; set; }

    private WorkIndex? IndexData;
    private Volume? ActiveVolume;
    private Chapter? ActiveChapter;

    private string ChapterPrefix { get; set; } = "";
    private string ChapterBody { get; set; } = "加载中...";

    private int _lastSavedWordCount = 0;
    private string Content { get; set; } = string.Empty;
    private string SaveStatus { get; set; } = "已同步";

    private bool ShowOutlinePanel { get; set; } = true;
    private int WordCount => string.IsNullOrWhiteSpace(Content) ? 0 : Content.Length;

    private CancellationTokenSource? _debounceCts;
    private DotNetObjectReference<WorkEditorDesk>? _objRef;

    // 声明抽屉组件的引用
    private QuickReferenceDrawer? _drawer;

    public class TocItem { public int Level { get; set; } public string Text { get; set; } = string.Empty; }
    private List<TocItem> DocumentToc { get; set; } = new();

    protected override void OnInitialized() { _objRef = DotNetObjectReference.Create(this); }
    private bool _isAddingForeshadow = false;
    private string _newForeshadowText = "";

    private List<ForeshadowItem> _currentChapterForeshadows = new();

    // 🌟 全局搜索控制
    private bool ShowSearchModal = false;

    private void OpenSearchModal() => ShowSearchModal = true;
    private void CloseSearchModal() => ShowSearchModal = false;

    // 🌟 接收搜索组件的跳转请求
    private async Task NavigateToChapter(string chapterId)
    {
        if (OnSwitchChapter.HasDelegate)
        {
            await OnSwitchChapter.InvokeAsync(chapterId);
        }
        CloseSearchModal();
    }

    // 每次打开弹窗，拉取当前章节已有的伏笔
    private async Task OpenForeshadowModal()
    {
        _newForeshadowText = "";
        _isAddingForeshadow = true;
        await LoadCurrentChapterForeshadows();
    }

    private void CloseForeshadowModal()
    {
        _isAddingForeshadow = false;
    }

    private async Task LoadCurrentChapterForeshadows()
    {
        if (string.IsNullOrEmpty(CurrentWorkId) || ActiveChapter == null) return;
        var allItems = await Repository.GetForeshadowsAsync(CurrentWorkId);
        // 只过滤出在本章挖的坑
        _currentChapterForeshadows = allItems
            .Where(f => f.CreatedInChapterId == ActiveChapter.Id)
            .OrderByDescending(f => f.CreatedAt)
            .ToList();
    }

    // 确认保存伏笔，并刷新列表
    private async Task SaveForeshadow()
    {
        if (string.IsNullOrWhiteSpace(_newForeshadowText) || ActiveChapter == null) return;

        var items = await Repository.GetForeshadowsAsync(CurrentWorkId);

        var newForeshadow = new ForeshadowItem
        {
            Description = _newForeshadowText.Trim(),
            CreatedInChapterId = ActiveChapter.Id,
            CreatedInChapterName = ChapterPrefix + ChapterBody
        };

        items.Add(newForeshadow);
        await Repository.SaveForeshadowsAsync(CurrentWorkId, items);

        _newForeshadowText = ""; // 清空输入框
        await LoadCurrentChapterForeshadows(); // 刷新上方列表

        SaveStatus = "💡 伏笔已记录";

        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            SaveStatus = "";
            await InvokeAsync(StateHasChanged);
        });
    }

    // 就在弹窗里直接删除写废的伏笔
    private async Task DeleteForeshadow(ForeshadowItem item)
    {
        var items = await Repository.GetForeshadowsAsync(CurrentWorkId);
        var target = items.FirstOrDefault(x => x.Id == item.Id);
        if (target != null)
        {
            items.Remove(target);
            await Repository.SaveForeshadowsAsync(CurrentWorkId, items);
            await LoadCurrentChapterForeshadows(); // 刷新列表
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(CurrentWorkId) || string.IsNullOrEmpty(CurrentChapterId))
        {
            ActiveChapter = null;
            ActiveVolume = null;
            return;
        }

        SaveStatus = "正在读取...";
        IndexData = await Repository.GetWorkIndexAsync(CurrentWorkId);
        if (IndexData != null)
        {
            ActiveVolume = IndexData.Volumes.FirstOrDefault(v => v.Chapters.Any(c => c.Id == CurrentChapterId));
            ActiveChapter = ActiveVolume?.Chapters.FirstOrDefault(c => c.Id == CurrentChapterId);
        }

        var fullTitle = ActiveChapter?.Title ?? "未命名章节";
        var match = Regex.Match(fullTitle, @"^(第\s*\d+\s*[卷章][：\s]*)(.*)$");
        if (match.Success) { ChapterPrefix = match.Groups[1].Value; ChapterBody = match.Groups[2].Value; }
        else { ChapterPrefix = ""; ChapterBody = fullTitle; }

        Content = await Repository.ReadChapterContentAsync(CurrentWorkId, CurrentChapterId);
        _lastSavedWordCount = Content.Length;
        GenerateToc();
        SaveStatus = "已同步";
        _shouldInitVditor = true;
    }

    private async Task LoadVditorAsync()
    {
        if (_objRef != null) { await JS.InvokeVoidAsync("writingVditor.init", "vditor-writing-area", Content, _objRef); }
    }

    [JSInvokable]
    public async Task OnVditorInput(string value)
    {
        Content = value;
        await TriggerAutoSave();
    }

    private async Task OnTitleInput(ChangeEventArgs e)
    {
        ChapterBody = e.Value?.ToString() ?? "";
        await TriggerAutoSave(true);
    }

    private async Task TriggerAutoSave(bool isTitleChange = false)
    {
        SaveStatus = "正在输入...";
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(1500, _debounceCts.Token);
            SaveStatus = "保存中...";
            int currentWords = Content.Length;
            int diff = currentWords - _lastSavedWordCount;
            if (diff > 0)
            {
                await Repository.AddDailyWordCountAsync(diff);
                _lastSavedWordCount = currentWords;
            }

            await Repository.SaveChapterContentAsync(CurrentWorkId, CurrentChapterId, Content);

            if (isTitleChange && IndexData != null && ActiveChapter != null)
            {
                ActiveChapter.Title = ChapterPrefix + ChapterBody;
                await Repository.SaveWorkIndexAsync(IndexData);
                if (OnTitleChanged.HasDelegate) { await OnTitleChanged.InvokeAsync(); }
            }

            GenerateToc();
            SaveStatus = $"已保存 {DateTime.Now:HH:mm:ss}";
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void GenerateToc()
    {
        DocumentToc.Clear();
        if (string.IsNullOrWhiteSpace(Content)) return;
        foreach (var line in Content.Split('\n'))
        {
            var match = Regex.Match(line, @"^(#{1,6})\s+(.*)");
            if (match.Success) DocumentToc.Add(new TocItem { Level = match.Groups[1].Value.Length, Text = match.Groups[2].Value.Trim() });
        }
    }

    private async Task ScrollToTargetHeading(string headingText)
    {
        await JS.InvokeVoidAsync("writingVditor.scrollToHeading", "vditor-writing-area", headingText);
    }

    // 打开抽屉
    private void OpenDrawer()
    {
        _drawer?.Open();
    }

    public void Dispose()
    {
        _objRef?.Dispose();
        _ = JS.InvokeVoidAsync("writingVditor.destroy", "vditor-writing-area");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldInitVditor && ActiveChapter != null)
        {
            _shouldInitVditor = false;
            await LoadVditorAsync();
        }
    }
}

<div class="editor-desk-container">
    @if (ActiveChapter == null || ActiveVolume == null)
    {
        <div class="empty-editor-state">
            <div class="empty-icon">✍️</div>
            <p>请在左侧目录树中，选择一个章节开始创作。</p>
        </div>
    }
    else
    {
        <div class="desk-topbar">
            <div class="breadcrumb">
                <span class="muted">正文编辑</span>
                <span class="separator">/</span>
                <span class="current">@(ChapterPrefix + ChapterBody)</span>
            </div>

            <div class="desk-tools">
                <span class="save-status"><span class="icon">☁️</span> @SaveStatus</span>
                <span class="word-count-badge">@WordCount 字</span>

                <button class="tool-btn search-btn" title="毫秒级全文检索" @onclick="OpenSearchModal" style="background:#e3f2fd; color:#1976d2; font-weight:bold;">
                    🔍 全文检索
                </button>

                <button class="tool-btn foreshadow-btn" title="快速挖个坑" @onclick="OpenForeshadowModal">💡 设为伏笔</button>

                <button class="tool-btn material-btn" title="速查设定与大纲" @onclick="OpenDrawer">📚 素材速查</button>

                <button class="tool-btn toggle-outline-btn @(ShowOutlinePanel ? "active" : "")" @onclick="() => ShowOutlinePanel = !ShowOutlinePanel">
                    @(ShowOutlinePanel ? "👉 收起导航" : "👈 展开导航")
                </button>
            </div>
        </div>

        <div class="editor-body-layout">
            <div class="editor-content-box">
                <div class="editor-main-area">
                    <div class="chapter-title-container">
                        @if (!string.IsNullOrEmpty(ChapterPrefix))
                        {
                            <span class="chapter-prefix">@ChapterPrefix</span>
                        }
                        <input type="text" class="chapter-title-input"
                               value="@ChapterBody"
                               @oninput="OnTitleInput"
                               placeholder="输入章节名称..." />
                    </div>
                    <div id="vditor-writing-area" class="chapter-content-textarea" style="background: transparent;"></div>
                </div>

                <div class="outline-sidebar hide-scrollbar @(ShowOutlinePanel ? "open" : "closed")">
                    <div class="sidebar-block toc-block">
                        <h4 class="block-header"><span class="ol-icon">📑</span> 正文导航</h4>
                        @if (!DocumentToc.Any())
                        {
                            <div class="toc-empty">暂无章节内标题<br>请在正文使用 # 输入标题</div>
                        }
                        else
                        {
                            <ul class="toc-list">
                                @foreach (var item in DocumentToc)
                                {
                                    var indent = (item.Level - 1) * 14;
                                    <li class="toc-item" style="padding-left: @(indent)px;"
                                        @onclick="() => ScrollToTargetHeading(item.Text)">
                                        <span class="toc-dot"></span> @item.Text
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (_isAddingForeshadow)
{
    <div class="foreshadow-overlay" @onclick="CloseForeshadowModal"></div>
    <div class="foreshadow-modal">
        <div class="fs-header">
            <div>
                <h3 class="fs-title">💡 本章伏笔管理</h3>
                <p class="fs-desc">【@(ChapterPrefix + ChapterBody)】</p>
            </div>
            <button class="fs-btn-close" @onclick="CloseForeshadowModal">✖</button>
        </div>

        @if (_currentChapterForeshadows.Any())
        {
            <div class="fs-list hide-scrollbar">
                <div class="fs-label">本章已埋下的坑：</div>
                @foreach (var item in _currentChapterForeshadows)
                {
                    <div class="fs-list-item">
                        <span class="fs-item-text">@item.Description</span>
                        <button class="fs-btn-delete" title="删除这个坑" @onclick="() => DeleteForeshadow(item)">删除</button>
                    </div>
                }
            </div>
        }

        <div class="fs-label" style="margin-top: @(_currentChapterForeshadows.Any() ? "16px" : "0");">埋个新坑：</div>
        <textarea class="fs-textarea" @bind="_newForeshadowText" placeholder="描述你埋下的悬念（例如：山洞里的神秘戒指其实是...）" autofocus></textarea>

        <div class="fs-actions">
            <button class="fs-btn-save" @onclick="SaveForeshadow">💾 记录伏笔</button>
        </div>
    </div>
}

<QuickReferenceDrawer @ref="_drawer"
                      CurrentWorkId="@CurrentWorkId"
                      CurrentVolumeId="@(ActiveVolume?.Id ?? "")"
                      CurrentChapterId="@(ActiveChapter?.Id ?? "")" />

@if (ShowSearchModal)
{
    <WorkSearchModal CurrentWorkId="@CurrentWorkId"
                     OnClose="CloseSearchModal"
                     OnNavigateToChapter="NavigateToChapter" />
}
    private async Task CreateOrOpenDailyNoteAsync()
    {
        string todayStr = DateTime.Now.ToString("yyyy-MM-dd");
        string dailyFolderName = "每日速记";

        var existingNote = IndexItems.FirstOrDefault(n => n.Title == todayStr && !n.IsDeleted);
        if (existingNote != null) { await SelectNote(existingNote.Id); }
        else
        {
            SelectedNote = new MonoNote { Id = Guid.NewGuid().ToString("N"), Title = todayStr, Content = $"# {todayStr}\n\n- [ ] ", UpdatedAt = DateTimeOffset.Now, Folder = dailyFolderName, Tags = new List<string>() };
            var idxItem = new NoteIndexItem { Id = SelectedNote.Id, Title = SelectedNote.Title, Folder = SelectedNote.Folder, UpdatedAt = SelectedNote.UpdatedAt };
            IndexItems.Insert(0, idxItem);
            IndexService.UpsertItem(idxItem);

            var rawFolders = await NoteRepository.GetAllFoldersAsync();
            if (!rawFolders.Any(f => f == dailyFolderName))
            {
                await NoteRepository.CreateFolderAsync("", dailyFolderName);
                BuildFolderTree(await NoteRepository.GetAllFoldersAsync());
            }
            SelectedNoteId = SelectedNote.Id;
            await NoteRepository.SaveNoteAsync(SelectedNote);
        }
    }


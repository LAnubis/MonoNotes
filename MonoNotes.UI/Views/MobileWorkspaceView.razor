        if (_actionNote != null)
        {
            _actionNote.IsDeleted = false;
            IndexService.UpsertItem(_actionNote);
            var allNotes = await NoteRepository.GetAllNotesAsync(); var realNote = allNotes.FirstOrDefault(n => n.Id == _actionNote.Id);
            if (realNote != null)
            {
                realNote.IsDeleted = false; await NoteRepository.SaveNoteAsync(realNote);
            }
        }
        _showNoteActionSheet = false;
    }

    private async Task HardDeleteActionNote()
    {
        if (_actionNote != null)
        {
            string remotePath = $"MonoNotes/{NoteRepository.CurrentWorkspace}/{_actionNote.Folder}/{_actionNote.Id}.md";
            await WebDavService.DeleteItemAsync(remotePath);
            await NoteRepository.DeleteNoteAsync(_actionNote.Id);
            IndexItems.Remove(_actionNote); IndexService.RemoveItem(_actionNote.Id);
        }
        _showNoteActionSheet = false;
    }

    private List<KeyValuePair<string, int>> GetTagFrequencies()
    {
        return IndexItems.Where(n => !n.IsDeleted && n.Tags != null).SelectMany(n => n.Tags!)
            .GroupBy(t => t).Select(g => new KeyValuePair<string, int>(g.Key, g.Count())).OrderByDescending(kv => kv.Value).ToList();
    }

    private void BuildFolderTree(List<string> rawPaths)
    {
        _folderTree.Clear();
        foreach (var path in rawPaths)
        {
            var parts = path.Split('/');
            var currentLevel = _folderTree; string currentFullPath = "";
            for (int i = 0; i < parts.Length; i++)
            {
                var part = parts[i];
                currentFullPath = string.IsNullOrEmpty(currentFullPath) ? part : $"{currentFullPath}/{part}";
                var existingNode = currentLevel.FirstOrDefault(n => n.FullPath == currentFullPath);
                if (existingNode == null)
                {
                    existingNode = new FolderTree.FolderNode { Name = part, FullPath = currentFullPath }; currentLevel.Add(existingNode);
                }
                currentLevel = existingNode.Children;
            }
        }
    }

    private List<string> ExtractOutgoingLinks(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return new List<string>();
        var links = new HashSet<string>(); var regex = new System.Text.RegularExpressions.Regex(@"《《(.*?)》》");
        foreach (System.Text.RegularExpressions.Match match in regex.Matches(content))
        {
            var title = match.Groups[1].Value.Trim();
            if (!string.IsNullOrEmpty(title)) links.Add(title);
        }
        return links.ToList();
    }

    private async Task ConfirmMoveNote()
    {

            IndexService.UpsertItem(targetNote);
            var allNotes = await NoteRepository.GetAllNotesAsync(); var realNote = allNotes.FirstOrDefault(n => n.Id == targetNote.Id);
            if (realNote != null)
            {
                realNote.Folder = _targetFolder; await NoteRepository.SaveNoteAsync(realNote);
            }
        }
        _showFolderSelector = false;
        _showEditorOptionsSheet = false; _showNoteActionSheet = false; _actionNote = null; _targetFolder = string.Empty; StateHasChanged();
    }

    private async Task TestAndSaveWebDavAsync()
    {
        _isTestingWebDav = true;
        _webDavTestStatus = "正在保存设置...";
        StateHasChanged();
        await Task.Delay(100);

        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            settings.WebDavUrl = _webDavUrl;
            settings.WebDavUsername = _webDavUser;
            settings.EnableWebDavSync = true;
            await SettingsService.SaveSettingsAsync(settings);

            if (!string.IsNullOrWhiteSpace(_webDavPass))
            {
                await SettingsService.SaveSecurePasswordAsync("MonoNotes_WebDav_Password", _webDavPass);
            }
            else
            {
                SettingsService.RemoveSecurePassword("MonoNotes_WebDav_Password");
            }

            _webDavTestStatus = "正在尝试连接并同步数据 (这可能需要几秒钟)..."; StateHasChanged(); await Task.Delay(100);
            // 1. 调用底层下载真实的 .md 文件
            await SyncService.SyncAsync();
            // 2. 🌟 核心修复：强制扫描磁盘里最新的所有笔记，重新构建索引！
            var allNotes = await NoteRepository.GetAllNotesAsync();
            IndexItems.Clear();
            foreach (var note in allNotes)
            {
                var idxItem = new NoteIndexItem
                {
                    Id = note.Id,
                    Title = note.Title,
                    Folder = note.Folder,
                    UpdatedAt = note.UpdatedAt,
                    Tags = note.Tags ?? new List<string>(),
                    IsPinned = note.IsPinned,
                    IsFavorite = note.IsFavorite,
                    IsDeleted = note.IsDeleted
                };
                IndexItems.Add(idxItem);
                IndexService.UpsertItem(idxItem); // 顺便把最新状态持久化到 index.json
            }

            _folderTree.Clear();
            BuildFolderTree(await NoteRepository.GetAllFoldersAsync());

            _webDavTestStatus = "✅ 连接成功！数据已同步。";
            await Task.Delay(1500); _showWebDavSheet = false; _webDavTestStatus = "";
        }
        catch (Exception ex)
        {
            _webDavTestStatus = $"❌ 连接失败: {ex.Message}";
        }
        finally
        {
            _isTestingWebDav = false; StateHasChanged();
        }
    }


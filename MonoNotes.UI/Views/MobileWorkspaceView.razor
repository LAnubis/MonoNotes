@code {
    // ==========================================
    // 💡 状态管理
    // ==========================================
    private List<NoteIndexItem> IndexItems = new();
    private List<FolderTree.FolderNode> _folderTree = new();

    private string _currentNavTab = "notes"; // "notes", "search", "settings"
    private string SelectedNoteId = string.Empty;
    private MonoNote? SelectedNote = null;

    // 过滤与分类状态
    private string _selectedFolderPath = "notes";
    private HashSet<string> _activeTags = new();
    private bool _isFavoriteFilterActive = false;
    private bool _isTrashFilterActive = false;

    // 底部面板开关 (Bottom Sheets)
    private bool _showFolderSheet = false;
    private bool _showNoteActionSheet = false;
    private bool _showEditorOptionsSheet = false;
    private bool _showTemplateSheet = false;

    // 临时操作对象
    private NoteIndexItem? _actionNote = null;
    private List<MonoNote> _availableTemplates = new();
    private string _saveStatus = "已保存";
    private Timer _autoSaveTimer = new Timer(1000) { AutoReset = false };
    private MarkdownEditor? _markdownEditor;
    private string _newTagInput = string.Empty;

    // 搜索与同步状态
    private string _superSearchQuery = string.Empty;
    private List<SearchResultItem> _searchResults = new();
    private bool _isSyncingUI = false;


    // --- 文件夹移动状态 ---
    private bool _showFolderSelector = false;
    private string _targetFolder = string.Empty;

    // ==========================================
    // 💡 生命周期与初始化
    // ==========================================
    protected override async Task OnInitializedAsync()
    {
        IndexItems = await IndexService.LoadIndexAsync();

        // 执行轻量级自愈（只补录索引，手机端不扫描全文）
        var rawFolders = await NoteRepository.GetAllFoldersAsync();
        BuildFolderTree(rawFolders);

        _autoSaveTimer.Elapsed += async (sender, e) => await PerformSaveAsync();

        // 获取模板预备
        _availableTemplates = await NoteRepository.GetAllTemplatesAsync();
    }

    public void Dispose()
    {
        _autoSaveTimer.Dispose();
    }

    // ==========================================
    // 💡 过滤与列表计算
    // ==========================================
    private IEnumerable<NoteIndexItem> FilteredNotes
    {
        get
        {
            IEnumerable<NoteIndexItem> result = IndexItems;
            if (_isTrashFilterActive) { result = result.Where(n => n.IsDeleted); }
            else
            {
                result = result.Where(n => !n.IsDeleted && !n.IsArchived);
                if (_activeTags != null && _activeTags.Any())
                {
                    result = result.Where(n => n.Tags != null && _activeTags.Any(t => n.Tags.Contains(t)));
                }
                else if (_isFavoriteFilterActive) { result = result.Where(n => n.IsFavorite); }
                else if (!string.IsNullOrEmpty(_selectedFolderPath)) { result = result.Where(n => n.Folder == _selectedFolderPath); }
            }
            return result.OrderByDescending(n => n.IsPinned).ThenByDescending(n => n.UpdatedAt);
        }
    }

    // ==========================================
    // 💡 导航与视图切换
    // ==========================================
    private void ResetFilters()
    {
        _isFavoriteFilterActive = false;
        _isTrashFilterActive = false;
        _selectedFolderPath = string.Empty;
        _activeTags.Clear();
    }

    private void ShowFavorites()
    {
        ResetFilters();
        _isFavoriteFilterActive = true;
    }

    private void ShowTrash()
    {
        ResetFilters();
        _isTrashFilterActive = true;
    }

    private void OnFolderSelectedHandler(string path)
    {
        ResetFilters();
        _selectedFolderPath = path;
    }

    private void SelectTag(string tag)
    {
        ResetFilters();
        _activeTags.Add(tag);
    }

    // ==========================================
    // 💡 笔记操作 (列表页)
    // ==========================================
    private async Task SelectNote(string id)
    {
        // 手机端：点击加载单篇笔记并全屏显示
        var allNotes = await NoteRepository.GetAllNotesAsync();
        SelectedNote = allNotes.FirstOrDefault(n => n.Id == id);
        if (SelectedNote != null)
        {
            SelectedNoteId = id;
            _saveStatus = "已保存";
        }
    }

    private void OpenNoteActionSheet(NoteIndexItem note)
    {
        _actionNote = note;
        _showNoteActionSheet = true;
    }

    // 🌟 新建笔记 (入口点)
    private async Task CreateNewNote()
    {
        var targetFolder = string.IsNullOrWhiteSpace(_selectedFolderPath) ? "notes" : _selectedFolderPath;
        SelectedNote = new MonoNote
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = "",
            Content = "",
            UpdatedAt = DateTimeOffset.Now,
            Folder = targetFolder,
            Tags = new List<string>()
        };

        var idxItem = new NoteIndexItem { Id = SelectedNote.Id, Title = "", Folder = SelectedNote.Folder, UpdatedAt = SelectedNote.UpdatedAt, CreatedAt = SelectedNote.UpdatedAt };
        IndexItems.Insert(0, idxItem);
        IndexService.UpsertItem(idxItem);

        SelectedNoteId = SelectedNote.Id;
        await NoteRepository.SaveNoteAsync(SelectedNote);
    }

    private async Task ConfirmCreateNoteFromTemplate(MonoNote? template)
    {
        _showTemplateSheet = false;
        SelectedNote = new MonoNote
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = template == null ? "无标题笔记" : template.Title.Replace(" 模板", ""),
            Content = template?.Content ?? "",
            Folder = "notes",
            UpdatedAt = DateTimeOffset.Now
        };

        var indexItem = new NoteIndexItem { Id = SelectedNote.Id, Title = SelectedNote.Title, Folder = SelectedNote.Folder, UpdatedAt = SelectedNote.UpdatedAt };
        IndexItems.Insert(0, indexItem);
        IndexService.UpsertItem(indexItem);

        SelectedNoteId = SelectedNote.Id;
        await NoteRepository.SaveNoteAsync(SelectedNote);
    }

    private async Task CreateOrOpenDailyNoteAsync()
    {
        string todayStr = DateTime.Now.ToString("yyyy-MM-dd");
        string dailyFolderName = "每日速记";

        var existingNote = IndexItems.FirstOrDefault(n => n.Title == todayStr && !n.IsDeleted);
        if (existingNote != null)
        {
            await SelectNote(existingNote.Id);
        }
        else
        {
            SelectedNote = new MonoNote
            {
                Id = Guid.NewGuid().ToString("N"),
                Title = todayStr,
                Content = $"# {todayStr}\n\n- [ ] ",
                UpdatedAt = DateTimeOffset.Now,
                Folder = dailyFolderName,
                Tags = new List<string>()
            };

            var idxItem = new NoteIndexItem { Id = SelectedNote.Id, Title = SelectedNote.Title, Folder = SelectedNote.Folder, UpdatedAt = SelectedNote.UpdatedAt };
            IndexItems.Insert(0, idxItem);
            IndexService.UpsertItem(idxItem);

            // 确保文件夹存在
            var rawFolders = await NoteRepository.GetAllFoldersAsync();
            if (!rawFolders.Any(f => f == dailyFolderName))
            {
                await NoteRepository.CreateFolderAsync("", dailyFolderName);
                BuildFolderTree(await NoteRepository.GetAllFoldersAsync());
            }

            SelectedNoteId = SelectedNote.Id;
            await NoteRepository.SaveNoteAsync(SelectedNote);
        }
    }

    // ==========================================
    // 💡 编辑器内部逻辑
    // ==========================================
    private async Task CloseEditor()
    {
        if (SelectedNote != null)
        {
            await PerformSaveAsync();
        }
        SelectedNoteId = string.Empty;
        SelectedNote = null;
    }

    private void OnNoteChanged()
    {
        _saveStatus = "正在保存...";
        if (SelectedNote != null)
        {
            var idx = IndexItems.FirstOrDefault(i => i.Id == SelectedNote.Id);
            if (idx != null && idx.Title != SelectedNote.Title) idx.Title = SelectedNote.Title;
        }
        _autoSaveTimer.Stop(); _autoSaveTimer.Start();
    }

    private async Task PerformSaveAsync()
    {
        if (SelectedNote != null)
        {
            SelectedNote.OutgoingLinks = ExtractOutgoingLinks(SelectedNote.Content);
            await NoteRepository.SaveNoteAsync(SelectedNote);

            var indexItem = IndexItems.FirstOrDefault(i => i.Id == SelectedNote.Id);
            if (indexItem != null)
            {
                indexItem.Title = SelectedNote.Title;
                indexItem.Folder = SelectedNote.Folder;
                indexItem.UpdatedAt = SelectedNote.UpdatedAt;
                indexItem.Tags = SelectedNote.Tags ?? new List<string>();
                indexItem.IsPinned = SelectedNote.IsPinned;
                indexItem.OutgoingLinks = SelectedNote.OutgoingLinks;
                IndexService.UpsertItem(indexItem);
            }
            _saveStatus = "已保存";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleTagInputKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newTagInput) && SelectedNote != null)
        {
            var tag = _newTagInput.Trim().TrimStart('#');
            SelectedNote.Tags ??= new List<string>();
            if (!SelectedNote.Tags.Contains(tag))
            {
                SelectedNote.Tags.Add(tag);
                await PerformSaveAsync();
            }
            _newTagInput = string.Empty;
        }
    }

    private async Task RemoveTag(string tag)
    {
        if (SelectedNote != null && SelectedNote.Tags != null)
        {
            SelectedNote.Tags.Remove(tag);
            await PerformSaveAsync();
        }
    }

    private async Task HandleInternalLinkClick(string targetTitle)
    {
        var targetNote = IndexItems.FirstOrDefault(n => n.Title == targetTitle && !n.IsDeleted);
        if (targetNote != null) await SelectNote(targetNote.Id);
    }

    // ==========================================
    // 💡 笔记数据操作 (Action Sheets)
    // ==========================================
    private async Task TogglePin()
    {
        if (SelectedNote != null) { SelectedNote.IsPinned = !SelectedNote.IsPinned; await PerformSaveAsync(); }
        _showEditorOptionsSheet = false;
    }

    private async Task DeleteCurrentNote()
    {
        if (SelectedNote != null)
        {
            SelectedNote.IsDeleted = true;
            await PerformSaveAsync();
            await CloseEditor();
        }
        _showEditorOptionsSheet = false;
    }

    private async Task ToggleActionNoteFavorite()
    {
        if (_actionNote != null)
        {
            _actionNote.IsFavorite = !_actionNote.IsFavorite;
            IndexService.UpsertItem(_actionNote);
            var allNotes = await NoteRepository.GetAllNotesAsync();
            var realNote = allNotes.FirstOrDefault(n => n.Id == _actionNote.Id);
            if (realNote != null) { realNote.IsFavorite = _actionNote.IsFavorite; await NoteRepository.SaveNoteAsync(realNote); }
        }
        _showNoteActionSheet = false;
    }

    private async Task ToggleActionNotePin()
    {
        if (_actionNote != null)
        {
            _actionNote.IsPinned = !_actionNote.IsPinned;
            IndexService.UpsertItem(_actionNote);
            var allNotes = await NoteRepository.GetAllNotesAsync();
            var realNote = allNotes.FirstOrDefault(n => n.Id == _actionNote.Id);
            if (realNote != null) { realNote.IsPinned = _actionNote.IsPinned; await NoteRepository.SaveNoteAsync(realNote); }
        }
        _showNoteActionSheet = false;
    }

    private async Task SoftDeleteActionNote()
    {
        if (_actionNote != null)
        {
            _actionNote.IsDeleted = true;
            IndexService.UpsertItem(_actionNote);
            var allNotes = await NoteRepository.GetAllNotesAsync();
            var realNote = allNotes.FirstOrDefault(n => n.Id == _actionNote.Id);
            if (realNote != null) { realNote.IsDeleted = true; await NoteRepository.SaveNoteAsync(realNote); }
        }
        _showNoteActionSheet = false;
    }

    private async Task RestoreActionNote()
    {
        if (_actionNote != null)
        {
            _actionNote.IsDeleted = false;
            IndexService.UpsertItem(_actionNote);
            var allNotes = await NoteRepository.GetAllNotesAsync();
            var realNote = allNotes.FirstOrDefault(n => n.Id == _actionNote.Id);
            if (realNote != null) { realNote.IsDeleted = false; await NoteRepository.SaveNoteAsync(realNote); }
        }
        _showNoteActionSheet = false;
    }

    private async Task HardDeleteActionNote()
    {
        if (_actionNote != null)
        {
            string remotePath = $"MonoNotes/{NoteRepository.CurrentWorkspace}/{_actionNote.Folder}/{_actionNote.Id}.md";
            await WebDavService.DeleteItemAsync(remotePath); // 尝试云端删除
            await NoteRepository.DeleteNoteAsync(_actionNote.Id);
            IndexItems.Remove(_actionNote);
            IndexService.RemoveItem(_actionNote.Id);
        }
        _showNoteActionSheet = false;
    }

    // ==========================================
    // 💡 辅助工具方法
    // ==========================================
    private List<KeyValuePair<string, int>> GetTagFrequencies()
    {
        return IndexItems.Where(n => !n.IsDeleted && n.Tags != null).SelectMany(n => n.Tags!)
            .GroupBy(t => t).Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(kv => kv.Value).ToList();
    }

    private void BuildFolderTree(List<string> rawPaths)
    {
        _folderTree.Clear();
        foreach (var path in rawPaths)
        {
            var parts = path.Split('/');
            var currentLevel = _folderTree;
            string currentFullPath = "";
            for (int i = 0; i < parts.Length; i++)
            {
                var part = parts[i];
                currentFullPath = string.IsNullOrEmpty(currentFullPath) ? part : $"{currentFullPath}/{part}";
                var existingNode = currentLevel.FirstOrDefault(n => n.FullPath == currentFullPath);
                if (existingNode == null)
                {
                    existingNode = new FolderTree.FolderNode { Name = part, FullPath = currentFullPath };
                    currentLevel.Add(existingNode);
                }
                currentLevel = existingNode.Children;
            }
        }
    }

    private List<string> ExtractOutgoingLinks(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return new List<string>();
        var links = new HashSet<string>();
        var regex = new System.Text.RegularExpressions.Regex(@"《《(.*?)》》");
        foreach (System.Text.RegularExpressions.Match match in regex.Matches(content))
        {
            var title = match.Groups[1].Value.Trim();
            if (!string.IsNullOrEmpty(title)) links.Add(title);
        }
        return links.ToList();
    }

    private async Task ExecuteSuperSearch(KeyboardEventArgs e)
    {
        var allNotes = await NoteRepository.GetAllNotesAsync();
        _searchResults = await SearchService.SearchAsync(_superSearchQuery, allNotes);
    }

    private void JumpToSearchResult(string noteId)
    {
        _currentNavTab = "notes";
        SelectNote(noteId);
    }

    private async Task TriggerBackgroundSync()
    {
        if (_isSyncingUI) return;
        _isSyncingUI = true;
        await SyncService.SyncAsync();
        IndexItems = await IndexService.LoadIndexAsync();
        _isSyncingUI = false;
    }

    private async Task OpenWorkspaceManager() { /* 待接驳通用弹窗或直接切换 */ }
    private async Task SaveAsTemplateAsync(MonoNote note) { /* 另存为模板逻辑复用 */ }

    private async Task ConfirmMoveNote()
    {
        if (string.IsNullOrEmpty(_targetFolder)) return;

        // 判断是移动打开的单篇笔记，还是列表里右键选中的笔记
        var targetNote = _actionNote != null ? IndexItems.FirstOrDefault(n => n.Id == _actionNote.Id) : IndexItems.FirstOrDefault(n => n.Id == SelectedNoteId);

        if (targetNote != null)
        {
            targetNote.Folder = _targetFolder;
            IndexService.UpsertItem(targetNote);

            var allNotes = await NoteRepository.GetAllNotesAsync();
            var realNote = allNotes.FirstOrDefault(n => n.Id == targetNote.Id);
            if (realNote != null)
            {
                realNote.Folder = _targetFolder;
                await NoteRepository.SaveNoteAsync(realNote);
            }
        }

        _showFolderSelector = false;
        _showEditorOptionsSheet = false;
        _showNoteActionSheet = false;
        _actionNote = null;
        _targetFolder = string.Empty;
        StateHasChanged();
    }
}
    private async Task TriggerBackgroundSync()
    {
        if (_isSyncingUI) return;
        _isSyncingUI = true; _syncResultMessage = ""; StateHasChanged(); await Task.Delay(50);

        try
        {
            IndexItems.Clear();
            // 1. 同步底层文件
            await SyncService.SyncAsync();
            // 2. 🌟 核心修复：强制扫描磁盘更新索引
            var allNotes = await NoteRepository.GetAllNotesAsync();
            IndexItems.Clear();
            foreach (var note in allNotes)
            {
                var idxItem = new NoteIndexItem
                {
                    Id = note.Id,
                    Title = note.Title,
                    Folder = note.Folder,
                    UpdatedAt = note.UpdatedAt,
                    Tags = note.Tags ?? new List<string>(),
                    IsPinned = note.IsPinned,
                    IsFavorite = note.IsFavorite,
                    IsDeleted = note.IsDeleted
                };
                IndexItems.Add(idxItem);
                IndexService.UpsertItem(idxItem);
            }

            _folderTree.Clear();
            BuildFolderTree(await NoteRepository.GetAllFoldersAsync());
            _syncResultMessage = "✅ 同步成功！";
        }
        catch (Exception ex)
        {
            _syncResultMessage = $"❌ 同步失败: {ex.Message}";
        }
        finally
        {
            _isSyncingUI = false;
            StateHasChanged();
            if (!string.IsNullOrEmpty(_syncResultMessage))
            {
                await Task.Delay(3000); _syncResultMessage = ""; StateHasChanged();
            }
        }
    }

    private void CheckLocalFiles()
    {
        try
        {
            // 🌟 使用我们之前统一的 PathHelper.GetWorkspacesDirectory()
            string workDir = PathHelper.GetWorkspacesDirectory();
            if (!Directory.Exists(workDir))
            {
                _syncResultMessage = $"❌ 诊断失败：工作目录不存在!\n{workDir}";
            }
            else
            {
                // 搜索所有 md 文件
                var files = Directory.GetFiles(workDir, "*.md", SearchOption.AllDirectories);
                _syncResultMessage = $"✅ 物理路径: {workDir}\n发现笔记数: {files.Length}";

                // 打印到输出窗口，方便你在调试时对比
                System.Diagnostics.Debug.WriteLine($"🔍 [诊断] 扫描路径: {workDir}");
                foreach (var file in files)
                {
                    System.Diagnostics.Debug.WriteLine($"文件: {file}");
                }
            }
        }
        catch (Exception ex)
        {
            _syncResultMessage = $"❌ 诊断报错: {ex.Message}";
        }

        StateHasChanged();
    }


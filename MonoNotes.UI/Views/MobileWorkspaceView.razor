        };
        var indexItem = new NoteIndexItem { Id = SelectedNote.Id, Title = SelectedNote.Title, Folder = SelectedNote.Folder, UpdatedAt = SelectedNote.UpdatedAt };
        IndexItems.Insert(0, indexItem);

    {
        var targetFolder = string.IsNullOrWhiteSpace(_selectedFolderPath) ?
            "notes" : _selectedFolderPath;
        SelectedNote = new MonoNote
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = "",
            Content = "",
            UpdatedAt = DateTimeOffset.Now,
            Folder = targetFolder,
            Tags = new List<string>()
        };

        var idxItem = new NoteIndexItem { Id = SelectedNote.Id, Title = "", Folder = SelectedNote.Folder, UpdatedAt = SelectedNote.UpdatedAt, CreatedAt = SelectedNote.UpdatedAt };
        IndexItems.Insert(0, idxItem);
        IndexService.UpsertItem(idxItem);

        SelectedNoteId = SelectedNote.Id;
        await NoteRepository.SaveNoteAsync(SelectedNote);

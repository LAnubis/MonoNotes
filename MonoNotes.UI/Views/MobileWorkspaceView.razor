    private async Task SwitchWorkspace(string name)
    {
        if (name == NoteRepository.CurrentWorkspace) return;
        // 1. 切换底层物理路径
        await NoteRepository.SwitchWorkspaceAsync(name);
        _showWorkspaceSheet = false;
        // 2. 🌟 执行强力刷新与对齐
        await RefreshWorkspaceDataAsync();

        StateHasChanged();
    }

    private async Task CreateWorkspace()
    {
        if (string.IsNullOrWhiteSpace(_newWorkspaceName)) return;
        // 1. 创建并切换底层物理路径
        await NoteRepository.CreateWorkspaceAsync(_newWorkspaceName.Trim());
        _newWorkspaceName = string.Empty;
        _showWorkspaceSheet = false;
        // 2. 🌟 执行强力刷新与对齐
        await RefreshWorkspaceDataAsync();

        StateHasChanged();
    }

    // 🌟 核心安检站：强制对齐内存索引与当前库的物理文件
    private async Task RefreshWorkspaceDataAsync()
    {
        // 1. 加载全局的 JSON 索引 (这里面可能混杂了其他库的数据)
        var rawIndex = await IndexService.LoadIndexAsync();
        // 2. 获取当前选中的知识库里的所有【真实的物理文件】
        var allNotes = await NoteRepository.GetAllNotesAsync();
        var validIds = allNotes.Select(n => n.Id).ToHashSet();

        // 3. 🌟 核心过滤：只保留真正属于当前库的笔记，剔除其他库的幽灵笔记！
        IndexItems = rawIndex.Where(idx => validIds.Contains(idx.Id)).ToList();
        // 4. 自愈机制：如果有物理文件没在索引里，立刻补上它
        foreach (var note in allNotes)
        {
            if (!IndexItems.Any(idx => idx.Id == note.Id))
            {
                var newIdx = new NoteIndexItem
                {
                    Id = note.Id,
                    Title = string.IsNullOrWhiteSpace(note.Title) ? "无标题" : note.Title,
                    Folder = string.IsNullOrWhiteSpace(note.Folder) ? "notes" : note.Folder,
                    UpdatedAt = note.UpdatedAt,
                    CreatedAt = note.UpdatedAt,
                    IsPinned = note.IsPinned,
                    IsFavorite = note.IsFavorite,
                    IsDeleted = note.IsDeleted,
                    IsArchived = note.IsArchived,
                    Tags = note.Tags ?? new List<string>()
                };
                IndexItems.Add(newIdx);
                IndexService.UpsertItem(newIdx);
            }
        }

        // 5. 重建当前库的左侧文件夹树
        var rawFolders = await NoteRepository.GetAllFoldersAsync();
        BuildFolderTree(rawFolders);

        // 6. 重置一切 UI 选择状态
        SelectedNoteId = string.Empty;
        SelectedNote = null;
        _selectedFolderPath = "notes";
        _activeTags.Clear();
    }


@using System.IO
@using System.Timers
@using Markdig
@using MonoNotes.Core
@using MonoNotes.Core.Interfaces
@using MonoNotes.Core.Models
@inject MonoNotes.Core.Interfaces.INativeDialogService NativeDialog
@inject INoteRepository NoteRepository
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject ISettingsService SettingsService
@inject IWebDavService WebDavService
@inject MonoNotes.Core.Interfaces.IWebDavSyncService SyncService
@inject MonoNotes.Core.Interfaces.ISearchService SearchService
@inject MonoNotes.Storage.JsonIndexService IndexService

<div class="mobile-workspace">
    @if (!string.IsNullOrEmpty(SelectedNoteId) && SelectedNote != null)
    {
        <div class="mobile-editor-view">
            <div class="mobile-nav-bar">
                <button class="icon-btn back-btn" @onclick="CloseEditor">
                    <span style="font-size: 18px; margin-right: 4px;">‹</span> 返回
                </button>
                <div class="status-indicator">@_saveStatus</div>
                <button class="icon-btn" @onclick="() => _showEditorOptionsSheet = true">
                    <span style="font-size: 20px;">⋯</span>
                </button>
            </div>

            <div class="mobile-editor-body">
                <input class="mobile-title-input" placeholder="无标题笔记"
                       @bind="SelectedNote.Title" @bind:event="oninput" @onkeyup="OnNoteChanged" />

                <div class="mobile-tags-row">
                    @if (SelectedNote.Tags != null)
                    {
                        @foreach (var tag in SelectedNote.Tags)
                        {
                            <span class="tag-pill">#@tag <span class="remove" @onclick="() => RemoveTag(tag)">×</span></span>
                        }
                    }
                    <input type="text" class="tag-input" placeholder="+ 添加标签" @bind="_newTagInput" @bind:event="oninput" @onkeyup="HandleTagInputKey" />
                </div>

                <div class="mobile-markdown-container">
                    <MobileMarkdownEditor @ref="_markdownEditor"
                                          Content="@SelectedNote.Content"
                                          ContentChanged="@((newContent) => { SelectedNote.Content = newContent; OnNoteChanged(); })"
                                          CurrentFolder="@SelectedNote.Folder"
                                          GlobalIndex="IndexItems"
                                          OnInternalLinkClick="HandleInternalLinkClick" />
                </div>

            </div>
        </div>
    }
    else
    {
        <div class="mobile-main-view">
            <div class="mobile-content-area">
                @if (_currentNavTab == "notes")
                {

                    <div class="mobile-list-header" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; padding-top: max(45px, env(safe-area-inset-top)); border-bottom: 1px solid rgba(0,0,0,0.05);">
                        <div @onclick="OpenFolderSheet" style="font-weight: 600; font-size: 16px; cursor:pointer; display: flex; align-items: center; pointer-events: auto !important;">
                            <span class="title" style="display: flex; align-items: center;">
                                @if (_isFavoriteFilterActive)
                                {
                                    <span>⭐ 收藏夹</span>
                                }
                                else if (_isTrashFilterActive)
                                {
                                    <span>🗑️ 回收站</span>
                                }
                                else if (_activeTags.Any())
                                {
                                    <span>🏷️ #@_activeTags.First()</span>
                                }
                                else if (!string.IsNullOrEmpty(_selectedFolderPath))
                                {
                                    <span>📁 @(_selectedFolderPath == "notes" ? "未分类" : Path.GetFileName(_selectedFolderPath))</span>
                                }
                                else
                                {
                                    <span>📝 全部笔记</span>
                                }
                            </span>
                            <span class="icon" style="margin-left: 4px; opacity: 0.5; font-size: 12px;">▾</span>
                        </div>

                        <div style="display: flex; gap: 12px; align-items: center;">
                            <button class="icon-btn" @onclick="OpenSuperSearch" style="font-size: 18px; opacity: 0.8; padding: 4px; background: transparent; border: none; cursor: pointer;">
                                🔍
                            </button>
                        </div>
                    </div>

                    <div class="mobile-note-list">
                        @foreach (var note in FilteredNotes)
                        {
                            <div class="mobile-note-card">
                                <div class="card-content" @onclick="() => SelectNote(note.Id)">
                                    <div class="card-title">@(string.IsNullOrWhiteSpace(note.Title) ? "无标题" : note.Title)</div>
                                    <div class="card-meta">
                                        @note.UpdatedAt.ToString("MM-dd HH:mm")
                                        @if (note.IsPinned)
                                        {
                                            <span class="meta-icon">📌</span>
                                        }
                                        @if (note.IsFavorite)
                                        {
                                            <span class="meta-icon">⭐</span>
                                        }
                                        @if (note.Tags != null && note.Tags.Any())
                                        {
                                            <span class="meta-tag">#@note.Tags.First()</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-actions" @onclick="() => OpenNoteActionSheet(note)">
                                    <span>⋯</span>
                                </div>
                            </div>
                        }

                        @if (!FilteredNotes.Any())
                        {
                            <div class="empty-state">
                                <span>🪹</span>
                                <p>这里空空如也</p>
                            </div>
                        }
                    </div>

                    <div class="fab-container">
                        <button class="fab-main" @onclick="CreateNewNote">➕</button>
                        <div class="fab-secondary" @onclick="CreateOrOpenDailyNoteAsync">📅</div>
                        <div class="fab-secondary" @onclick="() => _showTemplateSheet = true">🗂️</div>
                    </div>
                }

                else if (_currentNavTab == "settings")
                {
                    <div class="mobile-settings-view">
                        <div class="settings-header">
                            <h2>我的</h2>
                            <p>@NoteRepository.CurrentWorkspace</p>
                        </div>

                        <div class="settings-group">
                            <div class="settings-item" @onclick="OpenWorkspaceManager">
                                <span>📚 切换知识库</span>
                                <span class="arrow">›</span>
                            </div>
                        </div>

                        <div class="settings-group">
                            <div class="settings-item" @onclick="TriggerBackgroundSync">
                                <span>☁️ 立即同步</span>
                                @if (_isSyncingUI)
                                {
                                    <span class="syncing-text">同步中...</span>
                                }
                                else
                                {
                                    <span class="arrow">›</span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(_syncResultMessage))
                            {
                                <div style="padding: 10px 16px; font-size: 13px; text-align: center; color: @(_syncResultMessage.Contains("❌") ? "#ff4d4f" : "#52c41a"); border-bottom: 1px solid rgba(0,0,0,0.03); background: rgba(0,0,0,0.01);">
                                    @_syncResultMessage
                                </div>
                            }

                            <div class="settings-item" @onclick="() => _showWebDavSheet = true">
                                <span>⚙️ WebDAV 设置</span>
                                <span class="arrow">›</span>
                            </div>
                            <div class="settings-item" @onclick="CheckLocalFiles">
                                <span>🛠️ 诊断：查看本地物理文件</span>
                                <span class="arrow">›</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mobile-bottom-nav">
                <div class="nav-tab @(_currentNavTab == "notes" ? "active" : "")" @onclick='() => _currentNavTab = "notes"'>
                    <div class="nav-icon">📝</div>
                    <span>笔记</span>
                </div>
                <div class="nav-tab @(_currentNavTab == "settings" ? "active" : "")" @onclick='() => _currentNavTab = "settings"'>
                    <div class="nav-icon">⚙️</div>
                    <span>我</span>
                </div>
            </div>
        </div>
    }
</div>

@if (_showFolderSheet)
{
    <div class="bottom-sheet-overlay" @onclick="() => _showFolderSheet = false">
        <div class="bottom-sheet-content" style="max-height: 80vh;" @onclick:stopPropagation="true">
            <div class="sheet-header">
                <div class="sheet-drag-handle"></div>
                <span>视图与文件夹</span>
            </div>
            <div class="sheet-body" style="overflow-y: auto;">
                <div class="sheet-section-title">快捷视图</div>
                <div class="sheet-nav-item @(!_isFavoriteFilterActive && !_isTrashFilterActive && string.IsNullOrEmpty(_selectedFolderPath) && !_activeTags.Any() ? "active" : "")" @onclick='() => { ResetFilters(); _showFolderSheet = false; }'>📝 全部笔记</div>
                <div class="sheet-nav-item @(_isFavoriteFilterActive ? "active" : "")" @onclick='() => { ShowFavorites(); _showFolderSheet = false; }'>⭐ 收藏夹</div>
                <div class="sheet-nav-item @(_isTrashFilterActive ? "active" : "")" @onclick='() => { ShowTrash(); _showFolderSheet = false; }'>🗑️ 回收站</div>

                <div class="sheet-section-title">文件夹</div>
                @foreach (var folder in _folderTree)
                {
                    <div class="sheet-nav-item @(_selectedFolderPath == folder.FullPath ? "active" : "")" @onclick='() => { OnFolderSelectedHandler(folder.FullPath); _showFolderSheet = false; }'>
                        📁 @(folder.Name == "notes" ? "未分类" : folder.Name)
                    </div>
                }

                <div class="sheet-section-title">热门标签</div>
                <div class="sheet-tags-wrap">
                    @foreach (var tagKvp in GetTagFrequencies().Take(10))
                    {
                        <span class="sheet-tag-pill @(_activeTags.Contains(tagKvp.Key) ? "active" : "")" @onclick='() => { SelectTag(tagKvp.Key); _showFolderSheet = false; }'>#@tagKvp.Key</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_showNoteActionSheet && _actionNote != null)
{
    <div class="bottom-sheet-overlay" @onclick="() => _showNoteActionSheet = false">
        <div class="bottom-sheet-content" @onclick:stopPropagation="true">
            <div class="sheet-header">
                <div class="sheet-drag-handle"></div>
                <span class="truncate">@_actionNote.Title</span>
            </div>
            <div class="sheet-body">
                @if (_actionNote.IsDeleted)
                {
                    <div class="sheet-action-item" @onclick="RestoreActionNote"><span>↩️</span> 恢复笔记</div>
                    <div class="sheet-action-item danger" @onclick="HardDeleteActionNote"><span>❌</span> 彻底删除</div>
                }
                else
                {
                    <div class="sheet-action-item" @onclick="ToggleActionNoteFavorite"><span>⭐</span> @(_actionNote.IsFavorite ? "取消收藏" : "收藏")</div>
                    <div class="sheet-action-item" @onclick="ToggleActionNotePin"><span>📌</span> @(_actionNote.IsPinned ? "取消置顶" : "置顶")</div>
                    <div class="sheet-action-item danger" @onclick="SoftDeleteActionNote"><span>🗑️</span> 移至回收站</div>
                }
            </div>
        </div>
    </div>
}

@if (_showEditorOptionsSheet)
{
    <div class="bottom-sheet-overlay" @onclick="() => _showEditorOptionsSheet = false">
        <div class="bottom-sheet-content" @onclick:stopPropagation="true">
            <div class="sheet-header">
                <div class="sheet-drag-handle"></div>
                <span>笔记选项</span>
            </div>
            <div class="sheet-body">
                <div class="sheet-action-item" @onclick="TogglePin">
                    <span>📌</span> @(SelectedNote.IsPinned ? "取消置顶" : "置顶笔记")
                </div>
                <div class="sheet-action-item" @onclick="() => { _showEditorOptionsSheet = false; _showFolderSelector = true; }">
                    <span>📁</span> 移动到...
                </div>
                <div class="sheet-action-item" @onclick="() => { _showEditorOptionsSheet = false; SaveAsTemplateAsync(SelectedNote); }">
                    <span>💾</span> 另存为模板
                </div>
                <div class="sheet-action-item danger" @onclick="DeleteCurrentNote">
                    <span>🗑️</span> 移至回收站
                </div>
            </div>
        </div>
    </div>
}

@if (_showTemplateSheet)
{
    <div class="bottom-sheet-overlay" @onclick="() => _showTemplateSheet = false">
        <div class="bottom-sheet-content" @onclick:stopPropagation="true">
            <div class="sheet-header">
                <div class="sheet-drag-handle"></div>
                <span>从模板新建</span>
            </div>
            <div class="sheet-body" style="max-height: 50vh; overflow-y: auto;">
                <div class="sheet-action-item" @onclick="() => ConfirmCreateNoteFromTemplate(null)">
                    <span>📄</span> 空白笔记
                </div>
                @foreach (var temp in _availableTemplates)
                {
                    <div class="sheet-action-item" @onclick="() => ConfirmCreateNoteFromTemplate(temp)">
                        <span>📝</span> @temp.Title
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_showFolderSelector)
{
    <div class="bottom-sheet-overlay" @onclick="() => _showFolderSelector = false">
        <div class="bottom-sheet-content" style="max-height: 80vh;" @onclick:stopPropagation="true">
            <div class="sheet-header">
                <div class="sheet-drag-handle"></div>
                <span>移动到...</span>
            </div>
            <div class="sheet-body" style="overflow-y: auto;">
                <div class="sheet-nav-item @(_targetFolder == "notes" ? "active" : "")" @onclick='() => _targetFolder = "notes"'>
                    📁 未分类
                </div>
                @foreach (var folder in _folderTree)
                {
                    if (folder.FullPath != "notes" && folder.FullPath != "每日速记")
                    {
                        <div class="sheet-nav-item @(_targetFolder == folder.FullPath ? "active" : "")" @onclick='() => _targetFolder = folder.FullPath'>
                            📁 @folder.Name
                        </div>
                    }
                }

                <div style="display: flex; gap: 12px; margin-top: 20px;">
                    <button class="btn-cancel" style="flex: 1; padding: 12px; border-radius: 8px; border: 1px solid #ddd; background: transparent;" @onclick="() => _showFolderSelector = false">取消</button>
                    <button class="btn-primary" style="flex: 1; padding: 12px; border-radius: 8px; border: none; background: #2eaadc; color: white;" disabled="@(string.IsNullOrEmpty(_targetFolder))" @onclick="ConfirmMoveNote">确认移动</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showWebDavSheet)
{
    <div class="bottom-sheet-overlay" @onclick="() => _showWebDavSheet = false">
        <div class="bottom-sheet-content" @onclick:stopPropagation="true">
            <div class="sheet-header">
                <div class="sheet-drag-handle"></div>
                <span>WebDAV 同步配置</span>
            </div>
            <div class="sheet-body">
                <div style="margin-bottom: 12px;">
                    <div style="font-size: 12px; color: #666; margin-bottom: 4px;">服务器地址 (如: https://dav.jianguoyun.com/dav/)</div>
                    <input class="mobile-search-input" style="margin-bottom:0;" type="text" @bind="_webDavUrl" placeholder="输入 WebDAV 地址" />
                </div>
                <div style="margin-bottom: 12px;">
                    <div style="font-size: 12px; color: #666; margin-bottom: 4px;">账号 (用户名)</div>
                    <input class="mobile-search-input" style="margin-bottom:0;" type="text" @bind="_webDavUser" placeholder="输入账号" />
                </div>
                <div style="margin-bottom: 24px;">
                    <div style="font-size: 12px; color: #666; margin-bottom: 4px;">密码 / 应用授权码</div>
                    <input class="mobile-search-input" style="margin-bottom:0;" type="password" @bind="_webDavPass" placeholder="输入密码" />
                </div>

                @if (!string.IsNullOrEmpty(_webDavTestStatus))
                {
                    <div style="font-size: 13px; font-weight: 500; color: @(_webDavTestStatus.Contains("❌") ? "#ff4d4f" : "#52c41a"); margin-bottom: 16px; text-align: center;">
                        @_webDavTestStatus
                    </div>
                }

                <div style="display: flex; gap: 12px;">
                    <button class="btn-cancel" style="flex: 1; padding: 12px; border-radius: 8px; border: 1px solid #ddd; background: transparent;" @onclick="() => _showWebDavSheet = false">取消</button>
                    <button class="btn-primary" style="flex: 1; padding: 12px; border-radius: 8px; border: none; background: #2eaadc; color: white;"
                            disabled="@_isTestingWebDav"
                            @onclick="TestAndSaveWebDavAsync">
                        @(_isTestingWebDav ? "正在测试..." : "测试连接并保存")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showWorkspaceSheet)
{
    <div class="bottom-sheet-overlay" @onclick="() => _showWorkspaceSheet = false">
        <div class="bottom-sheet-content" @onclick:stopPropagation="true">
            <div class="sheet-header">
                <div class="sheet-drag-handle"></div>
                <span>切换知识库</span>
            </div>
            <div class="sheet-body" style="max-height: 60vh; overflow-y: auto;">

                @* 列表展示所有知识库 *@
                @foreach (var ws in _workspaces)
                {
                    <div class="sheet-action-item" @onclick="() => SwitchWorkspace(ws)"
                         style="@(ws == NoteRepository.CurrentWorkspace ? "color: #2eaadc; font-weight: 600;" : "")">
                        <span>📚</span> @ws
                        @if (ws == NoteRepository.CurrentWorkspace)
                        {
                            <span style="margin-left:auto; font-size: 12px; background: rgba(46,170,220,0.1); padding: 2px 8px; border-radius: 10px;">当前</span>
                        }
                    </div>
                }

                @* 新建知识库区域 *@
                <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(0,0,0,0.05); display: flex; gap: 8px;">
                    <input type="text" class="mobile-search-input" style="flex: 1; margin-bottom: 0; padding: 10px; font-size: 14px;"
                           placeholder="输入新知识库名称..." @bind="_newWorkspaceName" />
                    <button class="btn-primary" style="padding: 10px 16px; border-radius: 8px; border: none; background: #2eaadc; color: white; white-space: nowrap;"
                            @onclick="CreateWorkspace">
                        新建
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@if (_showSuperSearchSheet)
{
    <div class="mobile-fullscreen-sheet" @onclick:stopPropagation="true">

        @* 🌟 1. 顶部搜索导航栏 *@
        <div class="mobile-search-header">
            <div class="search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input type="text" class="mobile-search-input"
                       placeholder="全局搜索笔记内容..."
                       @bind="_superSearchQuery"
                       @bind:event="oninput"
                       @onkeyup="HandleSearchKeyPress" />
                @if (!string.IsNullOrEmpty(_superSearchQuery))
                {
                    <button class="clear-input-btn" @onclick="() => _superSearchQuery = string.Empty">✖</button>
                }
            </div>
            @* 增加实体搜索按钮，防止部分输入法回车键失效 *@
            <button class="search-action-btn" @onclick="ExecuteSuperSearch">搜索</button>
            <button class="search-cancel-btn" @onclick="() => _showSuperSearchSheet = false">取消</button>
        </div>

        @* 🌟 2. 搜索结果滚动区 *@
        <div class="mobile-search-results">
            @if (_isSearching)
            {
                <div class="search-status-text">正在深潜检索中...</div>
            }
            else if (_searchResults.Any())
            {
                @foreach (var res in _searchResults)
                {
                    <div class="search-result-card" @onclick="() => JumpToSearchResult(res.NoteId)">
                        <div class="res-header">
                            <span class="res-title">📄 @res.Title</span>
                            <span class="res-folder">@res.Folder</span>
                        </div>
                        @if (res.Snippets != null && res.Snippets.Any())
                        {
                            <div class="res-snippets">
                                @foreach (var snippet in res.Snippets)
                                {
                                    <div class="snippet-line">@((MarkupString)snippet)</div>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else if (!string.IsNullOrEmpty(_superSearchQuery))
            {
                <div class="search-status-text">没有找到包含该内容的笔记 📭</div>
            }
        </div>
    </div>
}
<style>
    .mobile-workspace {
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        background-color: var(--nt-bg-main, #ffffff);
        color: var(--nt-text-main, #333333);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        overflow: hidden;
    }

    .mobile-main-view {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .mobile-content-area {
        flex: 1;
        overflow-y: auto;
        padding-bottom: 20px;
    }

    .mobile-bottom-nav {
        display: flex;
        justify-content: space-around;
        align-items: center;
        height: 56px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(0,0,0,0.05);
        padding-bottom: env(safe-area-inset-bottom);
        flex-shrink: 0;
    }

    .nav-tab {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
        height: 100%;
        color: #999;
        font-size: 10px;
        font-weight: 500;
    }

        .nav-tab.active {
            color: #2eaadc;
        }

    .nav-icon {
        font-size: 20px;
        margin-bottom: 2px;
        transition: transform 0.2s;
    }

    .nav-tab.active .nav-icon {
        transform: translateY(-2px) scale(1.1);
    }

    /* 🌟 改为真正的原生透明按钮，杜绝一切安卓 div 点击穿透问题 */
    .mobile-header-dropdown {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 16px;
        /* 🌟 核心保命代码：强制向下挤压 45px，把文字和点击区域拉出手机“系统状态栏”的触摸拦截区！ */
        padding-top: max(45px, env(safe-area-inset-top)) !important;
        font-size: 16px;
        font-weight: 600;
        border-bottom: 1px solid rgba(0,0,0,0.03);
        background-color: transparent;
        border: none;
        width: 100%;
        color: inherit;
        font-family: inherit;
        cursor: pointer;
        pointer-events: auto !important;
        -webkit-app-region: no-drag !important;
        touch-action: manipulation;
        position: relative;
        z-index: 99999 !important;
        outline: none;
    }

        .mobile-header-dropdown .icon {
            margin-left: 4px;
            font-size: 12px;
            opacity: 0.5;
        }

    .mobile-note-list {
        padding: 12px;
    }

    .mobile-note-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        background: rgba(55,53,47,0.03);
        border-radius: 12px;
        margin-bottom: 12px;
        transition: background 0.2s;
    }

        .mobile-note-card:active {
            background: rgba(55,53,47,0.08);
        }

    .card-content {
        flex: 1;
        overflow: hidden;
    }

    .card-title {
        font-size: 15px;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 6px;
    }

    .card-meta {
        font-size: 12px;
        color: #999;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .meta-tag {
        background: rgba(46,170,220,0.1);

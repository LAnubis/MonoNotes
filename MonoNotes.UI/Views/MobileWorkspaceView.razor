        {
            await RefreshWorkspaceDataAsync();
            // 🌟 核心确认：这里已经强制赋空，每次启动都会停留在笔记列表页面，不会自动进入笔记
            SelectedNoteId = string.Empty;

            var settings = await SettingsService.GetSettingsAsync();
            _webDavUrl = settings.WebDavUrl ?? "";
            _webDavUser = settings.WebDavUsername ?? "";
            _webDavPass = await SettingsService.GetSecurePasswordAsync("MonoNotes_WebDav_Password") ?? "";

            _autoSaveTimer.Elapsed += async (sender, e) => await PerformSaveAsync();
            // _bgSyncTimer.Elapsed += async (sender, e) => await TriggerBackgroundSync(isManual: false);
            // _bgSyncTimer.Start();

            _availableTemplates = await NoteRepository.GetAllTemplatesAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"🔥 初始化核爆级错误: {ex.Message}\n{ex.StackTrace}");
        }
    }

    public void Dispose()
    {
        _autoSaveTimer.Dispose();
    }

    private IEnumerable<NoteIndexItem> FilteredNotes
    {
        get
        {
            IEnumerable<NoteIndexItem> result = IndexItems;
            if (_isTrashFilterActive) { result = result.Where(n => n.IsDeleted); }
            else
            {
                result = result.Where(n => !n.IsDeleted && !n.IsArchived);
                if (_activeTags != null && _activeTags.Any())
                {
                    result = result.Where(n => n.Tags != null && _activeTags.Any(t => n.Tags.Contains(t)));
                }
                else if (_isFavoriteFilterActive)
                {
                    result = result.Where(n => n.IsFavorite);
                }
                else if (!string.IsNullOrEmpty(_selectedFolderPath))
                {
                    result = result.Where(n => n.Folder == _selectedFolderPath);
                }
            }
            return result.OrderByDescending(n => n.IsPinned).ThenByDescending(n => n.UpdatedAt);
        }
    }

    private void ResetFilters()
    {
        _isFavoriteFilterActive = false; _isTrashFilterActive = false;
        _selectedFolderPath = string.Empty; _activeTags.Clear();
    }
    private void ShowFavorites()
    {
        ResetFilters(); _isFavoriteFilterActive = true;
    }
    private void ShowTrash()
    {
        ResetFilters(); _isTrashFilterActive = true;
    }
    private void OnFolderSelectedHandler(string path)
    {
        ResetFilters(); _selectedFolderPath = path;
    }
    private void SelectTag(string tag)
    {
        ResetFilters(); _activeTags.Add(tag);

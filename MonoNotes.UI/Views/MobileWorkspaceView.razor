    // 2. 执行搜索核心逻辑
    private async Task ExecuteSuperSearch()
    {
        if (string.IsNullOrWhiteSpace(_superSearchQuery)) return;
        _isSearching = true;
        StateHasChanged(); // 让 UI 显示“正在搜索”的菊花转

        // 获取当前库所有物理文件进行全文检索
        var allNotes = await NoteRepository.GetAllNotesAsync();
        _searchResults = await SearchService.SearchAsync(_superSearchQuery, allNotes);

        _isSearching = false;
        StateHasChanged();
    }


@using MonoNotes.Core.Models
@using MonoNotes.Storage
@using System.Text.RegularExpressions
@inject WriteSpaceRepository Repository

@code {
    [Parameter] public string CurrentWorkId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnReturnClicked { get; set; }
    [Parameter] public string ActiveSubView { get; set; } = "editor";
    [Parameter] public EventCallback<string> OnSubViewSelected { get; set; }

    [Parameter] public EventCallback<string> OnChapterSelected { get; set; }
    // 🌟 新增：卷被选中时的事件 (向外传递 VolumeId)
    [Parameter] public EventCallback<string> OnVolumeSelected { get; set; }

    private string ActiveChapterId { get; set; } = string.Empty;
    // 🌟 新增：用于记录选中的卷
    private string ActiveVolumeId { get; set; } = string.Empty;

    private WorkIndex? CurrentWorkIndex;
    private List<Volume> NovelVolumes => CurrentWorkIndex?.Volumes ?? new();
    private string CurrentWorkTitle { get; set; } = "未命名作品";

    public async Task RefreshAsync()
    {
        await LoadIndexAsync();
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(CurrentWorkId))
        {
            await LoadIndexAsync();
        }
    }

    private async Task LoadIndexAsync()
    {
        var allWorks = await Repository.GetAllWorksAsync();
        var meta = allWorks.FirstOrDefault(w => w.Id == CurrentWorkId);
        if (meta != null) CurrentWorkTitle = meta.Title;

        CurrentWorkIndex = await Repository.GetWorkIndexAsync(CurrentWorkId);
        if (CurrentWorkIndex != null && !CurrentWorkIndex.Volumes.Any())
        {
            await AddNewVolume();
            await AddNewChapter(CurrentWorkIndex.Volumes.First());
        }
    }

    // ==========================================
    // 🌟 书名双击修改逻辑
    // ==========================================
    private bool _isEditingWorkTitle = false;
    private string _editingWorkTitle = "";

    private void StartEditWorkTitle()
    {
        _editingWorkTitle = CurrentWorkTitle;
        _isEditingWorkTitle = true;
    }

    private async Task CommitWorkTitle()
    {
        if (!string.IsNullOrWhiteSpace(_editingWorkTitle) && _editingWorkTitle != CurrentWorkTitle)
        {
            CurrentWorkTitle = _editingWorkTitle;
            await Repository.UpdateWorkTitleAsync(CurrentWorkId, _editingWorkTitle);
        }
        _isEditingWorkTitle = false;
    }

    private async Task HandleWorkTitleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitWorkTitle();
        if (e.Key == "Escape") _isEditingWorkTitle = false;
    }

    private string GetChineseNumber(int number)
    {
        string[] cn = { "零", "一", "二", "三", "四", "五", "六", "七", "八", "九", "十" };
        if (number <= 10) return cn[number];
        if (number < 20) return "十" + (number % 10 == 0 ? "" : cn[number % 10]);
        if (number < 100) return cn[number / 10] + "十" + (number % 10 == 0 ? "" : cn[number % 10]);
        return number.ToString();
    }

    private async Task SaveAndRecalculateIndexAsync()
    {
        if (CurrentWorkIndex == null) return;
        int volIndex = 1;
        foreach (var vol in CurrentWorkIndex.Volumes)
        {
            vol.Title = $"第{GetChineseNumber(volIndex)}卷";
            volIndex++;
            int chapIndex = 1;
            foreach (var chap in vol.Chapters)
            {
                var match = Regex.Match(chap.Title, @"^(第\s*\d+\s*[卷章][：\s]*)(.*)$");
                string body = match.Success ? match.Groups[2].Value : chap.Title;
                chap.Title = $"第 {chapIndex} 章：{(string.IsNullOrWhiteSpace(body) ? "新章节" : body)}";
                chapIndex++;
            }
        }
        await Repository.SaveWorkIndexAsync(CurrentWorkIndex);
    }

    private async Task AddNewVolume(string title = "")
    {
        if (CurrentWorkIndex == null) return;
        var newVol = new Volume { Title = "新建卷" };
        CurrentWorkIndex.Volumes.Add(newVol);
        await SaveAndRecalculateIndexAsync();
        // 🌟 新建后自动选中该卷
        await SelectVolume(newVol.Id);
    }

    private async Task AddNewChapter(Volume volume)
    {
        if (CurrentWorkIndex == null) return;
        var newChapter = new Chapter { Id = Guid.NewGuid().ToString("N"), Title = "新章节" };
        volume.Chapters.Add(newChapter);
        volume.IsExpanded = true;
        await SaveAndRecalculateIndexAsync();
        await SelectChapter(newChapter.Id);
    }

    private void ToggleVolume(Volume vol) { vol.IsExpanded = !vol.IsExpanded; }

    // ==========================================
    // 🌟 核心：智能选中卷/章逻辑
    // ==========================================
    private async Task SelectVolume(string volumeId)
    {
        ActiveVolumeId = volumeId;
        ActiveChapterId = string.Empty; // 选中卷时清空章选中态

        // 智能切换：卷只有大纲没有正文，所以强制跳到大纲视图
        if (ActiveSubView != "outline")
        {
            await OnSubViewSelected.InvokeAsync("outline");
        }
        await OnVolumeSelected.InvokeAsync(volumeId);
    }

    private async Task SelectChapter(string chapterId)
    {
        ActiveChapterId = chapterId;
        ActiveVolumeId = string.Empty; // 选中章时清空卷选中态

        // 智能切换：如果不在正文也不在大纲，切回正文
        if (ActiveSubView != "editor" && ActiveSubView != "outline")
        {
            await OnSubViewSelected.InvokeAsync("editor");
        }
        await OnChapterSelected.InvokeAsync(chapterId);
    }

    // ==========================================
    // 🌟 右键菜单与重命名逻辑 (已移除拖拽)
    // ==========================================
    private bool _showContextMenu = false;
    private double _menuX = 0;
    private double _menuY = 0;
    private object? _contextTarget;

    private bool _canRenameTarget = false;
    private bool _canDeleteTarget = false;

    private object? _editingItem;
    private string _editingPrefix = "";
    private string _editingBody = "";

    private void ShowContextMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, object target)
    {
        _contextTarget = target;
        _menuX = e.ClientX;
        _menuY = e.ClientY;

        if (target is Volume v)
        {
            _canRenameTarget = false;
            _canDeleteTarget = CurrentWorkIndex?.Volumes.LastOrDefault() == v;
        }
        else if (target is Chapter c)
        {
            _canRenameTarget = true;
            var vol = CurrentWorkIndex?.Volumes.FirstOrDefault(vol => vol.Chapters.Contains(c));
            _canDeleteTarget = vol?.Chapters.LastOrDefault() == c;
        }
        _showContextMenu = true;
    }

    private void CloseContextMenu() { _showContextMenu = false; }

    private void StartRename()
    {
        if (_contextTarget is Chapter c)
        {
            _editingItem = c;
            var match = Regex.Match(c.Title, @"^(第\s*\d+\s*[卷章][：\s]*)(.*)$");
            if (match.Success)
            {
                _editingPrefix = match.Groups[1].Value;
                _editingBody = match.Groups[2].Value;
            }
            else
            {
                _editingPrefix = "";
                _editingBody = c.Title;
            }
        }
        CloseContextMenu();
    }

    private async Task CommitRename()
    {
        if (_editingItem is Chapter c && !string.IsNullOrWhiteSpace(_editingBody))
        {
            c.Title = _editingPrefix + _editingBody;
            await SaveAndRecalculateIndexAsync();
        }
        _editingItem = null;
    }

    private async Task HandleRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitRename();
        if (e.Key == "Escape") _editingItem = null;
    }

    private async Task DeleteTarget()
    {
        if (_contextTarget == null || CurrentWorkIndex == null || !_canDeleteTarget) return;

        if (_contextTarget is Volume v) CurrentWorkIndex.Volumes.Remove(v);
        else if (_contextTarget is Chapter c)
        {
            var vol = CurrentWorkIndex.Volumes.FirstOrDefault(vol => vol.Chapters.Contains(c));
            vol?.Chapters.Remove(c);
        }
        await SaveAndRecalculateIndexAsync();
        CloseContextMenu();
    }
}

@if (_showContextMenu)
{
    <div class="sidebar-modal-overlay" @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault="true"></div>
}

<div class="sidebar-container">
    <div class="sidebar-top">
        <button class="back-btn" @onclick="OnReturnClicked">← 返回大厅</button>

        <div style="display:flex; align-items:center;">
            <span style="margin-right:6px;">📖</span>
            @if (_isEditingWorkTitle)
            {
                <input class="rename-input" style="font-weight:bold; width:100%;"
                       @bind="_editingWorkTitle"
                       @bind:event="oninput"
                       @onkeyup="HandleWorkTitleKey"
                       @onblur="CommitWorkTitle" autofocus />
            }
            else
            {
                <div class="work-title" style="cursor:pointer;" title="双击修改作品名" @ondblclick="StartEditWorkTitle">
                    @CurrentWorkTitle
                </div>
            }
        </div>
    </div>

    <div class="sidebar-nav">
        <button class="nav-tab @(ActiveSubView == "editor" ? "active" : "")" @onclick="@(() => OnSubViewSelected.InvokeAsync("editor"))">正文</button>
        <button class="nav-tab @(ActiveSubView == "outline" ? "active" : "")" @onclick="@(() => OnSubViewSelected.InvokeAsync("outline"))">大纲</button>
        <button class="nav-tab @(ActiveSubView == "materials" ? "active" : "")" @onclick="@(() => OnSubViewSelected.InvokeAsync("materials"))">设定</button>
        <button class="nav-tab @(ActiveSubView == "foreshadowing" ? "active" : "")" @onclick="@(() => OnSubViewSelected.InvokeAsync("foreshadowing"))">伏笔</button>
        <button class="nav-tab @(ActiveSubView == "details" ? "active" : "")" @onclick="@(() => OnSubViewSelected.InvokeAsync("details"))">详情</button>
    </div>

    <div class="tree-container">
        <div class="tree-header">
            <span>✍️ 正文目录</span>
            <button class="icon-btn" title="新建卷" @onclick="@(() => AddNewVolume(""))">➕</button>
        </div>

        <ul class="tree-list">
            @foreach (var volume in NovelVolumes)
            {
                <li class="volume-node">
                    <div class="volume-title @(ActiveVolumeId == volume.Id && ActiveSubView == "outline" ? "active" : "")"
                         @onclick="() => SelectVolume(volume.Id)"
                         @oncontextmenu="(e) => ShowContextMenu(e, volume)"
                         @oncontextmenu:preventDefault="true">

                        <span class="toggle-icon" @onclick="() => ToggleVolume(volume)" @onclick:stopPropagation="true">@(volume.IsExpanded ? "🔽" : "▶️")</span>
                        <span class="title-text" style="flex:1;">@volume.Title</span>
                        <button class="icon-btn" style="font-size: 10px;" @onclick="() => AddNewChapter(volume)" @onclick:stopPropagation="true">➕</button>
                    </div>

                    @if (volume.IsExpanded)
                    {
                        <ul class="chapter-list">
                            @foreach (var chapter in volume.Chapters)
                            {
                                <li class="chapter-node @(ActiveChapterId == chapter.Id && (ActiveSubView == "editor" || ActiveSubView == "outline") ? "active" : "")"
                                    @oncontextmenu="(e) => ShowContextMenu(e, chapter)"
                                    @oncontextmenu:preventDefault="true">

                                    @if (_editingItem == chapter)
                                    {
                                        <div style="display:flex; align-items:center; flex:1; overflow:hidden;">
                                            <span style="color: #9ca3af; font-size: 13px; margin-right: 4px; white-space:nowrap; user-select: none;">@_editingPrefix</span>
                                            <input class="rename-input" @bind="_editingBody" @bind:event="oninput" @onkeyup="HandleRenameKey" @onblur="CommitRename" autofocus />
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="chapter-title" @onclick="() => SelectChapter(chapter.Id)">@chapter.Title</span>
                                        <span class="word-count">@chapter.WordCount</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    </div>
</div>

@if (_showContextMenu)
{
    <div class="custom-context-menu" style="left: @(_menuX)px; top: @(_menuY)px;" @onclick:stopPropagation="true">
        @if (_canRenameTarget)
        {
            <div class="menu-item" @onclick="StartRename">✏️ 修改章节名</div>
        }
        else
        {
            <div class="menu-item" style="color:#ccc; cursor:not-allowed;" title="卷名由系统自动生成，不可修改">✏️ 修改卷名 (系统默认)</div>
        }

        <div class="menu-divider"></div>

        @if (_canDeleteTarget)
        {
            <div class="menu-item" style="color: #ff4d4f;" @onclick="DeleteTarget">🗑️ 从目录移除</div>
        }
        else
        {
            <div class="menu-item" style="color: #ccc; cursor:not-allowed;" title="为保证结构，只允许删除末尾项">🗑️ 从目录移除 (受限)</div>
        }
    </div>
}
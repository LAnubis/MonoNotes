@using MonoNotes.Core.Models
@using MonoNotes.Storage
@inject WriteSpaceRepository Repository

@code {
    [Parameter] public string CurrentWorkId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnReturnClicked { get; set; }
    [Parameter] public string ActiveSubView { get; set; } = "editor";
    [Parameter] public EventCallback<string> OnSubViewSelected { get; set; }

    private string ActiveChapterId { get; set; } = string.Empty;

    // 🌟 换成真实的索引对象
    private WorkIndex? CurrentWorkIndex;
    private List<Volume> NovelVolumes => CurrentWorkIndex?.Volumes ?? new();

    // 🌟 当 CurrentWorkId 发生变化时（比如你从大厅点进了一本书），触发加载
    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(CurrentWorkId))
        {
            await LoadIndexAsync();
        }
    }

    private async Task LoadIndexAsync()
    {
        CurrentWorkIndex = await Repository.GetWorkIndexAsync(CurrentWorkId);

        // 如果是空书（刚新建的），默认给它建一卷和一章
        if (CurrentWorkIndex != null && !CurrentWorkIndex.Volumes.Any())
        {
            await AddNewVolume("第一卷：风起云涌");
            await AddNewChapter(CurrentWorkIndex.Volumes.First());
        }
    }

    // 🌟 新建卷
    private async Task AddNewVolume(string title = "")
    {
        if (CurrentWorkIndex == null) return;
        var volTitle = string.IsNullOrEmpty(title) ? $"第 {CurrentWorkIndex.Volumes.Count + 1} 卷" : title;

        CurrentWorkIndex.Volumes.Add(new Volume { Title = volTitle });
        await Repository.SaveWorkIndexAsync(CurrentWorkIndex);
    }

    // 🌟 新建章
    private async Task AddNewChapter(Volume volume)
    {
        if (CurrentWorkIndex == null) return;

        var newChapter = new Chapter { Title = $"第 {volume.Chapters.Count + 1} 章：新章节" };
        volume.Chapters.Add(newChapter);
        volume.IsExpanded = true; // 新建后自动展开该卷

        await Repository.SaveWorkIndexAsync(CurrentWorkIndex);

        // 新建完自动选中它
        await SelectChapter(newChapter.Id);
    }

    private void ToggleVolume(Volume vol)
    {
        vol.IsExpanded = !vol.IsExpanded;
    }

    [Parameter]
    public EventCallback<string> OnChapterSelected { get; set; }

    // 修改现有的 SelectChapter 方法
    private async Task SelectChapter(string chapterId)
    {
        ActiveChapterId = chapterId;
        // 🌟 告诉父级：我要切到这个章节的编辑器
        await OnChapterSelected.InvokeAsync(chapterId);
    }
}

<div class="work-sidebar-container">
    <div class="sidebar-header back-btn" @onclick="OnReturnClicked">
        <span class="icon">⬅️</span> 返回创作空间
    </div>

    <div class="sidebar-scroll-area">
        <ul class="nav-list base-nav">
            <li class="@(ActiveSubView == "overview" ? "active" : "")"
                @onclick="@(() => OnSubViewSelected.InvokeAsync("overview"))">
                <span class="icon">📊</span> 概览
            </li>
            <li class="@(ActiveSubView == "outline" ? "active" : "")"
                @onclick="@(() => OnSubViewSelected.InvokeAsync("outline"))">
                <span class="icon">📌</span> 大纲
            </li>
            <li class="@(ActiveSubView == "foreshadowing" ? "active" : "")"
                @onclick="@(() => OnSubViewSelected.InvokeAsync("foreshadowing"))">
                <span class="icon">💡</span> 伏笔看板
            </li>
        </ul>

        <hr class="divider" />

        <div class="tree-header">
            <span>✍️ 正文目录</span>
            <button class="icon-btn" title="新建卷" @onclick="@(() => AddNewVolume(""))">➕</button>
        </div>

        <ul class="tree-list">
            @foreach (var volume in NovelVolumes)
            {
                <li class="volume-node">
                    <div class="volume-title" @onclick="() => ToggleVolume(volume)">
                        <span class="toggle-icon">@(volume.IsExpanded ? "🔽" : "▶️")</span>
                        <span class="title-text">@volume.Title</span>
                        <button class="icon-btn" style="margin-left:auto; font-size: 10px;"
                                @onclick="() => AddNewChapter(volume)" @onclick:stopPropagation="true">
                            ➕
                        </button>
                    </div>

                    @if (volume.IsExpanded)
                    {
                        <ul class="chapter-list">
                            @foreach (var chapter in volume.Chapters)
                            {
                                <li class="chapter-node @(ActiveChapterId == chapter.Id && ActiveSubView == "editor" ? "active" : "")"
                                    @onclick="() => SelectChapter(chapter.Id)">
                                    <span class="chapter-title">@chapter.Title</span>
                                    <span class="word-count">@chapter.WordCount</span>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>

        <hr class="divider" />

        <ul class="nav-list base-nav">
            <li class="@(ActiveSubView == "materials" ? "active" : "")"
                @onclick="@(() => OnSubViewSelected.InvokeAsync("materials"))">
                <span class="icon">📁</span> 单本素材
            </li>
            <li class="@(ActiveSubView == "statistics" ? "active" : "")"
                @onclick="@(() => OnSubViewSelected.InvokeAsync("statistics"))">
                <span class="icon">📈</span> 写作统计
            </li>
            <li class="@(ActiveSubView == "export" ? "active" : "")"
                @onclick="@(() => OnSubViewSelected.InvokeAsync("export"))">
                <span class="icon">📤</span> 导出设置
            </li>
        </ul>
    </div>
</div>
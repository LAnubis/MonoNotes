@using System.Timers
@using MonoNotes.Core.Interfaces
@using MonoNotes.Core.Models
@inject INoteRepository NoteRepository
@implements IDisposable

<div class="notion-workspace" @onclick="CloseContextMenu">
    <aside class="sidebar">
        <div class="workspace-switcher">
            <span class="icon">📝</span>
            <span class="text">My Workspace</span>
        </div>

        <div class="nav-menu">
            @if (Notes.Any(n => n.IsFavorite))
            {
                <div style="padding: 16px 16px 8px 16px; font-size: 11px; font-weight: 600; color: #999;">
                    <span>快捷方式</span>
                </div>
                <div style="padding: 0 8px; margin-bottom: 12px;">
                    <div class="nav-item @(_isFavoriteFilterActive ? "active" : "")"
                         style="padding: 4px 8px; cursor: pointer; display: flex; align-items: center; border-radius: 4px; font-size: 13px; color: var(--nt-text-main);"
                         @onclick="ShowFavorites">
                        <span style="margin-right: 8px;">⭐</span>
                        <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">我的收藏</span>
                    </div>

                    <div class="nav-item @(_isArchiveFilterActive ? "active" : "")"
                         style="padding: 4px 8px; cursor: pointer; display: flex; align-items: center; border-radius: 4px; font-size: 13px; color: var(--nt-text-main);"
                         @onclick="ShowArchives">
                        <span style="margin-right: 8px;">🗄️</span>
                        <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">归档</span>
                    </div>
                </div>
            }


            <div style="padding: 0 16px 8px 16px; font-size: 11px; font-weight: 600; color: #999; display: flex; justify-content: space-between; align-items: center;">
                <span>文件夹</span>
                <button class="icon-btn" title="新建主文件夹" @onclick="ShowNewMainFolderInput" @onclick:stopPropagation="true" style="padding: 0 4px; font-size: 12px;">➕</button>
            </div>

            @if (_showFolderInput)
            {
                <div style="padding: 0 16px 8px 16px;" @onclick:stopPropagation="true">
                    <input type="text" class="search-box" placeholder="@_folderInputPlaceholder"
                           @bind="_folderInputValue" @bind:event="oninput" @onkeyup="HandleFolderInputKey" />
                </div>
            }

            <div style="padding: 0 8px;">
                <FolderTree Nodes="_folderTree"
                            SelectedFolder="@_selectedFolderPath"
                            OnFolderSelected="OnFolderSelectedHandler"
                            OnContextMenu="HandleTreeContextMenu" />
            </div>

            @if (AllTags.Any())
            {
                <div style="padding: 16px 16px 8px 16px; font-size: 11px; font-weight: 600; color: #999; margin-top: 8px;">
                    <span>标签</span>
                </div>
                <div style="padding: 0 8px; overflow-y: auto; flex: 1;">
                    @foreach (var tag in AllTags)
                    {
                        <div class="nav-item @(tag == _selectedTag ? "active" : "")" @onclick="() => SelectTag(tag)">
                            <span style="margin-right: 8px; color: #888;">#</span>
                            <span style="flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@tag</span>
                        </div>
                    }
                </div>
            }
        </div>

        <button class="new-note-btn" @onclick="CreateNewNote">
            <span class="icon">➕</span> 新建页面
        </button>
    </aside>

    <section class="note-list">
        <div class="list-header">
            <input type="text" class="search-box" placeholder="搜索..."
                   @bind="_searchQuery" @bind:event="oninput" />
        </div>

        @foreach (var note in FilteredNotes)
        {
            <div class="note-card @(note.Id == SelectedNoteId ? "selected" : "")"
                 @onclick="() => SelectNote(note.Id)"
                 @oncontextmenu="(e) => ShowNoteContextMenu(e, note)"
                 @oncontextmenu:preventDefault="true">

                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="1.5" fill="none" class="file-icon">
                    <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                    <polyline points="13 2 13 9 20 9"></polyline>
                </svg>

                <div class="note-title">@(string.IsNullOrWhiteSpace(note.Title) ? "无标题" : note.Title)</div>

                <div style="margin-left: auto; display: flex; gap: 4px; font-size: 12px; opacity: 0.7;">
                    @if (note.IsFavorite)
                    {
                        <span>⭐</span>
                    }
                    @if (note.IsPinned)
                    {
                        <span>📌</span>
                    }
                </div>
            </div>
        }
    </section>

    <main class="editor-area">
        @if (SelectedNote != null)
        {
            <div class="editor-header">
                <div class="status-indicator">@_saveStatus</div>
                <div class="header-actions">
                    <button class="icon-btn" title="删除" @onclick="DeleteCurrentNote">🗑️</button>
                    <button class="icon-btn">⋯</button>
                </div>
            </div>

            <div class="editor-body">
                <input class="document-title" placeholder="无标题"
                       @bind="SelectedNote.Title" @bind:event="oninput" @onkeyup="OnNoteChanged" />

                <div class="note-tags-editor">
                    @if (SelectedNote.Tags != null)
                    {
                        @foreach (var tag in SelectedNote.Tags)
                        {
                            <span class="tag-pill">
                                <span>@tag</span>
                                <button class="tag-remove-btn" @onclick="() => RemoveTag(tag)">×</button>
                            </span>
                        }
                    }
                    <input type="text" class="tag-input" placeholder="输入标签并回车..."
                           @bind="_newTagInput" @bind:event="oninput" @onkeyup="HandleTagInputKey" />
                </div>

                <div class="document-content">
                    <MarkdownEditor Content="@SelectedNote.Content"
                                    ContentChanged="@((newContent) => { SelectedNote.Content = newContent; OnNoteChanged(); })" />
                </div>
            </div>
        }
    </main>

    @if (_showContextMenu && _contextMenuTarget != null)
    {
        <div class="custom-context-menu" style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;" @onclick:stopPropagation="true">
            <div class="menu-item" @onclick="CreateNoteInContextFolder">📄 在此新建笔记</div>

            @if (_contextMenuTarget.FullPath != "notes")
            {
                <div class="menu-divider"></div>
                @if (GetCurrentFolderDepth(_contextMenuTarget.FullPath) < 4)
                {
                    <div class="menu-item" @onclick="ShowNewSubFolderInput">📁 新建子文件夹</div>
                }
                <div class="menu-item" @onclick="ShowRenameFolderInput">✏️ 重命名</div>
            }
        </div>
    }



    @if (_showNoteContextMenu && _contextMenuNote != null)
    {
        <div class="custom-context-menu" style="left: @(_noteContextMenuX)px; top: @(_noteContextMenuY)px;" @onclick:stopPropagation="true">
            <div class="menu-item" @onclick="ToggleFavoriteContext">@(_contextMenuNote.IsFavorite ? "⭐ 取消收藏" : "⭐ 收藏")</div>
            <div class="menu-item" @onclick="TogglePinContext">@(_contextMenuNote.IsPinned ? "📌 取消置顶" : "📌 置顶")</div>
            <div class="menu-item" @onclick="ToggleArchiveContext">@(_contextMenuNote.IsArchived ? "🗄️ 取消归档" : "🗄️ 归档")</div>
            <div class="menu-divider"></div>
            <div class="menu-item" @onclick="() => OpenFolderSelector(false)">📁 移动到...</div>
            <div class="menu-item" @onclick="() => OpenFolderSelector(true)">📄 复制到...</div>
            <div class="menu-divider"></div>
            <div class="menu-item" style="color: #ff4d4f;" @onclick="DeleteNoteContext">🗑️ 删除</div>
        </div>
    }

    @if (_showFolderSelector)
    {
        <div class="modal-overlay" @onclick="CloseFolderSelector">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <span>@(_isCopyMode ? "复制到" : "移动到")</span>
                    <button class="icon-btn" @onclick="CloseFolderSelector">×</button>
                </div>
                <div class="modal-body">
                    <FolderTree Nodes="_folderTree"
                                SelectedFolder="@_targetFolder"
                                OnFolderSelected="(path) => _targetFolder = path" />
                </div>
                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="CloseFolderSelector">取消</button>
                    <button class="btn-primary" disabled="@(string.IsNullOrEmpty(_targetFolder))" @onclick="ConfirmMoveOrCopy">确认</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<MonoNote> Notes = new();
    private string SelectedNoteId = string.Empty;
    private string _searchQuery = string.Empty;
    private string _currentNav = "all";
    private MonoNote? SelectedNote => Notes.FirstOrDefault(n => n.Id == SelectedNoteId);

    private List<FolderTree.FolderNode> _folderTree = new();
    private string _selectedFolderPath = "notes";

    // === 🌟 右键菜单状态 ===
    private bool _showContextMenu = false;
    private double _contextMenuX = 0;
    private double _contextMenuY = 0;
    private FolderTree.FolderNode? _contextMenuTarget;

    // === 🌟 统一输入框状态 ===
    private bool _showFolderInput = false;
    private string _folderInputValue = string.Empty;
    private string _folderInputPlaceholder = string.Empty;
    private int _folderActionType = 0; // 0:主文件夹, 1:子文件夹, 2:重命名


    // === 🌟 标签系统状态 ===
    private string _selectedTag = string.Empty;
    private string _newTagInput = string.Empty;

    // === 🌟 笔记右键菜单与弹窗状态 ===
    private bool _showNoteContextMenu = false;
    private double _noteContextMenuX = 0;
    private double _noteContextMenuY = 0;
    private MonoNote? _contextMenuNote;

    private bool _showFolderSelector = false;
    private bool _isCopyMode = false;
    private string _targetFolder = string.Empty;

    // 🌟 新增：收藏视图激活状态
    private bool _isFavoriteFilterActive = false;
    // 🌟 新增：归档视图激活状态
    private bool _isArchiveFilterActive = false;
    // 动态计算系统中所有的唯一标签，并按字母排序
    private List<string> AllTags => Notes
        .Where(n => n.Tags != null)
        .SelectMany(n => n.Tags)
        .Distinct()
        .OrderBy(t => t)
        .ToList();

    // 🌟 激活收藏视图
    private void ShowFavorites()
    {
        _isFavoriteFilterActive = true;
        _isArchiveFilterActive = false;
        _selectedFolderPath = string.Empty;
        _selectedTag = string.Empty;
        SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
    }
    private void ShowArchives()
    {
        _isArchiveFilterActive = true;
        _isFavoriteFilterActive = false;
        _selectedFolderPath = string.Empty;
        _selectedTag = string.Empty;
        SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
    }
    private void OnFolderSelectedHandler(string path)
    {
        _isFavoriteFilterActive = false; // 切换时取消收藏视图
        _isArchiveFilterActive = false;
        _selectedFolderPath = path;
        _selectedTag = string.Empty; // 🌟 核心：选中文件夹时，清空标签过滤
        SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
    }
    // 🌟 新增：点击标签时的处理逻辑
    private void SelectTag(string tag)
    {
        _isFavoriteFilterActive = false; // 切换时取消收藏视图
        _isArchiveFilterActive = false;
        if (_selectedTag == tag)
        {
            _selectedTag = string.Empty; // 再次点击取消选中
            _selectedFolderPath = "notes"; // 默认回到未分类
        }
        else
        {
            _selectedTag = tag;
            _selectedFolderPath = string.Empty; // 🌟 核心：开启全局标签搜索，无视文件夹
        }
        SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
    }
    // 🌟 处理子组件传来的右键事件
    private void HandleTreeContextMenu((Microsoft.AspNetCore.Components.Web.MouseEventArgs e, FolderTree.FolderNode node) args)
    {
        _contextMenuTarget = args.node;
        _contextMenuX = args.e.ClientX;
        _contextMenuY = args.e.ClientY;
        _showContextMenu = true;
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _showNoteContextMenu = false; // 新增
    }

    // 🌟 三种模式的输入框唤起方法
    private void ShowNewMainFolderInput()
    {
        CloseContextMenu();
        _folderActionType = 0;
        _folderInputPlaceholder = "新建主文件夹...";
        _folderInputValue = string.Empty;
        _showFolderInput = true;
    }

    private void ShowNewSubFolderInput()
    {
        _folderActionType = 1;
        _folderInputPlaceholder = $"在 {_contextMenuTarget?.Name} 下新建...";
        _folderInputValue = string.Empty;
        _showFolderInput = true;
        CloseContextMenu();
    }

    private void ShowRenameFolderInput()
    {
        _folderActionType = 2;
        _folderInputPlaceholder = $"重命名 {_contextMenuTarget?.Name}...";
        _folderInputValue = _contextMenuTarget?.Name ?? "";
        _showFolderInput = true;
        CloseContextMenu();
    }

    private async Task HandleFolderInputKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_folderInputValue))
        {
            var val = _folderInputValue.Trim();

            if (_folderActionType == 0)
            {
                await NoteRepository.CreateFolderAsync("", val);
            }
            else if (_folderActionType == 1 && _contextMenuTarget != null)
            {
                await NoteRepository.CreateFolderAsync(_contextMenuTarget.FullPath, val);
            }
            else if (_folderActionType == 2 && _contextMenuTarget != null)
            {
                await NoteRepository.RenameFolderAsync(_contextMenuTarget.FullPath, val);
            }

            _showFolderInput = false;

            // 🌟 修复 1：重新拉取最新的文件夹结构并构建树
            var rawFolders = await NoteRepository.GetAllFoldersAsync();
            BuildFolderTree(rawFolders);

            // 🌟 修复 2：重新拉取所有笔记！(确保内存中的 Note.Folder 属性是最新的)
            Notes = await NoteRepository.GetAllNotesAsync();

            // 🌟 修复 3：如果是重命名，自动计算新路径，并让左侧菜单重新选中它
            if (_folderActionType == 2 && _contextMenuTarget != null)
            {
                // 计算父级路径
                var parentPath = _contextMenuTarget.FullPath.Contains('/')
                    ? _contextMenuTarget.FullPath.Substring(0, _contextMenuTarget.FullPath.LastIndexOf('/'))
                    : "";

                // 拼接出重命名后的新路径
                _selectedFolderPath = string.IsNullOrEmpty(parentPath) ? val : $"{parentPath}/{val}";

                // 默认选中该文件夹下的第一篇笔记
                SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
            }

            StateHasChanged();
        }
        else if (e.Key == "Escape")
        {
            _showFolderInput = false;
        }
    }

    // 🌟 在当前右键目标文件夹中新建笔记
    private async Task CreateNoteInContextFolder()
    {
        if (_contextMenuTarget == null) return;

        var newNote = new MonoNote
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = "",
            Content = "",
            UpdatedAt = DateTimeOffset.Now,
            Folder = _contextMenuTarget.FullPath
        };

        Notes.Insert(0, newNote);
        SelectedNoteId = newNote.Id;
        _selectedFolderPath = _contextMenuTarget.FullPath; // 界面焦点自动跳过去
        await NoteRepository.SaveNoteAsync(newNote);

        CloseContextMenu();
        StateHasChanged();
    }

    // 🌟 树状结构构建算法
    private void BuildFolderTree(List<string> rawPaths)
    {
        _folderTree.Clear();
        foreach (var path in rawPaths)
        {
            var parts = path.Split('/');
            var currentLevel = _folderTree;
            string currentFullPath = "";

            for (int i = 0; i < parts.Length; i++)
            {
                var part = parts[i];
                currentFullPath = string.IsNullOrEmpty(currentFullPath) ? part : $"{currentFullPath}/{part}";

                var existingNode = currentLevel.FirstOrDefault(n => n.FullPath == currentFullPath);
                if (existingNode == null)
                {
                    existingNode = new FolderTree.FolderNode
                    {
                        Name = currentFullPath == "notes" ? "未分类" : part,
                        FullPath = currentFullPath,
                        // 🌟 只展开第一级 (i == 0)
                        IsExpanded = i == 0
                    };
                    currentLevel.Add(existingNode);
                }
                currentLevel = existingNode.Children;
            }
        }

        // 🌟 重新排序：让未分类永远在第一位
        _folderTree = _folderTree
            .OrderByDescending(n => n.FullPath == "notes")
            .ThenBy(n => n.Name)
            .ToList();
    }

    private Timer _autoSaveTimer = new Timer(1000) { AutoReset = false };
    private string _saveStatus = "已保存";

    protected override async Task OnInitializedAsync()
    {
        Notes = await NoteRepository.GetAllNotesAsync();
        var rawFolders = await NoteRepository.GetAllFoldersAsync();

        BuildFolderTree(rawFolders);

        if (FilteredNotes.Any()) SelectedNoteId = FilteredNotes.First().Id;
        else await CreateNewNote();

        _autoSaveTimer.Elapsed += async (sender, e) => await PerformSaveAsync();
    }

    private IEnumerable<MonoNote> FilteredNotes
    {
        get
        {
            IEnumerable<MonoNote> result = Notes;

            // 🌟 核心拦截 1：如果处于“归档视图”，只显示已归档的笔记
            if (_isArchiveFilterActive)
            {
                result = result.Where(n => n.IsArchived);
            }
            else
            {
                // 🌟 核心拦截 2：如果处于“常规视图”，必须强制过滤掉所有已归档的笔记！
                result = result.Where(n => !n.IsArchived);

                // 在排除了归档笔记的基础上，继续进行原有的分类过滤
                if (_isFavoriteFilterActive)
                {
                    result = result.Where(n => n.IsFavorite);
                }
                else if (!string.IsNullOrEmpty(_selectedFolderPath))
                {
                    result = result.Where(n => n.Folder == _selectedFolderPath);
                }
                else if (!string.IsNullOrEmpty(_selectedTag))
                {
                    result = result.Where(n => n.Tags != null && n.Tags.Contains(_selectedTag));
                }
            }

            // 搜索过滤（全局生效）
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var query = _searchQuery.ToLower().Trim();
                result = result.Where(n => (n.Title?.ToLower().Contains(query) ?? false) || (n.Content?.ToLower().Contains(query) ?? false));
            }

            return result
                .OrderByDescending(n => n.IsPinned)
                .ThenByDescending(n => n.UpdatedAt);
        }
    }

    private async Task CreateNewNote()
    {
        var targetFolder = string.IsNullOrWhiteSpace(_selectedFolderPath) ? "notes" : _selectedFolderPath;
        var newNote = new MonoNote
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = "",
            Content = "",
            UpdatedAt = DateTimeOffset.Now,
            Folder = targetFolder
        };
        Notes.Insert(0, newNote);
        SelectedNoteId = newNote.Id;
        await NoteRepository.SaveNoteAsync(newNote);
        StateHasChanged();
    }

    private async Task DeleteCurrentNote()
    {
        if (SelectedNote != null)
        {
            await NoteRepository.DeleteNoteAsync(SelectedNote.Id);
            Notes.Remove(SelectedNote);
            SelectedNoteId = FilteredNotes.Any() ? FilteredNotes.First().Id : string.Empty;
            StateHasChanged();
        }
    }

    private void SelectNote(string id) { SelectedNoteId = id; _saveStatus = "已保存"; }

    private void SwitchNav(string navType) { _currentNav = navType; SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty; }

    private void OnNoteChanged()
    {
        _saveStatus = "正在保存...";
        _autoSaveTimer.Stop(); _autoSaveTimer.Start();
        StateHasChanged();
    }

    private async Task PerformSaveAsync()
    {
        if (SelectedNote != null)
        {
            await NoteRepository.SaveNoteAsync(SelectedNote);
            _saveStatus = "已保存";
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() { _autoSaveTimer.Dispose(); }

    private int GetCurrentFolderDepth(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return 1;
        return path.Split(new[] { '/' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    // 🌟 新增：处理标签输入
    private async Task HandleTagInputKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newTagInput) && SelectedNote != null)
        {
            var tag = _newTagInput.Trim().TrimStart('#'); // 去掉用户可能多输入的 #
            SelectedNote.Tags ??= new List<string>();

            if (!SelectedNote.Tags.Contains(tag))
            {
                SelectedNote.Tags.Add(tag);
                await PerformSaveAsync(); // 立即保存到物理文件
            }
            _newTagInput = string.Empty;
        }
    }

    // 🌟 新增：删除标签
    private async Task RemoveTag(string tag)
    {
        if (SelectedNote != null && SelectedNote.Tags != null)
        {
            SelectedNote.Tags.Remove(tag);
            await PerformSaveAsync();
        }
    }

    private void ShowNoteContextMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, MonoNote note)
    {
        CloseContextMenu();
        _contextMenuNote = note;
        _noteContextMenuX = e.ClientX;
        _noteContextMenuY = e.ClientY;
        _showNoteContextMenu = true;
    }

    private async Task ToggleFavoriteContext()
    {
        if (_contextMenuNote != null)
        {
            _contextMenuNote.IsFavorite = !_contextMenuNote.IsFavorite;
            // 🌟 直接调用底层的 SaveNoteAsync，并传入当前右击的笔记
            await NoteRepository.SaveNoteAsync(_contextMenuNote);
            StateHasChanged();
        }
        _showNoteContextMenu = false;
    }

    private async Task TogglePinContext()
    {
        if (_contextMenuNote != null)
        {
            _contextMenuNote.IsPinned = !_contextMenuNote.IsPinned;
            // 🌟 同样直接调用底层保存方法
            await NoteRepository.SaveNoteAsync(_contextMenuNote);
            StateHasChanged();
        }
        _showNoteContextMenu = false;
    }

    private async Task DeleteNoteContext()
    {
        if (_contextMenuNote != null)
        {
            await NoteRepository.DeleteNoteAsync(_contextMenuNote.Id);
            Notes.Remove(_contextMenuNote);
            if (SelectedNoteId == _contextMenuNote.Id) SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
        }
        _showNoteContextMenu = false;
    }

    private void OpenFolderSelector(bool isCopy)
    {
        _isCopyMode = isCopy;
        _targetFolder = string.Empty;
        _showFolderSelector = true;
        _showNoteContextMenu = false;
    }

    private void CloseFolderSelector() => _showFolderSelector = false;

    private async Task ConfirmMoveOrCopy()
    {
        if (_contextMenuNote == null || string.IsNullOrEmpty(_targetFolder)) return;

        if (_isCopyMode)
        {
            // 🌟 复制逻辑：生成新 ID，追加“副本”标识
            var newNote = new MonoNote
            {
                Id = Guid.NewGuid().ToString("N"),
                Title = _contextMenuNote.Title + " - 副本",
                Content = _contextMenuNote.Content,
                Folder = _targetFolder,
                UpdatedAt = DateTimeOffset.Now
            };
            Notes.Insert(0, newNote);
            await NoteRepository.SaveNoteAsync(newNote);
        }
        else
        {
            // 🌟 移动逻辑
            // 【注意】如果你底层是写死的 IO，这里可能需要调用专门的 MoveNoteAsync 删除老物理文件。
            // 只要底层仓储处理好了，这里只需改内存即可。
            _contextMenuNote.Folder = _targetFolder;
            await NoteRepository.SaveNoteAsync(_contextMenuNote);
        }

        _showFolderSelector = false;
        StateHasChanged();
    }

    // 🌟 新增：切换归档状态
    private async Task ToggleArchiveContext()
    {
        if (_contextMenuNote != null)
        {
            _contextMenuNote.IsArchived = !_contextMenuNote.IsArchived;
            await NoteRepository.SaveNoteAsync(_contextMenuNote);
            StateHasChanged();
        }
        _showNoteContextMenu = false;
    }
}
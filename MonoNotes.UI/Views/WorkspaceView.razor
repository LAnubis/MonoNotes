    private async Task ConfirmRenameTag()
    {
        if (string.IsNullOrWhiteSpace(_newTagName) || _newTagName == _editingTag)
        {
            CancelEditTag();
            return;
        }

        await NoteRepository.RenameTagGlobalAsync(_editingTag, _newTagName);
        var allNotes = await NoteRepository.GetAllNotesAsync();
        foreach (var idx in IndexItems.Where(n => n.Tags != null && n.Tags.Contains(_editingTag)).ToList())
        {
            idx.Tags.Remove(_editingTag);
            if (!idx.Tags.Contains(_newTagName)) idx.Tags.Add(_newTagName);
            IndexService.UpsertItem(idx);

            var bookNote = allNotes.FirstOrDefault(n => n.Id == idx.Id);
            if (bookNote != null && bookNote.Tags != null)
            {
                bookNote.Tags.Remove(_editingTag);
                if (!bookNote.Tags.Contains(_newTagName)) bookNote.Tags.Add(_newTagName);
                await NoteRepository.SaveNoteAsync(bookNote);
            }
        }

        _allTagsWithCount = GetTagFrequencies(); // 更新列表和数量
        CancelEditTag();
        StateHasChanged();
    }


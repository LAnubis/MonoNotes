    private async Task HandleNoteClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, string noteId)
    {
        var filteredList = FilteredNotes.ToList();
        int currentIndex = filteredList.FindIndex(n => n.Id == noteId);

        if (e.CtrlKey || e.MetaKey)
        {
            // Ctrl/Cmd 点击：跳跃多选/取消选择
            if (_selectedNoteIds.Contains(noteId)) _selectedNoteIds.Remove(noteId);
            else _selectedNoteIds.Add(noteId);

            _lastSelectedNoteIndex = currentIndex;
        }
        else if (e.ShiftKey && _lastSelectedNoteIndex != -1)
        {
            // Shift 点击：连续范围多选
            int start = Math.Min(_lastSelectedNoteIndex, currentIndex);
            int end = Math.Max(_lastSelectedNoteIndex, currentIndex);

            _selectedNoteIds.Clear();
            for (int i = start; i <= end; i++)
            {
                _selectedNoteIds.Add(filteredList[i].Id);
            }
        }
        else
        {
            // 普通单点：清除其他，只选当前
            _selectedNoteIds.Clear();
            _selectedNoteIds.Add(noteId);
            _lastSelectedNoteIndex = currentIndex;
        }

        // 渲染策略分配
        if (_selectedNoteIds.Count == 1)
        {
            await SelectNote(_selectedNoteIds.First());
        }
        else
        {
            // 选了多篇，隐藏编辑器，展示批量操作面板
            SelectedNoteId = string.Empty;
            StateHasChanged();
        }
    }


        _openTabs.Clear();
        _openNotesCache.Clear();
        SelectedNoteId = string.Empty;
        _selectedFolderPath = "notes";
        _selectedTag = string.Empty;

        await OnInitializedAsync();
        StateHasChanged();
    }


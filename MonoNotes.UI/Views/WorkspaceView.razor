@code {

    private List<NoteIndexItem> IndexItems = new();

    // 编辑器使用完整笔记缓存，只加载打开的标签页
    private List<MonoNote> _openNotesCache = new();

    private HashSet<string> _selectedNoteIds = new();
    private int _lastSelectedNoteIndex = -1; // 记录上一次点击的索引，用于 Shift 连续多选
    private bool _isBatchOperation = false; // 区分当前是单篇移动还是批量移动
    private bool _showEmptyTrashConfirm = false; // 清空回收站确认框

    private string SelectedNoteId = string.Empty;
    private string _searchQuery = string.Empty;
    private string _currentNav = "all";

    // 🌟 核心修改 2：编辑器从已打开的缓存中取数据
    private MonoNote? SelectedNote => _openNotesCache.FirstOrDefault(n => n.Id == SelectedNoteId);

    private List<FolderTree.FolderNode> _folderTree = new();
    private string _selectedFolderPath = "notes";

    private bool _showContextMenu = false;
    private double _contextMenuX = 0;
    private double _contextMenuY = 0;
    private FolderTree.FolderNode? _contextMenuTarget;

    private bool _showFolderInput = false;
    private string _folderInputValue = string.Empty;
    private string _folderInputPlaceholder = string.Empty;
    private int _folderActionType = 0;

    private HashSet<string> _activeTags = new();

    private string _newTagInput = string.Empty;

    private bool _showNoteContextMenu = false;
    private double _noteContextMenuX = 0;
    private double _noteContextMenuY = 0;
    private NoteIndexItem? _contextMenuNote;
    // 🌟 上下文菜单现在针对的是 IndexItem

    private bool _showFolderSelector = false;
    private bool _isCopyMode = false;
    private string _targetFolder = string.Empty;

    private bool _isFavoriteFilterActive = false;
    private bool _isArchiveFilterActive = false;
    private bool _isTrashFilterActive = false;
    private bool _showFolderDeleteConfirm = false;
    private int _notesInFolderCount = 0;

    private bool _showWarningDialog = false;
    private string _warningMessage = string.Empty;
    private bool _showTagManagerDialog = false;

    // 🌟 新变量：用于在标签管理弹窗中展示带数量的标签
    private List<KeyValuePair<string, int>> _allTagsWithCount = new();

    private string _editingTag = string.Empty;
    private string _newTagName = string.Empty;
    private bool _showTagDeleteConfirm = false;
    private string _tagToDelete = string.Empty;

    private List<string> _openTabs = new();

    private bool _showWorkspaceModal = false;
    private List<string> _workspaces = new();
    private string _newWorkspaceName = string.Empty;

    private bool _showSettingsDialog = false;


    // === 🌟 后台同步与冲突处理 ===
    private bool _isSyncingUI = false;
    private bool _showConflictCenter = false;
    private List<string> _conflictFiles = new();
    // === 🔍 超级搜索系统状态 ===
    private bool _showSuperSearch = false;
    private string _superSearchQuery = string.Empty;
    private List<SearchResultItem> _searchResults = new();

    private bool _isGraphExpanded = false;

    protected override async Task OnInitializedAsync()
    {
        // 1. 加载现有的 JSON 索引
        IndexItems = await IndexService.LoadIndexAsync();
        // 🌟 2. 终极自愈机制：全盘对齐本地文件！
        // 从底层仓储直接读取硬盘里所有的真实 .md 文件
        var allNotes = await NoteRepository.GetAllNotesAsync();
        foreach (var note in allNotes)
        {
            // 如果硬盘里的文件，没有在内存索引里登记，立刻强制补录！
            if (!IndexItems.Any(idx => idx.Id == note.Id))
            {
                var newIdx = new NoteIndexItem
                {
                    Id = note.Id,
                    Title = string.IsNullOrWhiteSpace(note.Title) ? "无标题" : note.Title,
                    // 确保旧笔记的空文件夹路径被规范化为 "notes" (未分类)
                    Folder = string.IsNullOrWhiteSpace(note.Folder) ? "notes" : note.Folder,
                    UpdatedAt = note.UpdatedAt,
                    CreatedAt = note.UpdatedAt,
                    IsPinned = note.IsPinned,
                    IsFavorite = note.IsFavorite,
                    IsDeleted = note.IsDeleted,
                    IsArchived = note.IsArchived,
                    Tags = note.Tags ?? new List<string>()
                };

                IndexItems.Add(newIdx);
                IndexService.UpsertItem(newIdx);
                // 触发底层防抖写入 index.json
            }
        }

        // 3. 构建左侧树状图
        var rawFolders = await NoteRepository.GetAllFoldersAsync();
        BuildFolderTree(rawFolders);

        // 4. 决定启动时选中的笔记
        if (FilteredNotes.Any())
        {
            await SelectNote(FilteredNotes.First().Id);
        }
        else if (!allNotes.Any())
        {
            // 🌟 只有在硬盘里真的一篇笔记都没有的时候，才允许新建空白笔记
            await CreateNewNote();
        }

        // 5. 启动后台服务
        _autoSaveTimer.Elapsed += async (sender, e) => await PerformSaveAsync();

        ScanForConflicts();

        _pendingSyncCount = await SyncService.GetPendingSyncCountAsync(NoteRepository.CurrentWorkspace);
        if (_pendingSyncCount > 0)
        {
            // 本地有上次没传完的修改，直接弹出同步确认框！
            _syncState = 0;
            _showSyncModal = true;
        }
        else
        {
            // 本地没修改，为了防止别的电脑改了内容，我们开一个后台静默线程去云端拉取
            _ = Task.Run(async () =>
            {
                await SyncService.SyncAsync(isLocalChanged: false);
                if (SyncService.HasConflictsInLastSync)
                {
                    // 如果拉取发现了变动，刷新 UI
                    await InvokeAsync(() =>
                    {
                        var rawFolders = NoteRepository.GetAllFoldersAsync().Result;
                        BuildFolderTree(rawFolders);
                        StateHasChanged();
                    });
                }
            });
        }
    }

    public void Dispose()
    {
        _autoSaveTimer.Dispose();
    }
    private void ScanForConflicts()
    {
        try
        {
            string basePath = PathHelper.GetWorkspacesDirectory();
            var dataDir = Path.Combine(basePath, NoteRepository.CurrentWorkspace);
            if (Directory.Exists(dataDir))
            {
                _conflictFiles = Directory.GetFiles(dataDir, "*冲突副本*.md", SearchOption.AllDirectories).ToList();
            }
        }
        catch { }
    }

    private async Task ResolveConflict(string conflictFilePath, bool keepLocal)
    {
        try
        {
            var conflictFileName = Path.GetFileName(conflictFilePath);
            var dir = Path.GetDirectoryName(conflictFilePath);
            var originalFileName = System.Text.RegularExpressions.Regex.Replace(conflictFileName, @"\s\(冲突副本.*?\)", "");
            var originalFilePath = Path.Combine(dir, originalFileName);
            if (keepLocal)
            {
                if (File.Exists(conflictFilePath)) File.Delete(conflictFilePath);
            }
            else
            {
                if (File.Exists(originalFilePath)) File.Delete(originalFilePath);
                if (File.Exists(conflictFilePath)) File.Move(conflictFilePath, originalFilePath);
            }

            ScanForConflicts();
            IndexItems = await IndexService.LoadIndexAsync(); // 🌟 重载索引
            var rawFolders = await NoteRepository.GetAllFoldersAsync();
            BuildFolderTree(rawFolders);

            _ = SyncService.SyncAsync();
        }
        catch { }
    }

    private void ShowTrash()
    {
        _isTrashFilterActive = true;
        _isArchiveFilterActive = false;
        _isFavoriteFilterActive = false;
        _selectedFolderPath = string.Empty;
        _activeTags.Clear();
        SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
        StateHasChanged();
    }

    // 🌟 核心算法：获取所有标签，按使用次数降序排列，次数相同的按字母排列
    private List<KeyValuePair<string, int>> GetTagFrequencies()
    {
        return IndexItems
            .Where(n => !n.IsDeleted && n.Tags != null)
            .SelectMany(n => n.Tags!)
            .GroupBy(t => t)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(kv => kv.Value)
            .ThenBy(kv => kv.Key)
            .ToList();
    }

    private void ShowFavorites()
    {
        _isFavoriteFilterActive = true;
        _isArchiveFilterActive = false;
        _isTrashFilterActive = false;
        _selectedFolderPath = string.Empty;
        _activeTags.Clear();
        SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
    }

    private void ShowArchives()
    {
        _isArchiveFilterActive = true;
        _isFavoriteFilterActive = false;
        _isTrashFilterActive = false;
        _selectedFolderPath = string.Empty;
        _activeTags.Clear();

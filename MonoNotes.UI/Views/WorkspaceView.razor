@using System.Timers
@using MonoNotes.Core.Interfaces
@using MonoNotes.Core.Models
@inject INoteRepository NoteRepository
@implements IDisposable
@inject IJSRuntime JSRuntime

<div class="notion-workspace" @onclick="CloseContextMenu">
    <aside class="sidebar">
        <div class="workspace-switcher">
            <span class="icon">📝</span>
            <span class="text">My Workspace</span>
        </div>

        <div class="nav-menu">
            @if (Notes.Any(n => n.IsFavorite))
            {
                <div style="padding: 16px 16px 8px 16px; font-size: 11px; font-weight: 600; color: #999;">
                    <span>快捷方式</span>
                </div>
                <div style="padding: 0 8px; margin-bottom: 12px;">
                    <div class="nav-item @(_isFavoriteFilterActive ? "active" : "")"
                         style="padding: 4px 8px; cursor: pointer; display: flex; align-items: center; border-radius: 4px; font-size: 13px; color: var(--nt-text-main);"
                         @onclick="ShowFavorites">
                        <span style="margin-right: 8px;">⭐</span>
                        <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">收藏</span>
                    </div>

                    <div class="nav-item @(_isArchiveFilterActive ? "active" : "")"
                         style="padding: 4px 8px; cursor: pointer; display: flex; align-items: center; border-radius: 4px; font-size: 13px; color: var(--nt-text-main); margin-top: 6px;"
                         @onclick="ShowArchives">
                        <span style="margin-right: 8px;">🗄️</span>
                        <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">归档</span>
                    </div>

                    <div class="nav-item @(_isTrashFilterActive ? "active" : "")"
                         style="padding: 4px 8px; cursor: pointer; display: flex; align-items: center; border-radius: 4px; font-size: 13px; color: var(--nt-text-main); margin-top: 6px;"
                         @onclick="ShowTrash">
                        <span style="margin-right: 8px;">🗑️</span>
                        <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">回收站</span>
                    </div>
                </div>
            }


            <div style="padding: 0 16px 8px 16px; font-size: 11px; font-weight: 600; color: #999; display: flex; justify-content: space-between; align-items: center;">
                <span>文件夹</span>
                <button class="icon-btn" title="新建主文件夹" @onclick="ShowNewMainFolderInput" @onclick:stopPropagation="true" style="padding: 0 4px; font-size: 12px;">➕</button>
            </div>

            @if (_showFolderInput)
            {
                <div style="padding: 0 16px 8px 16px;" @onclick:stopPropagation="true">
                    <input type="text" class="search-box" placeholder="@_folderInputPlaceholder"
                           @bind="_folderInputValue" @bind:event="oninput" @onkeyup="HandleFolderInputKey" />
                </div>
            }

            <div style="padding: 0 8px;">
                <FolderTree Nodes="_folderTree"
                            SelectedFolder="@_selectedFolderPath"
                            OnFolderSelected="OnFolderSelectedHandler"
                            OnContextMenu="HandleTreeContextMenu" />
            </div>

            @if (AllTags.Any())
            {
                <div style="padding: 16px 16px 8px 16px; font-size: 11px; font-weight: 600; color: #999; display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                    <span>标签</span>
                    <button class="icon-btn" style="font-size: 14px; opacity: 0.6; padding: 0 4px;" title="管理标签" @onclick="OpenTagManager" @onclick:stopPropagation="true">⚙️</button>
                </div>
                <div style="padding: 0 8px; overflow-y: auto; flex: 1;">
                    @foreach (var tag in AllTags)
                    {
                        <div class="nav-item @(tag == _selectedTag ? "active" : "")" @onclick="() => SelectTag(tag)">
                            <span style="margin-right: 8px; color: #888;">#</span>
                            <span style="flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@tag</span>
                        </div>
                    }
                </div>
            }
        </div>

        <button class="new-note-btn" @onclick="CreateNewNote">
            <span class="icon">➕</span> 新建页面
        </button>
    </aside>

    <section class="note-list">
        <div class="list-header">
            <input type="text" class="search-box" placeholder="搜索..."
                   @bind="_searchQuery" @bind:event="oninput" />
        </div>

        @foreach (var note in FilteredNotes)
        {
            <div class="note-card @(note.Id == SelectedNoteId ? "selected" : "")"
                 @onclick="() => SelectNote(note.Id)"
                 @oncontextmenu="(e) => ShowNoteContextMenu(e, note)"
                 @oncontextmenu:preventDefault="true">

                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="1.5" fill="none" class="file-icon">
                    <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                    <polyline points="13 2 13 9 20 9"></polyline>
                </svg>

                <div class="note-title">@(string.IsNullOrWhiteSpace(note.Title) ? "无标题" : note.Title)</div>

                <div style="margin-left: auto; display: flex; gap: 4px; font-size: 12px; opacity: 0.7;">
                    @if (note.IsFavorite)
                    {
                        <span>⭐</span>
                    }
                    @if (note.IsPinned)
                    {
                        <span>📌</span>
                    }
                </div>
            </div>
        }
    </section>

    <main class="editor-area" style="display: flex; flex-direction: column;">

        <style>
                    .tabs-bar {
                        display: flex;
                        background-color: #fbfbfa;
                        border-bottom: 1px solid rgba(55, 53, 47, 0.09);
                        padding: 8px 12px 0 12px;
                        gap: 4px;
                        overflow-x: auto;
                        min-height: 42px;
                    }

                        .tabs-bar::-webkit-scrollbar {
                            display: none;
                        }
                    /* 隐藏滚动条 */

                    .tab-item {
                        display: flex;
                        align-items: center;
                        padding: 6px 14px;
                        border-radius: 8px 8px 0 0;
                        cursor: pointer;
                        font-size: 13px;
                        max-width: 180px;
                        min-width: 120px;
                        color: rgba(55, 53, 47, 0.6);
                        background: transparent;
                        border: 1px solid transparent;
                        border-bottom: none;
                        transition: background-color 0.15s ease;
                    }

                        .tab-item:hover {
                            background: rgba(55, 53, 47, 0.05);
                        }

                        /* 激活状态：浮起并变成纯白底色 */
                        .tab-item.active {
                            background: #ffffff;
                            color: rgba(55, 53, 47, 0.85);
                            font-weight: 500;
                            border-color: rgba(55, 53, 47, 0.09);
                            box-shadow: 0 -2px 6px rgba(0,0,0,0.02);
                        }

                    .tab-close-btn {
                        margin-left: auto;
                        border-radius: 4px;
                        padding: 0 4px;
                        opacity: 0;
                        font-size: 14px;
                        transition: opacity 0.2s, background-color 0.2s;
                    }

                    .tab-item:hover .tab-close-btn, .tab-item.active .tab-close-btn {
                        opacity: 0.5;
                    }

                    .tab-close-btn:hover {
                        opacity: 1 !important;
                        background: rgba(55, 53, 47, 0.1);
                        color: #ff4d4f;
                    }
        </style>

        <div class="tabs-bar">
            @foreach (var tabId in _openTabs)
            {
                var tabNote = Notes.FirstOrDefault(n => n.Id == tabId);
                if (tabNote != null)
                {
                    <div class="tab-item @(tabId == SelectedNoteId ? "active" : "")" @onclick="() => SelectNote(tabId)">
                        <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1;">
                            @(string.IsNullOrWhiteSpace(tabNote.Title) ? "无标题" : tabNote.Title)
                        </span>
                        <button class="icon-btn tab-close-btn" @onclick="() => CloseTab(tabId)" @onclick:stopPropagation="true">×</button>
                    </div>
                }
            }
        </div>

        @if (SelectedNote != null)
        {
            <div class="editor-header">
                <div class="status-indicator">@_saveStatus</div>
                <div class="header-actions">
                    <button class="icon-btn" title="@(SelectedNote.IsPinned ? "取消置顶" : "置顶笔记")" @onclick="TogglePin">@(SelectedNote.IsPinned ? "📌" : "📍")</button>

                    @if (SelectedNote.IsDeleted)
                    {
                        <button class="icon-btn" title="恢复笔记" @onclick="RestoreCurrentNote">↩️</button>
                    }
                    else
                    {
                        <button class="icon-btn" title="移至回收站" @onclick="DeleteCurrentNote">🗑️</button>
                    }
                    <button class="icon-btn">⋯</button>
                </div>
            </div>

            <div class="editor-body">
                <input class="document-title" placeholder="无标题"
                       @bind="SelectedNote.Title" @bind:event="oninput" @onkeyup="OnNoteChanged" />

                <div class="note-tags-editor">
                    @if (SelectedNote.Tags != null)
                    {
                        @foreach (var tag in SelectedNote.Tags)
                        {
                            <span class="tag-pill">
                                <span>@tag</span>
                                <button class="tag-remove-btn" @onclick="() => RemoveTag(tag)">×</button>
                            </span>
                        }
                    }
                    <input type="text" class="tag-input" placeholder="输入标签并回车..."
                           @bind="_newTagInput" @bind:event="oninput" @onkeyup="HandleTagInputKey" />
                </div>

                <div class="document-content">
                    <MarkdownEditor Content="@SelectedNote.Content"
                                    ContentChanged="@((newContent) => { SelectedNote.Content = newContent; OnNoteChanged(); })"
                                    CurrentFolder="@SelectedNote.Folder" />
                </div>
            </div>
        }
        else
        {
            <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #ffffff;">
                <span style="font-size: 48px; filter: grayscale(1) opacity(0.2); margin-bottom: 16px;">📝</span>
                <p style="color: rgba(55,53,47,0.4); font-size: 14px; letter-spacing: 1px;">选择或新建一篇笔记以开始编写</p>
            </div>
        }
    </main>

    @if (_showContextMenu && _contextMenuTarget != null)
    {
        <div class="custom-context-menu" style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;" @onclick:stopPropagation="true">
            <div class="menu-item" @onclick="CreateNoteInContextFolder">📄 在此新建笔记</div>

            @if (_contextMenuTarget.FullPath != "notes")
            {
                <div class="menu-divider"></div>
                @if (GetCurrentFolderDepth(_contextMenuTarget.FullPath) < 4)
                {
                    <div class="menu-item" @onclick="ShowNewSubFolderInput">📁 新建子文件夹</div>
                }
                <div class="menu-divider"></div>
                <div class="menu-item" style="color: #ff4d4f;" @onclick="TryDeleteFolder">🗑️ 删除文件夹</div>
                <div class="menu-item" @onclick="ShowRenameFolderInput">✏️ 重命名</div>
            }
        </div>
    }

    @if (_showNoteContextMenu && _contextMenuNote != null)
    {
        <div class="custom-context-menu" style="left: @(_noteContextMenuX)px; top: @(_noteContextMenuY)px;" @onclick:stopPropagation="true">
            @if (_contextMenuNote.IsDeleted)
            {
                <div class="menu-item" @onclick="RestoreNoteContext">↩️ 恢复笔记</div>
                <div class="menu-divider"></div>
                <div class="menu-item" style="color: #ff4d4f;" @onclick="HardDeleteNoteContext">❌ 彻底删除</div>
            }
            else
            {
                <div class="menu-item" @onclick="ToggleFavoriteContext">@(_contextMenuNote.IsFavorite ? "⭐ 取消收藏" : "⭐ 收藏")</div>
                <div class="menu-item" @onclick="TogglePinContext">@(_contextMenuNote.IsPinned ? "📌 取消置顶" : "📌 置顶")</div>
                <div class="menu-item" @onclick="ToggleArchiveContext">@(_contextMenuNote.IsArchived ? "🗄️ 取消归档" : "🗄️ 归档")</div>
                <div class="menu-divider"></div>
                <div class="menu-item" @onclick="() => OpenFolderSelector(false)">📁 移动到...</div>
                <div class="menu-item" @onclick="() => OpenFolderSelector(true)">📄 复制到...</div>
                <div class="menu-divider"></div>
                <div class="menu-item" style="color: #ff4d4f;" @onclick="SoftDeleteNoteContext">🗑️ 移至回收站</div>
            }
        </div>
    }

    @if (_showFolderSelector)
    {
        <div class="modal-overlay" @onclick="CloseFolderSelector">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <span>@(_isCopyMode ? "复制到" : "移动到")</span>
                    <button class="icon-btn" @onclick="CloseFolderSelector">×</button>
                </div>
                <div class="modal-body">
                    <FolderTree Nodes="_folderTree"
                                SelectedFolder="@_targetFolder"
                                OnFolderSelected="(path) => _targetFolder = path" />
                </div>
                <div class="modal-footer">
                    <button class="btn-cancel" @onclick="CloseFolderSelector">取消</button>
                    <button class="btn-primary" disabled="@(string.IsNullOrEmpty(_targetFolder))" @onclick="ConfirmMoveOrCopy">确认</button>
                </div>
            </div>
        </div>
    }

    @if (_showFolderDeleteConfirm && _contextMenuTarget != null)
    {
        <div class="modal-overlay" @onclick="() => _showFolderDeleteConfirm = false">
            <div class="modal-content" style="width: 400px;" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <span style="font-weight: 600; color: #ff4d4f;">⚠️ 删除文件夹</span>
                    <button class="icon-btn" @onclick="() => _showFolderDeleteConfirm = false">×</button>
                </div>
                <div class="modal-body" style="padding: 20px 16px;">
                    <p style="margin: 0 0 12px 0; font-size: 14px; color: var(--nt-text-main);">
                        即将删除文件夹 <strong>@_contextMenuTarget.Name</strong>。
                    </p>
                    @if (_notesInFolderCount > 0)
                    {
                        <p style="margin: 0; font-size: 13px; color: var(--nt-text-gray);">
                            该文件夹包含 <strong>@_notesInFolderCount</strong> 篇笔记，你想如何处理这些笔记？
                        </p>
                    }
                    else
                    {
                        <p style="margin: 0; font-size: 13px; color: var(--nt-text-gray);">
                            该文件夹目前是空的，确定要删除吗？
                        </p>
                    }
                </div>
                <div class="modal-footer" style="flex-direction: column; gap: 8px; align-items: stretch; border-top: none; padding-top: 0;">
                    @if (_notesInFolderCount > 0)
                    {
                        <button class="btn-cancel" style="background: var(--nt-bg); border: 1px solid var(--nt-border); padding: 8px;" @onclick="() => ConfirmDeleteFolder(false)">
                            📁 保留笔记并移至未分类
                        </button>
                        <button class="btn-primary" style="background: #ff4d4f; color: white; border: none; padding: 8px;" @onclick="() => ConfirmDeleteFolder(true)">
                            🗑️ 连同笔记一起移至回收站
                        </button>
                    }
                    else
                    {
                        <button class="btn-primary" style="background: #ff4d4f; color: white; border: none; padding: 8px;" @onclick="() => ConfirmDeleteFolder(false)">
                            🗑️ 确认删除
                        </button>
                    }
                    <button class="btn-cancel" style="border: none; background: transparent; margin-top: 4px;" @onclick="() => _showFolderDeleteConfirm = false">取消</button>
                </div>
            </div>
        </div>
    }

    @if (_showWarningDialog)
    {
        <div class="modal-overlay" @onclick="() => _showWarningDialog = false">
            <div class="modal-content" style="width: 320px;" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <span style="font-weight: 600; color: #faad14;">⚠️ 提示</span>
                    <button class="icon-btn" @onclick="() => _showWarningDialog = false">×</button>
                </div>
                <div class="modal-body" style="padding: 20px 16px;">
                    <p style="margin: 0; font-size: 14px; color: var(--nt-text-main);">
                        @_warningMessage
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn-primary" style="background: #2eaadc; color: white; border: none; padding: 6px 16px;" @onclick="() => _showWarningDialog = false">我知道了</button>
                </div>
            </div>
        </div>
    }

    @if (_showTagManagerDialog)
    {
        <div class="modal-overlay" @onclick="() => _showTagManagerDialog = false">
            <div class="modal-content" style="width: 420px;" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <span style="font-weight: 600;">⚙️ 标签管理</span>
                    <button class="icon-btn" @onclick="() => _showTagManagerDialog = false">×</button>
                </div>
                <div class="modal-body" style="padding: 16px; max-height: 400px; overflow-y: auto;">
                    @if (_allUniqueTags.Count == 0)
                    {
                        <p style="color: var(--nt-text-gray); text-align: center; margin: 20px 0;">目前没有任何标签</p>
                    }
                    else
                    {
                        <ul style="list-style: none; padding: 0; margin: 0;">
                            @foreach (var tag in _allUniqueTags)
                            {
                                <li style="display: flex; justify-content: space-between; align-items: center; padding: 12px 8px; border-bottom: 1px solid var(--nt-border);">
                                    @if (_editingTag == tag)
                                    {
                                        <input @bind="_newTagName" style="flex: 1; margin-right: 12px; padding: 4px 8px; border: 1px solid #2eaadc; border-radius: 4px; outline: none;" placeholder="输入新标签名" />
                                        <div style="display: flex; gap: 8px;">
                                            <button class="btn-primary" style="padding: 4px 12px; font-size: 12px; border: none; border-radius: 4px; background: #2eaadc; color: white; cursor: pointer;" @onclick="ConfirmRenameTag">保存</button>
                                            <button class="btn-cancel" style="padding: 4px 12px; font-size: 12px; border: 1px solid var(--nt-border); border-radius: 4px; background: transparent; cursor: pointer;" @onclick="CancelEditTag">取消</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--nt-text-main); font-size: 14px;">
                                            <span style="color: var(--nt-text-gray); margin-right: 4px;">#</span>@tag
                                        </span>
                                        <div style="display: flex; gap: 8px;">
                                            <button class="icon-btn" style="cursor: pointer; opacity: 0.6;" title="重命名" @onclick="() => StartEditTag(tag)">✏️</button>
                                            <button class="icon-btn" style="color: #ff4d4f; cursor: pointer; opacity: 0.8;" title="全局删除" @onclick="() => ConfirmDeleteTag(tag)">🗑️</button>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }

    @if (_showTagDeleteConfirm)
    {
        <div class="modal-overlay" @onclick="() => _showTagDeleteConfirm = false">
            <div class="modal-content" style="width: 340px;" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <span style="font-weight: 600; color: #ff4d4f;">⚠️ 删除标签</span>
                    <button class="icon-btn" @onclick="() => _showTagDeleteConfirm = false">×</button>
                </div>
                <div class="modal-body" style="padding: 20px 16px;">
                    <p style="margin: 0 0 12px 0; font-size: 14px; color: var(--nt-text-main);">
                        确定要全局删除标签 <strong>#@_tagToDelete</strong> 吗？
                    </p>
                    <p style="margin: 0; font-size: 13px; color: var(--nt-text-gray);">
                        这会从所有关联的笔记中移除该标签，但不会删除笔记内容本身。
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn-cancel" style="background: transparent; border: 1px solid var(--nt-border); padding: 6px 16px; border-radius: 4px;" @onclick="() => _showTagDeleteConfirm = false">取消</button>
                    <button class="btn-primary" style="background: #ff4d4f; color: white; border: none; padding: 6px 16px; border-radius: 4px;" @onclick="ExecuteDeleteTag">确认删除</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<MonoNote> Notes = new();
    private string SelectedNoteId = string.Empty;
    private string _searchQuery = string.Empty;
    private string _currentNav = "all";
    private MonoNote? SelectedNote => Notes.FirstOrDefault(n => n.Id == SelectedNoteId);

    private List<FolderTree.FolderNode> _folderTree = new();
    private string _selectedFolderPath = "notes";

    // === 🌟 右键菜单状态 ===
    private bool _showContextMenu = false;
    private double _contextMenuX = 0;
    private double _contextMenuY = 0;
    private FolderTree.FolderNode? _contextMenuTarget;

    // === 🌟 统一输入框状态 ===
    private bool _showFolderInput = false;
    private string _folderInputValue = string.Empty;
    private string _folderInputPlaceholder = string.Empty;
    private int _folderActionType = 0; // 0:主文件夹, 1:子文件夹, 2:重命名

    // === 🌟 标签系统状态 ===
    private string _selectedTag = string.Empty;
    private string _newTagInput = string.Empty;

    // === 🌟 笔记右键菜单与弹窗状态 ===
    private bool _showNoteContextMenu = false;
    private double _noteContextMenuX = 0;
    private double _noteContextMenuY = 0;
    private MonoNote? _contextMenuNote;

    private bool _showFolderSelector = false;
    private bool _isCopyMode = false;
    private string _targetFolder = string.Empty;

    // 🌟 新增：收藏视图激活状态
    private bool _isFavoriteFilterActive = false;
    // 🌟 新增：归档视图激活状态
    private bool _isArchiveFilterActive = false;
    // 🌟 新增：回收站视图激活状态
    private bool _isTrashFilterActive = false;

    // === 🌟 文件夹删除功能状态 ===
    private bool _showFolderDeleteConfirm = false;
    private int _notesInFolderCount = 0;

    // === 🌟 通用警告弹窗状态 ===
    private bool _showWarningDialog = false;
    private string _warningMessage = string.Empty;

    // === 🌟 核心修改 3：标签管理状态与逻辑 ===
    private bool _showTagManagerDialog = false;
    private List<string> _allUniqueTags = new();
    private string _editingTag = string.Empty;
    private string _newTagName = string.Empty;

    // === 在标签管理状态下，新增删除确认相关的变量 ===
    private bool _showTagDeleteConfirm = false;
    private string _tagToDelete = string.Empty;

    // === 🌟 多标签页管理状态 ===
    private List<string> _openTabs = new();

    private void ShowTrash()
    {
        _isTrashFilterActive = true;
        _isArchiveFilterActive = false;
        _isFavoriteFilterActive = false;
        _selectedFolderPath = string.Empty;
        _selectedTag = string.Empty;
        SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
        StateHasChanged(); // 强制刷新 UI
    }

    // 动态计算系统中所有的唯一标签，并按字母排序
    private List<string> AllTags => Notes
      .Where(n => !n.IsDeleted && n.Tags != null)
        .SelectMany(n => n.Tags)
        .Distinct()
        .OrderBy(t => t)
        .ToList();

    // 🌟 激活收藏视图
    private void ShowFavorites()
    {
        _isFavoriteFilterActive = true;
        _isArchiveFilterActive = false;
        _isTrashFilterActive = false;

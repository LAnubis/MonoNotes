        string tag = _tagToDelete;

        await NoteRepository.DeleteTagGlobalAsync(tag);
        var allNotes = await NoteRepository.GetAllNotesAsync();
        foreach (var idx in IndexItems.Where(n => n.Tags != null && n.Tags.Contains(tag)).ToList())
        {
            idx.Tags.Remove(tag);
            IndexService.UpsertItem(idx);

            var bookNote = allNotes.FirstOrDefault(n => n.Id == idx.Id);
            if (bookNote != null && bookNote.Tags != null)
            {
                bookNote.Tags.Remove(tag);
                await NoteRepository.SaveNoteAsync(bookNote);
            }
        }

        _allTagsWithCount = GetTagFrequencies(); // 刷新列表
        if (_activeTags.Contains(tag))
        {
            _activeTags.Remove(tag);
        }

        _showTagDeleteConfirm = false;
        _tagToDelete = string.Empty;
        StateHasChanged();
    }

    // 🌟 核心修改 3：支持按需加载的标签页打开方法
    private async Task<bool> OpenInTabAsync(string id)
    {
        if (string.IsNullOrEmpty(id)) return false;
        if (!_openTabs.Contains(id))
        {
            if (_openTabs.Count >= 7)
            {
                _warningMessage = "最多只能同时打开 7 个标签页，请先关闭一些不常用的笔记。";
                _showWarningDialog = true;
                return false;
            }
            _openTabs.Add(id);
        }

        // 确保打开的内容已经被放入正文缓存中
        if (!_openNotesCache.Any(n => n.Id == id))
        {
            // 通过获取全局列表拉取单篇笔记（如果仓储有 GetNoteAsync，可以后续优化为只读单文件）
            var allNotes = await NoteRepository.GetAllNotesAsync();
            var targetNote = allNotes.FirstOrDefault(n => n.Id == id);
            if (targetNote != null) _openNotesCache.Add(targetNote);
        }

        return true;
    }

    private void CloseTab(string id)
    {
        int index = _openTabs.IndexOf(id);
        if (index == -1) return;

        _openTabs.RemoveAt(index);

        // 🌟 关闭标签页时，及时释放内存！
        _openNotesCache.RemoveAll(n => n.Id == id);
        if (SelectedNoteId == id)
        {
            if (_openTabs.Count > 0)
            {
                int newIndex = index > 0 ?
                index - 1 : 0;
                SelectedNoteId = _openTabs[newIndex];
            }
            else
            {
                SelectedNoteId = string.Empty;
            }
        }
    }


    private async Task BatchHardDelete()
    {
        if (_isSyncingUI)
        {
            _warningMessage = "后台正在与云端同步数据，为防复活，请等待同步完成后再执行彻底删除。";
            _showWarningDialog = true;
            return;
        }

        int failCount = 0;

        // 🌟 探测云端是否在线
        bool isConnected = await IsWebDavReadyAsync();

        var idsToProcess = _selectedNoteIds.ToList();

        foreach (var id in idsToProcess)
        {
            var item = IndexItems.FirstOrDefault(n => n.Id == id);
            if (item != null)
            {
                bool cloudDeleted = isConnected && await SafeCloudDeleteAsync(item.Folder, item.Id);

                if (cloudDeleted || !isConnected)
                {
                    await NoteRepository.DeleteNoteAsync(id);
                    IndexItems.RemoveAll(n => n.Id == id);
                    IndexService.RemoveItem(id);
                    CloseTab(id);
                }
                else
                {
                    failCount++;
                }
            }
        }

        _selectedNoteIds.Clear();
        SelectedNoteId = string.Empty;

        if (failCount > 0)
        {
            _warningMessage = $"批量删除完毕。有 {failCount} 篇笔记云端无响应。\n\n为防同步复活，本地副本已强行保留，请稍后再试。";
            _showWarningDialog = true;
        }

        StateHasChanged();
    }

    private async Task ExecuteEmptyTrash()
    {
        // 🌟 并发锁：如果在同步，绝对不准删！
        if (_isSyncingUI)
        {
            _warningMessage = "后台正在与云端同步数据，为防止文件混乱复活，请等待右上方同步动画停止后再清空回收站。";
            _showWarningDialog = true;
            _showEmptyTrashConfirm = false;
            return;
        }

        var trashItems = IndexItems.Where(n => n.IsDeleted).ToList();
        int successCount = 0;
        int failCount = 0;

        bool isConnected = await IsWebDavReadyAsync();
        _saveStatus = isConnected ? "正在清理云端..." : "正在清理本地...";
        //_saveStatus = "正在清理云端...";
        await InvokeAsync(StateHasChanged);

        foreach (var item in trashItems)
        {
            bool cloudDeleted = isConnected && await SafeCloudDeleteAsync(item.Folder, item.Id);

            // 🌟 只有云端真删掉了，才允许删本地
            if (cloudDeleted || !isConnected)
            {
                await NoteRepository.DeleteNoteAsync(item.Id);
                IndexItems.RemoveAll(n => n.Id == item.Id);
                IndexService.RemoveItem(item.Id);
                CloseTab(item.Id);
                successCount++;
            }
            else
            {
                failCount++;
            }
        }

        _selectedNoteIds.Clear();
        SelectedNoteId = string.Empty;
        _showEmptyTrashConfirm = false;

        if (failCount > 0)
        {
            _warningMessage = $"清空完毕。成功 {successCount} 篇，失败 {failCount} 篇。\n\n失败的文件已被云端拒绝删除，为防止同步再次将其复活，已强行保留在回收站内。请稍后再试。";
            _showWarningDialog = true;
            _saveStatus = "清理完成(有失败)";
        }
        else
        {
            _saveStatus = "回收站已清空";
        }

        StateHasChanged();
    }


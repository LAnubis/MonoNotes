    private async Task ConfirmMoveOrCopy()
    {
        if (string.IsNullOrEmpty(_targetFolder)) return;
        var allNotes = await NoteRepository.GetAllNotesAsync();
        // 如果是批量，取 Set 里的所有 ID；如果是单选右键，取当前右键菜单的 Note Id
        var targetIds = _isBatchOperation ?
        _selectedNoteIds.ToList() : new List<string> { _contextMenuNote?.Id ?? "" };

        foreach (var tId in targetIds)
        {
            if (string.IsNullOrEmpty(tId)) continue;
            var realNote = allNotes.FirstOrDefault(n => n.Id == tId);
            var idxNote = IndexItems.FirstOrDefault(n => n.Id == tId);
            if (realNote == null || idxNote == null) continue;

            if (_isCopyMode)
            {
                var newNote = new MonoNote
                {
                    Id = Guid.NewGuid().ToString("N"),

                    Title = realNote.Title + " - 副本",
                    Content = realNote.Content,
                    Folder = _targetFolder,
                    UpdatedAt = DateTimeOffset.Now,
                    Tags = realNote.Tags?.ToList() ??
                    new List<string>()
                };
                var newIdx = new NoteIndexItem { Id = newNote.Id, Title = newNote.Title, Folder = newNote.Folder, UpdatedAt = newNote.UpdatedAt, CreatedAt = newNote.UpdatedAt, Tags = newNote.Tags };
                IndexItems.Insert(0, newIdx);
                IndexService.UpsertItem(newIdx);
                await NoteRepository.SaveNoteAsync(newNote);
            }
            else
            {
                idxNote.Folder = _targetFolder;
                IndexService.UpsertItem(idxNote);
                realNote.Folder = _targetFolder;
                await NoteRepository.SaveNoteAsync(realNote);
                CloseTab(tId);
            }
        }

        _showFolderSelector = false;
        if (_isBatchOperation)
        {
            _selectedNoteIds.Clear();
            SelectedNoteId = string.Empty;
        }
        StateHasChanged();
    }


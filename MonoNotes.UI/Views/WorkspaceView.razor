    private async Task DeleteTemplate(string id)
    {
        if (_isSyncingUI)
        {
            if (NativeDialog != null) await NativeDialog.ShowAlertAsync("⚠️ 正在同步", "后台正在与云端同步数据，请等待右上角图标停止旋转后再删除模板。", "我知道了");
            return;
        }

        // 🌟 探测云端是否在线
        bool isConnected = await IsWebDavReadyAsync();
        bool cloudDeleted = false;

        if (isConnected)
        {
            string remotePath = $"MonoNotes/{NoteRepository.CurrentWorkspace}/.templates/{id}.md";
            cloudDeleted = await WebDavService.DeleteItemAsync(remotePath);

            if (!cloudDeleted)
            {
                await Task.Delay(1000);
                cloudDeleted = await WebDavService.DeleteItemAsync(remotePath);
            }
        }

        if (cloudDeleted || !isConnected)
        {
            await NoteRepository.DeleteTemplateAsync(id);
            _manageTemplatesList = await NoteRepository.GetAllTemplatesAsync();
            StateHasChanged();

            if (NativeDialog != null) await NativeDialog.ShowAlertAsync("🗑️ 删除成功", "该模板已被彻底移除。", "好的");
        }
        else
        {
            if (NativeDialog != null) await NativeDialog.ShowAlertAsync("❌ 删除失败", "云端拒绝删除，为防再次复活，已终止本地删除。请稍后再试。", "我知道了");
        }
    }

    // 🌟 终极防线 1：路径净化器（抹平 Windows 和 Mac 的路径差异，防止云端 404）
    private string GetRemoteNotePath(string folder, string id)
    {
        string normalizedFolder = string.IsNullOrWhiteSpace(folder) ? "notes" : folder.Replace('\\', '/').Trim('/');
        return $"MonoNotes/{NoteRepository.CurrentWorkspace}/{normalizedFolder}/{id}.md";
    }

    // 🌟 终极防线 2：带限流突破的安全云删除助手
    private async Task<bool> SafeCloudDeleteAsync(string folder, string id)
    {
        string remotePath = GetRemoteNotePath(folder, id);
        bool cloudDeleted = await WebDavService.DeleteItemAsync(remotePath);

        if (!cloudDeleted)
        {
            // 如果触发了坚果云频繁请求限制，强制冷静 1000 毫秒后重试！
            await Task.Delay(1000);
            cloudDeleted = await WebDavService.DeleteItemAsync(remotePath);
        }
        return cloudDeleted;
    }

    // ==========================================
    // 🌟 全局网络静默安全拦截器
    // ==========================================
    private async Task<bool> IsWebDavReadyAsync()
    {
        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            if (!settings.EnableWebDavSync) return false;
            return await WebDavService.TestConnectionAsync();
        }
        catch
        {
            // 没配账号、断网、密码错... 统统安静地返回 false，让本地删除继续走墓碑机制
            return false;
        }
    }

    // === 🌟 离线优先：全新精准同步系统状态 ===
    private bool _showSyncModal = false;
    private int _syncState = 0; // 0: 询问确认, 1: 进度条中, 2: 结果展示
    private int _pendingSyncCount = 0;
    private int _syncCurrent = 0;
    private int _syncTotal = 0;
    private string _syncMessage = string.Empty;

    // 当用户点击侧边栏的同步按钮时，调用此方法
    private async Task TriggerBackgroundSync(bool isManual = false)
    {
        if (_isSyncingUI) return;

        var settings = await SettingsService.GetSettingsAsync();
        if (!isManual && !settings.EnableWebDavSync) return;

        try
        {
            // 1. 瞬间探测本地账本
            _pendingSyncCount = await SyncService.GetPendingSyncCountAsync(NoteRepository.CurrentWorkspace);

            if (_pendingSyncCount > 0)
            {
                if (isManual)
                {
                    _syncState = 0;
                    _showSyncModal = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
            else if (isManual)
            {
                _syncState = 1;
                _syncTotal = 1;
                _syncCurrent = 0;
                _syncMessage = "本地已是最新，正在检查云端变动...";
                _showSyncModal = true;
                await InvokeAsync(StateHasChanged);

                await SyncService.SyncAsync(isLocalChanged: false);

                _syncState = 2;
                _syncMessage = SyncService.HasConflictsInLastSync ? "已拉取云端数据，并生成了冲突副本。" : "云端与本地均已是最新状态。";
            }
        }
        catch (Exception ex)
        {
            // 🌟 拦截探测期间的网络异常
            _syncState = 2;
            _showSyncModal = true;
            _syncMessage = ex.Message.Contains("ServiceUnavailable") || ex.Message.Contains("503")
                ? "❌ 网盘接口防刷限流已触发，请等待 3-5 分钟后再试。"
                : $"❌ 连接失败: {ex.Message}";
        }
        finally
        {
            var rawFolders = await NoteRepository.GetAllFoldersAsync();
            BuildFolderTree(rawFolders);
            await InvokeAsync(StateHasChanged);
        }
    }

    // 用户在弹窗点击“立即同步”后触发
    private async Task StartPushSyncAsync()
    {
        _syncState = 1; // 切换到进度条视图
        _isSyncingUI = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // 🌟 呼叫底层引擎：精确推送，并接收实时进度回调！
            await SyncService.PushLocalChangesAsync(NoteRepository.CurrentWorkspace, (current, total, msg) =>
            {
                _syncCurrent = current;
                _syncTotal = total;
                _syncMessage = msg;
                InvokeAsync(StateHasChanged);
            });

            _syncMessage = "本地推送完成，正在拉取云端变动...";
            await InvokeAsync(StateHasChanged);

            await SyncService.SyncAsync(isLocalChanged: true);

            if (SyncService.HasConflictsInLastSync)
            {
                _syncMessage = "同步完成，但发现多端修改了同一文件，已为您生成冲突副本。";
            }
            else
            {
                _syncMessage = "所有数据已成功与云端保持同步！";
            }
            _syncState = 2; // 切换到完成视图
        }
        catch (Exception ex)
        {
            // 🌟 拦截同步期间的崩溃，把 503 变成优雅的错误提示
            _syncState = 2;
            if (ex.Message.Contains("ServiceUnavailable") || ex.Message.Contains("503"))
            {
                _syncMessage = "❌ 网盘接口防刷限流已触发，请等待 3-5 分钟后账号解封再试。";
            }
            else
            {
                _syncMessage = $"❌ 同步中止: {ex.Message}";
            }
        }
        finally
        {
            _isSyncingUI = false;
            var rawFolders = await NoteRepository.GetAllFoldersAsync();
            BuildFolderTree(rawFolders);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseSyncModal()
    {
        if (_syncState == 1) return; // 进度条读条中，禁止乱点关闭！
        _showSyncModal = false;
        StateHasChanged();
    }

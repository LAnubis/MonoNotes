    private async Task HandleFolderInputKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_folderInputValue))
        {
            var val = _folderInputValue.Trim();
            if (_folderActionType == 0)
            {
                await NoteRepository.CreateFolderAsync("", val);
            }
            else if (_folderActionType == 1 && _contextMenuTarget != null)
            {
                await NoteRepository.CreateFolderAsync(_contextMenuTarget.FullPath, val);
            }
            else if (_folderActionType == 2 && _contextMenuTarget != null)
            {
                await NoteRepository.RenameFolderAsync(_contextMenuTarget.FullPath, val);
            }

            _showFolderInput = false;

            // 🌟 修复 1：重新拉取最新的文件夹结构并构建树
            var rawFolders = await NoteRepository.GetAllFoldersAsync();
            BuildFolderTree(rawFolders);

            // 🌟 修复 2：重新拉取所有笔记！(确保内存中的 Note.Folder 属性是最新的)
            Notes = await NoteRepository.GetAllNotesAsync();

            // 🌟 修复 3：如果是重命名，自动计算新路径，并让左侧菜单重新选中它
            if (_folderActionType == 2 && _contextMenuTarget != null)
            {
                // 计算父级路径
                var parentPath = _contextMenuTarget.FullPath.Contains('/')
                    ? _contextMenuTarget.FullPath.Substring(0, _contextMenuTarget.FullPath.LastIndexOf('/'))
                    : "";

                // 拼接出重命名后的新路径
                _selectedFolderPath = string.IsNullOrEmpty(parentPath) ? val : $"{parentPath}/{val}";

                // 默认选中该文件夹下的第一篇笔记
                SelectedNoteId = FilteredNotes.FirstOrDefault()?.Id ?? string.Empty;
            }

            StateHasChanged();
        }
        else if (e.Key == "Escape")
        {
            _showFolderInput = false;
        }
    }


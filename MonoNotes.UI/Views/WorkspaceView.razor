    // 🌟 提取 Markdown 正文中的所有双向链接（匹配新版书名号语法）
    private List<string> ExtractOutgoingLinks(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return new List<string>();
        var links = new HashSet<string>();

        // 🌟 匹配最新的格式: 《《笔记标题》》
        var regex = new System.Text.RegularExpressions.Regex(@"《《(.*?)》》");
        foreach (System.Text.RegularExpressions.Match match in regex.Matches(content))
        {
            var title = match.Groups[1].Value.Trim();
            if (!string.IsNullOrEmpty(title))
            {
                links.Add(title);
            }
        }

        // 兼容旧的纯文本格式: [[笔记标题]] (可选，如果不需要兼容以前的笔记可以删掉这块)
        var regexOld = new System.Text.RegularExpressions.Regex(@"\[\[(.*?)\]\]");
        foreach (System.Text.RegularExpressions.Match match in regexOld.Matches(content))
        {
            var title = match.Groups[1].Value.Trim();
            if (!string.IsNullOrEmpty(title)) links.Add(title);
        }

        return links.ToList();
    }

    // 🌟 自制大纲的模型与提取引擎
    public class HeadingInfo
    {
        public int Level
        {
            get; set;
        }
        public string Text { get; set; } = string.Empty;
    }

    private List<HeadingInfo> ExtractHeadings(string content)
    {
        var list = new List<HeadingInfo>();
        if (string.IsNullOrWhiteSpace(content)) return list;

        var lines = content.Split('\n');
        bool isInCodeBlock = false;
        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            // 避开代码块里的注释
            if (trimmed.StartsWith("```"))
            {
                isInCodeBlock = !isInCodeBlock;
                continue;
            }

            if (!isInCodeBlock && trimmed.StartsWith("#"))
            {
                var level = trimmed.TakeWhile(c => c == '#').Count();
                // 确保是一个合法的标题格式（# 后面必须跟一个空格）
                if (level > 0 && level <= 6 && trimmed.Length > level && trimmed[level] == ' ')
                {
                    var text = trimmed.Substring(level).Trim();
                    if (!string.IsNullOrEmpty(text))
                    {
                        list.Add(new HeadingInfo { Level = level, Text = text });
                    }
                }
            }
        }
        return list;
    }


                                <div style="display: flex; gap: 8px;">
                                    <button class="btn-cancel" style="padding: 4px 8px; font-size: 12px; border: 1px solid var(--nt-border);" @onclick="() => ResolveConflict(conflictPath, true)">采纳本地</button>
                                    <button class="btn-primary" style="padding: 4px 8px; font-size: 12px; background: #2eaadc; color: white; border: none; border-radius: 4px;" @onclick="() => ResolveConflict(conflictPath, false)">采纳云端</button>
                                </div>

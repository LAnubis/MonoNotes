    private async Task TryDeleteFolder()
    {
        if (_contextMenuTarget == null || _contextMenuTarget.FullPath == "notes") return;

        // 1. 拦截包含子文件夹的情况
        if (_contextMenuTarget.Children.Any())
        {
            // 🌟 修复：不再使用丑陋的 alert，而是调用漂亮的居中弹窗
            _warningMessage = "该文件夹下包含子文件夹，请先删除底层的子文件夹。";
            _showWarningDialog = true;
            CloseContextMenu();
            return;
        }

        // 2. 统计笔记数量 (不包含已经在回收站的)
        _notesInFolderCount = Notes.Count(n => n.Folder == _contextMenuTarget.FullPath && !n.IsDeleted);

        // 3. 弹出选项 A 确认框
        _showFolderDeleteConfirm = true;
        CloseContextMenu();
    }

    private async Task ConfirmDeleteFolder(bool moveNotesToTrash)
    {
        if (_contextMenuTarget == null) return;

        // 1. 调用底层物理删除与转移
        await NoteRepository.DeleteFolderAsync(_contextMenuTarget.FullPath, moveNotesToTrash);

        foreach (var note in Notes.Where(n => n.Folder == _contextMenuTarget.FullPath))
        {
            note.Folder = "notes";
            if (moveNotesToTrash)
            {
                note.IsDeleted = true;
                CloseTab(note.Id); // 🌟 核心修复：如果删除了文件夹连带笔记，必须清理幽灵 Tab
            }
        }

        // 3. 重新刷新左侧文件夹树
        var rawFolders = await NoteRepository.GetAllFoldersAsync();
        BuildFolderTree(rawFolders);

        // 4. 如果被删的文件夹正好是当前选中的，跳回“未分类”
        if (_selectedFolderPath == _contextMenuTarget.FullPath)
        {
            _selectedFolderPath = "notes";
            RefreshSelection();
        }

        _showFolderDeleteConfirm = false;
        StateHasChanged();
    }


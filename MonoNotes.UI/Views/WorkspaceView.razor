    private void BuildFolderTree(List<string> rawPaths)
    {
        _folderTree.Clear();
        foreach (var path in rawPaths)
        {
            var parts = path.Split('/');
            var currentLevel = _folderTree;
            string currentFullPath = "";

            for (int i = 0; i < parts.Length; i++)
            {
                var part = parts[i];
                currentFullPath = string.IsNullOrEmpty(currentFullPath) ? part : $"{currentFullPath}/{part}";

                var existingNode = currentLevel.FirstOrDefault(n => n.FullPath == currentFullPath);
                if (existingNode == null)
                {
                    existingNode = new FolderTree.FolderNode
                    {
                        Name = currentFullPath == "notes" ? "未分类" : part,
                        FullPath = currentFullPath,
                        IsExpanded = i == 0
                    };
                    currentLevel.Add(existingNode);
                }
                currentLevel = existingNode.Children;
            }
        }

        _folderTree = _folderTree
            .OrderByDescending(n => n.FullPath == "notes")
            .ThenBy(n => n.Name)
            .ToList();
    }

    private Timer _autoSaveTimer = new Timer(1000) { AutoReset = false };
    private string _saveStatus = "已保存";

    // 🌟 完全适配 JSON 索引的极速过滤属性
    private IEnumerable<NoteIndexItem> FilteredNotes
    {
        get
        {
            IEnumerable<NoteIndexItem> result = IndexItems;

            if (_isTrashFilterActive) { result = result.Where(n => n.IsDeleted); }
            else
            {
                result = result.Where(n => !n.IsDeleted);
                if (_isArchiveFilterActive) { result = result.Where(n => n.IsArchived); }
                else
                {
                    result = result.Where(n => !n.IsArchived);
                    if (_isFavoriteFilterActive) { result = result.Where(n => n.IsFavorite); }
                    else if (!string.IsNullOrEmpty(_selectedFolderPath)) { result = result.Where(n => n.Folder == _selectedFolderPath); }
                    else if (!string.IsNullOrEmpty(_selectedTag)) { result = result.Where(n => n.Tags != null && n.Tags.Contains(_selectedTag)); }
                }
            }

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var query = _searchQuery.ToLower().Trim();
                result = result.Where(n => (n.Title?.ToLower().Contains(query) ?? false) ||
                                           (n.Tags != null && n.Tags.Any(t => t.ToLower().Contains(query))));
            }

            var orderedResult = result.OrderByDescending(n => n.IsPinned);

            switch (_sortMode)
            {
                case 0: return orderedResult.ThenByDescending(n => n.UpdatedAt);
                case 1: return orderedResult.ThenBy(n => n.UpdatedAt);
                case 2: return orderedResult.ThenBy(n => n.Title ?? "");
                case 3: return orderedResult.ThenByDescending(n => n.Title ?? "");
                default: return orderedResult.ThenByDescending(n => n.UpdatedAt);
            }
        }
    }


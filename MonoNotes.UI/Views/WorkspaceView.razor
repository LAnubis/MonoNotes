    private async Task ConfirmCreateNote()
    {
        // 🌟 1. 动态确定目标文件夹
        // 逻辑：如果当前选中的是物理文件夹（且不是特殊视图），则使用该路径；否则默认为 "notes"
        string targetFolder = (!string.IsNullOrWhiteSpace(_selectedFolderPath) &&
                              !_isFavoriteFilterActive && !_isArchiveFilterActive && !_isTrashFilterActive)
                              ? _selectedFolderPath
                              : "notes";

        var newNote = new MonoNote
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = _selectedTemplate == null ? "无标题笔记" : _selectedTemplate.Title.Replace(" 模板", ""),
            Content = _selectedTemplate?.Content ?? "",
            Folder = targetFolder, // 🌟 关键：使用动态路径
            CreatedAt = DateTimeOffset.Now,
            UpdatedAt = DateTimeOffset.Now
        };

        // 2. 保存物理文件
        // NoteRepository 内部应使用 PathHelper.GetWorkspacesDirectory()
        await NoteRepository.SaveNoteAsync(newNote);

        // 3. 更新内存索引
        var indexItem = new NoteIndexItem
        {
            Id = newNote.Id,
            Title = newNote.Title,
            Folder = newNote.Folder, // 🌟 同步更新索引中的文件夹归属
            UpdatedAt = newNote.UpdatedAt,
            CreatedAt = newNote.CreatedAt
        };
        IndexItems.Insert(0, indexItem);
        IndexService.UpsertItem(indexItem);

        // 4. 打开笔记 Tab
        _openNotesCache.Add(newNote);
        SelectedNoteId = newNote.Id;
        await OpenInTabAsync(newNote.Id);

        CloseNewNoteModal();

        // 5. 刷新树结构
        var rawFolders = await NoteRepository.GetAllFoldersAsync();
        BuildFolderTree(rawFolders);

        await InvokeAsync(StateHasChanged);
    }


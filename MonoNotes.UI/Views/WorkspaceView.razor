    private async Task ConfirmDeleteFolder(bool moveNotesToTrash)
    {
        if (_contextMenuTarget == null) return;

        if (_isSyncingUI)
        {
            _warningMessage = "后台正在与云端同步数据，请等待同步完成后再删除文件夹。";
            _showWarningDialog = true;
            _showFolderDeleteConfirm = false;
            return;
        }

        // 🌟 探测云端是否在线
        bool isConnected = await IsWebDavReadyAsync();
        if (isConnected)
        {
            string normalizedPath = _contextMenuTarget.FullPath.Replace('\\', '/').Trim('/');
            string remotePath = $"MonoNotes/{NoteRepository.CurrentWorkspace}/{normalizedPath}";

            bool cloudDeleted = await WebDavService.DeleteItemAsync(remotePath);
            if (!cloudDeleted)
            {
                _warningMessage = "本地文件夹已删除，但云端数据销毁失败（可能是网络波动或授权过期）。这可能会导致它在下次同步时复活，建议稍后去云端手动清理。";
                _showWarningDialog = true;
            }
        }

        // 2. 云端处理完（或离线）后，再执行本地删除
        await NoteRepository.DeleteFolderAsync(_contextMenuTarget.FullPath, moveNotesToTrash);
        var allNotes = await NoteRepository.GetAllNotesAsync();

        foreach (var idx in IndexItems.Where(n => n.Folder == _contextMenuTarget.FullPath).ToList())
        {
            idx.Folder = "notes";
            if (moveNotesToTrash) { idx.IsDeleted = true; CloseTab(idx.Id); }
            IndexService.UpsertItem(idx);
            var realNote = allNotes.FirstOrDefault(n => n.Id == idx.Id);
            if (realNote != null)
            {
                realNote.Folder = "notes";
                if (moveNotesToTrash) realNote.IsDeleted = true;
                await NoteRepository.SaveNoteAsync(realNote);
            }
        }

        var rawFolders = await NoteRepository.GetAllFoldersAsync();
        BuildFolderTree(rawFolders);

        if (_selectedFolderPath == _contextMenuTarget.FullPath)
        {
            _selectedFolderPath = "notes";
            RefreshSelection();
        }

        _showFolderDeleteConfirm = false;

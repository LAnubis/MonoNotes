                    </div>
                    <div style="flex: 1; overflow-y: auto; border: 1px solid var(--nt-border); border-radius: 6px;">
                        @foreach (var conflictPath in _conflictFiles)
                        {
                            var cName = Path.GetFileName(conflictPath);
                            var oName = System.Text.RegularExpressions.Regex.Replace(cName, @"\s\(冲突副本.*?\)", "");

                            <div style="padding: 12px; border-bottom: 1px solid var(--nt-border); display: flex; justify-content: space-between; align-items: center;">

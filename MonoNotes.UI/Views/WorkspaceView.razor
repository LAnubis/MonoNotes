    private void OnNoteChanged()
    {
        _saveStatus = "正在保存...";
        // 🌟 修复2：实现“所见即所得”的实时双向绑定
        // 在打字的瞬间，同步更新左侧列表的索引数据，打破 1 秒的保存延迟
        if (SelectedNote != null)
        {
            var idx = IndexItems.FirstOrDefault(i => i.Id == SelectedNote.Id);
            if (idx != null && idx.Title != SelectedNote.Title)
            {
                idx.Title = SelectedNote.Title;
            }
        }

        _autoSaveTimer.Stop(); _autoSaveTimer.Start();
        StateHasChanged();
    }

    private async Task PerformSaveAsync()
    {
        if (SelectedNote != null)
        {
            // 🌟 战役四：在保存前，扫描并更新这篇笔记外发的所有双链！
            SelectedNote.OutgoingLinks = ExtractOutgoingLinks(SelectedNote.Content);
            // 1. 保存到本地磁盘
            await NoteRepository.SaveNoteAsync(SelectedNote);
            // 🌟 2. 核心补丁：同步修改 JSON 缓存引擎中的数据
            var indexItem = IndexItems.FirstOrDefault(i => i.Id == SelectedNote.Id);
            if (indexItem != null)
            {
                indexItem.Title = SelectedNote.Title;
                indexItem.Folder = SelectedNote.Folder;
                indexItem.UpdatedAt = SelectedNote.UpdatedAt;
                indexItem.Tags = SelectedNote.Tags ?? new List<string>();
                indexItem.IsPinned = SelectedNote.IsPinned;
                indexItem.IsFavorite = SelectedNote.IsFavorite;
                indexItem.IsDeleted = SelectedNote.IsDeleted;
                indexItem.IsArchived = SelectedNote.IsArchived;

                // 🌟 核心：将关系网同步给内存索引引擎
                indexItem.OutgoingLinks = SelectedNote.OutgoingLinks;
                IndexService.UpsertItem(indexItem); // 触发防抖写入
            }

            _saveStatus = "已保存";
            await InvokeAsync(StateHasChanged);
            // 🌟 本地文件刚刚发生了修改，不等定时器了，立刻触发后台即时推送！
            _ = Task.Run(async () => await SyncService.SyncAsync(isLocalChanged: true));
        }
    }


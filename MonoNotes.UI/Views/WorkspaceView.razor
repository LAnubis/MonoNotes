                <div style="display: flex; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--nt-border);">
                    <span style="font-size: 20px; margin-right: 12px; opacity: 0.5;">🔍</span>
                    <input type="text" style="flex: 1; border: none; outline: none; font-size: 18px; background: transparent; color: var(--nt-text-main);"
                           placeholder="输入关键词搜索全局笔记..."
                           @bind="_superSearchQuery" @bind:event="oninput" @onkeyup="ExecuteSuperSearch" autofocus />
                    <button class="icon-btn" style="font-size: 12px; border: 1px solid var(--nt-border); padding: 4px 8px; border-radius: 6px;" @onclick="CloseSuperSearch">ESC</button>
                </div>

                <div style="max-height: 50vh; overflow-y: auto; padding: 8px;">
                    @if (!string.IsNullOrWhiteSpace(_superSearchQuery) && !_searchResults.Any())
                    {

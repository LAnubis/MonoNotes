    // === 🌟 核心修改 4：标签管理逻辑实现 ===
    private void OpenTagManager()
    {
        // 从当前内存中所有未删除的笔记中，实时提取唯一的标签列表
        _allUniqueTags = Notes
            .Where(n => !n.IsDeleted && n.Tags != null)
            .SelectMany(n => n.Tags)
            .Distinct()
            .OrderBy(t => t)
            .ToList();

        _showTagManagerDialog = true;
        CancelEditTag();
    }

    private void StartEditTag(string tag)
    {
        _editingTag = tag;
        _newTagName = tag;
    }

    private void CancelEditTag()
    {
        _editingTag = string.Empty;
        _newTagName = string.Empty;
    }

    private async Task ConfirmRenameTag()
    {
        if (string.IsNullOrWhiteSpace(_newTagName) || _newTagName == _editingTag)
        {
            CancelEditTag();
            return;
        }

        // 1. 调用仓储层更新物理文件
        await NoteRepository.RenameTagGlobalAsync(_editingTag, _newTagName);

        // 2. 更新内存数据，保证左侧菜单和当前编辑器瞬间同步
        foreach (var bookNote in Notes.Where(n => n.Tags != null && n.Tags.Contains(_editingTag)))
        {
            bookNote.Tags.Remove(_editingTag);
            if (!bookNote.Tags.Contains(_newTagName))
            {
                bookNote.Tags.Add(_newTagName);
            }
        }

        // 3. 刷新弹窗内部的标签列表，并退出编辑状态
        _allUniqueTags = _allUniqueTags.Select(t => t == _editingTag ? _newTagName : t).Distinct().OrderBy(t => t).ToList();
        CancelEditTag();
        StateHasChanged();
    }

    private void ConfirmDeleteTag(string tag)
    {
        _tagToDelete = tag;
        _showTagDeleteConfirm = true;
    }

    // 🌟 核心修改：用户在弹窗中点击“确认删除”后，实际执行的方法
    private async Task ExecuteDeleteTag()
    {
        if (string.IsNullOrWhiteSpace(_tagToDelete)) return;

        string tag = _tagToDelete;

        // 1. 调用仓储层物理删除
        await NoteRepository.DeleteTagGlobalAsync(tag);

        // 2. 清理内存中关联该标签的数据
        foreach (var bookNote in Notes.Where(n => n.Tags != null && n.Tags.Contains(tag)))
        {
            bookNote.Tags.Remove(tag);
        }

        // 3. 移出列表
        _allUniqueTags.Remove(tag);

        // 4. 如果删除的刚好是左侧正在被筛选的标签，清空筛选条件
        if (_selectedTag == tag)
        {
            _selectedTag = string.Empty;
        }

        // 5. 关掉弹窗，重置状态
        _showTagDeleteConfirm = false;
        _tagToDelete = string.Empty;
        StateHasChanged();
    }

    private bool OpenInTab(string id)
    {
        if (string.IsNullOrEmpty(id)) return false;

        if (!_openTabs.Contains(id))
        {
            // 如果还没打开，且已经满了 7 个，强行拦截！
            if (_openTabs.Count >= 7)
            {
                _warningMessage = "最多只能同时打开 7 个标签页，请先关闭一些不常用的笔记。";
                _showWarningDialog = true;
                return false; // 告诉调用者：打开失败
            }
            _openTabs.Add(id);
        }
        return true; // 成功打开，或者该笔记本来就在 Tab 里
    }

    private void CloseTab(string id)
    {
        int index = _openTabs.IndexOf(id);
        if (index == -1) return;

        _openTabs.RemoveAt(index);

        if (SelectedNoteId == id)
        {
            if (_openTabs.Count > 0)
            {
                int newIndex = index > 0 ? index - 1 : 0;
                SelectedNoteId = _openTabs[newIndex];
            }
            else
            {
                SelectedNoteId = string.Empty;
            }
        }
    }

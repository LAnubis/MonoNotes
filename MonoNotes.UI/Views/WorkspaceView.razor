            _isFavoriteFilterActive = false;
            _isArchiveFilterActive = false;
            _isTrashFilterActive = false;

            await SelectNote(existingNote.Id);
        }
        else
        {
            var newNote = new MonoNote
            {
                Id = Guid.NewGuid().ToString("N"),
                Title = todayStr,
                Content = $"# {todayStr}\n\n- [ ] ",
                UpdatedAt = DateTimeOffset.Now,
                Folder = dailyFolderName, // 🌟 绑定到中文文件夹
                Tags = new List<string>()
            };
            var idxItem = new NoteIndexItem { Id = newNote.Id, Title = newNote.Title, Folder = newNote.Folder, UpdatedAt = newNote.UpdatedAt, CreatedAt = newNote.UpdatedAt };
            IndexItems.Insert(0, idxItem);
            IndexService.UpsertItem(idxItem);
            _openNotesCache.Add(newNote);

            var rawFolders = await NoteRepository.GetAllFoldersAsync();
            if (!rawFolders.Any(f => f == dailyFolderName))
            {
                await NoteRepository.CreateFolderAsync("", dailyFolderName);
                rawFolders = await NoteRepository.GetAllFoldersAsync();
            }

            BuildFolderTree(rawFolders);

            _selectedFolderPath = dailyFolderName;
            if (_activeTags != null) _activeTags.Clear();

            SelectedNoteId = newNote.Id;
            _selectedNoteIds.Clear();
            _selectedNoteIds.Add(newNote.Id);

            await OpenInTabAsync(newNote.Id);
            await NoteRepository.SaveNoteAsync(newNote);
        }

        StateHasChanged();
    }



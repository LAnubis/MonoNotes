@using Microsoft.AspNetCore.Components.Web

<div class="folder-tree">
    @foreach (var node in Nodes)
    {
        <div class="folder-item">
            <div class="folder-header @(node.FullPath == SelectedFolder ? "selected" : "")"
                 @onclick="() => OnFolderClick(node)"
                 @oncontextmenu="(e) => OnFolderRightClick(e, node)"
                 @oncontextmenu:preventDefault="true">

                <div class="toggle-wrapper" @onclick:stopPropagation="true" @onclick="() => ToggleNode(node)">
                    @if (node.Children.Any())
                    {
                        <span class="toggle-icon @(node.IsExpanded ? "expanded" : "")">▸</span>
                    }
                </div>

                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="folder-icon">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                </svg>

                <span class="folder-name">@node.Name</span>
            </div>

            @if (node.IsExpanded && node.Children.Any())
            {
                <div class="folder-children">
                    <FolderTree Nodes="node.Children"
                                SelectedFolder="@SelectedFolder"
                                OnFolderSelected="OnFolderSelected"
                                OnContextMenu="OnContextMenu" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<FolderNode> Nodes { get; set; } = new List<FolderNode>();
    [Parameter] public string SelectedFolder { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnFolderSelected { get; set; }

    // 🌟 新增：对外暴露的右键事件
    [Parameter] public EventCallback<(MouseEventArgs, FolderNode)> OnContextMenu { get; set; }

    private void ToggleNode(FolderNode node)
    {
        if (node.Children.Any())
        {
            node.IsExpanded = !node.IsExpanded;
        }
    }

    private async Task OnFolderClick(FolderNode node)
    {
        await OnFolderSelected.InvokeAsync(node.FullPath);
        if (node.Children.Any() && !node.IsExpanded)
        {
            node.IsExpanded = true;
        }
    }

    // 🌟 处理右键点击
    private async Task OnFolderRightClick(MouseEventArgs e, FolderNode node)
    {
        if (OnContextMenu.HasDelegate)
        {
            await OnContextMenu.InvokeAsync((e, node));
        }
    }

    public class FolderNode
    {
        public string Name { get; set; } = string.Empty;
        public string FullPath { get; set; } = string.Empty;
        public bool IsExpanded { get; set; } = false;
        public List<FolderNode> Children { get; set; } = new();
    }
}
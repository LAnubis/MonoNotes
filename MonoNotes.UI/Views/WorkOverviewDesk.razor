@using MonoNotes.Core.Models
@using MonoNotes.Storage
@inject WriteSpaceRepository Repository

@code {
    [Parameter] public string CurrentWorkId { get; set; } = string.Empty;

    // 🌟 当用户点击“继续写作”或某一章时触发
    [Parameter] public EventCallback<string> OnEnterEditor { get; set; }

    // 🌟 新增：用于底部快捷入口的路由跳转
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    private WorkMeta? Meta;
    private WorkIndex? Index;

    private int TotalChapters = 0;
    private int TotalWordCount = 0;
    private int CreateDays = 1;
    private int TodayWordCount = 0; // 🌟 新增：今日战报

    private Chapter? LastChapter;
    private List<Chapter> RecentChapters = new();

    // 🌟 新增：真实的待填坑数据
    private List<ForeshadowItem> PendingForeshadows = new();

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(CurrentWorkId)) return;

        // 1. 加载元数据
        var allWorks = await Repository.GetAllWorksAsync();
        Meta = allWorks.FirstOrDefault(w => w.Id == CurrentWorkId);

        if (Meta != null)
        {
            CreateDays = (int)(DateTime.Now - Meta.CreatedAt).TotalDays;
            if (CreateDays < 1) CreateDays = 1;
        }

        // 2. 加载目录结构
        Index = await Repository.GetWorkIndexAsync(CurrentWorkId);
        if (Index != null)
        {
            var allChapters = Index.Volumes.SelectMany(v => v.Chapters).ToList();
            TotalChapters = allChapters.Count;
            TotalWordCount = allChapters.Sum(c => c.WordCount);

            if (allChapters.Any())
            {
                LastChapter = allChapters.Last();
                RecentChapters = allChapters.TakeLast(3).Reverse().ToList();
            }
        }

        // 3. 🌟 加载今日字数
        var stats = await Repository.GetDailyStatsAsync();
        string today = DateTime.Now.ToString("yyyy-MM-dd");
        if (stats.TryGetValue(today, out int count))
        {
            TodayWordCount = count;
        }

        // 4. 🌟 加载待填坑的伏笔 (取最近的 3 个警告作者)
        var allFs = await Repository.GetForeshadowsAsync(CurrentWorkId);
        PendingForeshadows = allFs.Where(f => !f.IsResolved).OrderByDescending(f => f.CreatedAt).Take(3).ToList();
    }

    private async Task ContinueWriting()
    {
        if (LastChapter != null)
            await OnEnterEditor.InvokeAsync(LastChapter.Id);
        else
            await OnEnterEditor.InvokeAsync(string.Empty);
    }
}

<div class="overview-container">
    @if (Meta == null)
    {
        <div class="loading-state">正在生成战术看板...</div>
    }
    else
    {
        <div class="hero-section">
            <div class="book-cover">
                @if (string.IsNullOrEmpty(Meta.CoverUrl))
                {
                    <span class="no-cover-icon">📖</span>
                }
                else
                {
                    <img src="@Meta.CoverUrl" alt="cover" />
                }
            </div>

            <div class="hero-info">
                <div class="title-row">
                    <h1 class="book-title">@Meta.Title</h1>
                    <span class="status-badge @(Meta.Status)">
                        @(Meta.Status switch { "serializing" => "连载中", "finished" => "已完结", "paused" => "暂停更新", _ => "构思草稿" })
                    </span>
                </div>

                <div class="tags-row">
                    @if (!string.IsNullOrWhiteSpace(Meta.Tags))
                    {
                        @foreach (var tag in Meta.Tags.Split(new[] { ',', '，' }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="book-tag"># @tag.Trim()</span>
                        }
                    }
                    else
                    {
                        <span class="book-tag" style="opacity: 0.5;"># 暂无标签</span>
                    }
                </div>

                <div class="synopsis-box">
                    @(string.IsNullOrWhiteSpace(Meta.Synopsis) ? "（在这个世界，写下你的第一个设定吧...）" : Meta.Synopsis)
                </div>

                <div class="hero-actions">
                    <button class="continue-btn" @onclick="ContinueWriting">
                        <span class="btn-icon">✍️</span> 继续写作
                        <span class="btn-sub">@(LastChapter != null ? "前往最新章" : "开启第一章")</span>
                    </button>
                    <button class="export-btn" title="开发中...">📤 编译导出</button>
                </div>
            </div>
        </div>

        <div class="dashboard-grid">

            <div class="grid-card data-panel">
                <h3 class="card-title">📊 本书进度</h3>
                <div class="stats-row">
                    <div class="stat-item highlight-stat">
                        <div class="stat-num">@TodayWordCount.ToString("N0")</div>
                        <div class="stat-lbl">今日战报 (字)</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-num">@TotalWordCount.ToString("N0")</div>
                        <div class="stat-lbl">累计字数</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-num">@TotalChapters</div>
                        <div class="stat-lbl">总章节</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-num">@CreateDays</div>
                        <div class="stat-lbl">创作天数</div>
                    </div>
                </div>

                <div class="todo-panel">
                    <h4 class="todo-title">💡 待回收的坑 <span class="todo-badge">@PendingForeshadows.Count</span></h4>
                    @if (PendingForeshadows.Any())
                    {
                        <div class="todo-list">
                            @foreach (var fs in PendingForeshadows)
                            {
                                <div class="todo-item" @onclick="@(() => OnNavigate.InvokeAsync("foreshadowing"))">
                                    <span class="todo-dot"></span>
                                    <span class="todo-text">@fs.Description</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="todo-empty">太棒了，目前没有任何遗留的坑！</div>
                    }
                </div>
            </div>

            <div class="grid-card recent-panel">
                <h3 class="card-title">🕒 最近编辑</h3>
                @if (RecentChapters.Any())
                {
                    <div class="recent-list">
                        @foreach (var chap in RecentChapters)
                        {
                            <div class="recent-item" @onclick="() => OnEnterEditor.InvokeAsync(chap.Id)">
                                <div class="chap-title">@chap.Title</div>
                                <div class="chap-words">@chap.WordCount 字</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="recent-empty">
                        <div style="font-size:32px; opacity:0.3; margin-bottom:10px;">📭</div>
                        目录空空如也<br>快去写下第一章吧！
                    </div>
                }
            </div>

            <div class="grid-card shortcuts-panel">
                <h3 class="card-title">🌌 核心工作区</h3>
                <div class="shortcuts-grid">
                    <div class="shortcut-btn" @onclick="@(() => OnNavigate.InvokeAsync("outline"))">
                        <span class="sc-icon">📜</span>
                        <span class="sc-text">故事大纲</span>
                    </div>
                    <div class="shortcut-btn" @onclick="@(() => OnNavigate.InvokeAsync("materials"))">
                        <span class="sc-icon">📚</span>
                        <span class="sc-text">万能设定</span>
                    </div>
                    <div class="shortcut-btn" @onclick="@(() => OnNavigate.InvokeAsync("foreshadowing"))">
                        <span class="sc-icon">💡</span>
                        <span class="sc-text">伏笔追踪</span>
                    </div>
                    <div class="shortcut-btn" @onclick="@(() => OnNavigate.InvokeAsync("details"))">
                        <span class="sc-icon">⚙️</span>
                        <span class="sc-text">作品档案</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@using MonoNotes.Core.Models
@using MonoNotes.Core.Interfaces
@using MonoNotes.Storage
@inject ISettingsService SettingsService
@inject IWebDavService WebDavService
@inject MonoNotes.UI.Services.VisualEngineService VisualEngine
@inject MonoNotes.Storage.LocalBackupService BackupService
@inject NavigationManager NavManager

<div class="global-settings-overlay" @onclick="CancelSettings">
    <div class="global-settings-content" @onclick:stopPropagation="true">

        <div class="settings-sidebar">
            <div class="sidebar-title">全局设置</div>

            <div class="settings-nav-item @(_settingsActiveTab == "sync" ? "active" : "")" @onclick="@(() => SwitchTab("sync"))">
                ☁️ 同步 (WebDAV)
            </div>

            <div class="settings-nav-item @(_settingsActiveTab == "backup" ? "active" : "")" @onclick="@(() => SwitchTab("backup"))">
                📦 本地灾备
            </div>

            <div class="settings-nav-item @(_settingsActiveTab == "ai" ? "active" : "")" @onclick="@(() => SwitchTab("ai"))">
                🤖 AI 助手
            </div>

            <div class="settings-nav-item @(_settingsActiveTab == "appearance" ? "active" : "")" @onclick="@(() => SwitchTab("appearance"))">
                🎨 外观与行为
            </div>
        </div>

        <div class="settings-body">
            <div class="settings-header">
                <h3>@GetTabTitle()</h3>
                <button class="settings-close-btn" @onclick="CancelSettings">×</button>
            </div>

            <div class="settings-scroll-area hide-scrollbar">
                @if (_settingsActiveTab == "sync")
                {
                    <div class="setting-row" style="padding-bottom: 20px; border-bottom: 1px solid var(--nt-border, #eaeaea);">
                        <div>
                            <div class="setting-label">开启后台自动同步</div>
                            <div class="setting-desc">开启后，应用会在后台静默合并云端数据（笔记与小说库共享此配置）。</div>
                        </div>
                        <input type="checkbox" @bind="_appSettings.EnableWebDavSync" class="setting-checkbox" />
                    </div>

                    <div class="setting-group" style="margin-top: 24px;">
                        <label class="setting-label">服务器地址 (Server URL)</label>
                        <input type="text" class="setting-input" @bind="_appSettings.WebDavUrl" placeholder="https://dav.jianguoyun.com/dav/" />
                        <div class="setting-desc">推荐使用坚果云。只填根目录即可，应用会自动创建子文件夹。</div>
                    </div>

                    <div class="setting-group">
                        <label class="setting-label">账号 (Username)</label>
                        <input type="text" class="setting-input" @bind="_appSettings.WebDavUsername" placeholder="例如：your-email@example.com" />
                    </div>

                    <div class="setting-group">
                        <label class="setting-label">应用授权密码 (App Password)</label>
                        <input type="password" class="setting-input" @bind="_webDavPassword" placeholder="请填入坚果云的第三方应用授权密码" />
                        <div class="setting-warning">⚠️ 绝不上传服务器。密码将调用底层的 DPAPI/Keychain 进行加密保护。</div>
                    </div>
                }

                @if (_settingsActiveTab == "backup")
                {
                    <div class="setting-row">
                        <div>
                            <div class="setting-label">开启静默自动打包</div>
                            <div class="setting-desc">系统将在后台将所有笔记和小说打包为 Zip 文件，并保存到本地 Backups 文件夹中。</div>
                        </div>
                        <input type="checkbox" @bind="_appSettings.EnableAutoBackup" class="setting-checkbox" />
                    </div>

                    <div style="display: flex; gap: 20px;">
                        <div class="setting-group" style="flex: 1;">
                            <label class="setting-label">自动备份频率</label>
                            <select class="setting-select" style="width: 100%;" @bind="_appSettings.BackupDayOfWeek" disabled="@(!_appSettings.EnableAutoBackup)">
                                <option value="Monday">每周一</option>
                                <option value="Wednesday">每周三</option>
                                <option value="Friday">每周五</option>
                                <option value="Sunday">每周日</option>
                            </select>
                        </div>
                        <div class="setting-group" style="flex: 1;">
                            <label class="setting-label">最大保留数量</label>
                            <input type="number" class="setting-input" @bind="_appSettings.MaxBackupCount" min="1" max="10" disabled="@(!_appSettings.EnableAutoBackup)" />
                        </div>
                    </div>

                    <div style="margin-top: 20px; padding-top: 24px; border-top: 1px dashed var(--nt-border, #eaeaea);">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                            <div class="setting-label" style="margin: 0;">历史备份列表</div>
                            <button type="button" class="btn-solid" style="background: #1976d2; padding: 4px 12px; font-size: 12px;" @onclick="TriggerManualBackup">💡 手动生成备份</button>
                        </div>

                        @if (!_backupFiles.Any())
                        {
                            <div style="padding: 20px; text-align: center; color: #999; font-size: 13px; background: rgba(0,0,0,0.02); border-radius: 8px;">
                                暂无任何备份文件
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: column; gap: 8px;">
                                @foreach (var file in _backupFiles)
                                {
                                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border: 1px solid var(--nt-border, #eaeaea); border-radius: 8px; background: #fff;">
                                        <div>
                                            <div style="font-size: 13px; font-weight: 600; color: #333; margin-bottom: 4px;">
                                                @(file.FileName.Contains("PreRestore") ? "🛡️ 恢复前保护快照" : "📦 自动/手动备份")
                                            </div>
                                            <div style="font-size: 11px; color: #888;">
                                                时间: @file.CreationTime.ToString("yyyy-MM-dd HH:mm:ss") <span style="margin-left: 12px;">大小: @file.SizeMB MB</span>
                                            </div>
                                        </div>
                                        <button class="btn-outline" style="color: #e65100; border-color: #ffcc80; font-size: 12px; padding: 4px 10px;" @onclick="() => RequestRestore(file)">↩️ 恢复此版本</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_settingsActiveTab == "ai")
                {
                    <div class="setting-group" style="padding-bottom: 20px; border-bottom: 1px dashed var(--nt-border, #eaeaea);">
                        <div class="setting-label">当前默认模型 (Default AI)</div>
                        <select class="setting-select" @bind="_appSettings.ActiveAiProviderId" style="width: 100%;">
                            @if (!_appSettings.AiProviders.Any())
                            {
                                <option value="">请先添加模型配置</option>
                            }
                            @foreach (var ai in _appSettings.AiProviders)
                            {
                                <option value="@ai.Id">@ai.Name (@ai.ModelName)</option>
                            }
                        </select>
                        <div class="setting-desc">此模型将被用于写作助手、文风润色以及笔记总结等全局功能。</div>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <div class="setting-label" style="margin: 0;">所有模型配置列表</div>
                        <button class="btn-outline" style="padding: 4px 12px; font-size: 12px;" @onclick="AddNewAiProvider">➕ 添加配置</button>
                    </div>

                    @foreach (var ai in _appSettings.AiProviders)
                    {
                        <div style="background: rgba(0,0,0,0.02); border: 1px solid @(_appSettings.ActiveAiProviderId == ai.Id ? "#1976d2" : "var(--nt-border, #ccc)"); padding: 16px; border-radius: 8px; margin-bottom: 16px; position: relative;">

                            @if (_appSettings.ActiveAiProviderId == ai.Id)
                            {
                                <div style="position: absolute; top: 8px; left: 8px; background: #1976d2; color: white; padding: 2px 6px; border-radius: 4px; font-size: 10px;">默认启用</div>
                            }

                            <button class="settings-close-btn" style="position: absolute; top: 8px; right: 12px; font-size: 18px; color: #ff4d4f;" title="删除" @onclick="() => RemoveAiProvider(ai)">×</button>
                            <button class="btn-outline" style="position: absolute; top: 8px; right: 40px; font-size: 11px; padding: 2px 8px;" @onclick="() => SetDefaultAi(ai.Id)">设为默认</button>

                            <div style="display: flex; gap: 12px; margin-top: 20px; margin-bottom: 12px;">
                                <div style="flex: 1;">
                                    <label class="setting-desc" style="font-weight:bold; color:#444;">配置名称 (显示用)</label>
                                    <input type="text" class="setting-input" @bind="ai.Name" placeholder="如: DeepSeek-Pro" />
                                </div>
                                <div style="flex: 1;">
                                    <label class="setting-desc" style="font-weight:bold; color:#444;">Model ID (模型ID)</label>
                                    <input type="text" class="setting-input" @bind="ai.ModelName" placeholder="如: deepseek-chat" />
                                </div>
                            </div>

                            <div style="margin-bottom: 12px;">
                                <label class="setting-desc" style="font-weight:bold; color:#444;">Base URL (接口地址)</label>
                                <input type="text" class="setting-input" @bind="ai.BaseUrl" placeholder="https://api.deepseek.com/v1" />
                            </div>

                            <div>
                                <label class="setting-desc" style="font-weight:bold; color:#444;">API Key (密钥)</label>
                                <input type="password" class="setting-input" placeholder="输入密钥，保存时自动加密"
                                       value="@GetAiKeyForUI(ai.Id)"
                                       @onchange="(e) => SetAiKeyForUI(ai.Id, e.Value?.ToString())" />
                            </div>
                        </div>
                    }
                }

                @if (_settingsActiveTab == "appearance")
                {
                    <div class="setting-group">
                        <div class="setting-label" style="margin-bottom: 12px;">主题模式 (Theme)</div>
                        <select class="setting-select" @bind="_appSettings.Theme" @bind:after="ApplyVisualPreview">
                            <option value="System">💻 跟随系统</option>
                            <option value="Light">☀️ 浅色模式</option>
                            <option value="Dark">🌙 深色模式</option>
                        </select>
                    </div>

                    <div class="setting-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <div class="setting-label">界面缩放 (Zoom)</div>
                            <div style="font-size: 13px; color: #1976d2; font-weight: 600;">@Math.Round(_appSettings.ZoomLevel * 100)%</div>
                        </div>

                        <div style="display: flex; align-items: center; gap: 16px;">
                            <span style="font-size: 12px; color: #999;">A</span>
                            <input type="range" min="0.8" max="1.3" step="0.05" style="flex: 1; cursor: pointer;"
                                   @bind="_appSettings.ZoomLevel" @bind:event="oninput" @bind:after="ApplyVisualPreview" />
                            <span style="font-size: 18px; color: #999;">A</span>
                        </div>
                    </div>
                }
            </div>

            <div class="settings-footer">
                <div class="footer-msg">
                    @if (_settingsActiveTab == "sync" && !string.IsNullOrEmpty(_connectionTestResult))
                    {
                        <span style="color: @(_connectionTestSuccess ? "#52c41a" : "#ff4d4f");">@_connectionTestResult</span>
                    }
                    @if (!string.IsNullOrEmpty(_warningMessage))
                    {
                        <span style="color: #52c41a;">@_warningMessage</span>
                    }
                </div>
                <div class="footer-actions">
                    @if (_settingsActiveTab == "sync")
                    {
                        <button type="button" class="btn-outline" @onclick="TestWebDavConnection" disabled="@_isTestingConnection">
                            @(_isTestingConnection ? "正在连接..." : "🔌 测试连接")
                        </button>
                    }
                    <button type="button" class="btn-outline" @onclick="CancelSettings">取消</button>
                    <button type="button" class="btn-solid" @onclick="SaveSettings">💾 保存全局配置</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (_showRestoreConfirm && _targetRestoreFile != null)
{
    <div class="modal-overlay" style="z-index: 2147483648; background: rgba(0,0,0,0.6);" @onclick="() => _showRestoreConfirm = false">
        <div class="modal-content" style="width: 420px; min-height: auto; padding: 30px; text-align: center; border: 2px solid #ff4d4f;" @onclick:stopPropagation="true">
            <h2 style="color: #ff4d4f; margin-top:0; font-size: 20px;">⚠️ 极其危险的操作</h2>
            <p style="font-size: 14px; margin-bottom: 8px;">即将将整个系统的状态回滚至：</p>
            <p style="background: rgba(255,0,0,0.05); padding: 8px; border-radius: 4px; font-weight: bold; font-family: monospace;">@_targetRestoreFile.FileName</p>

            <p style="font-size:12px; color:#888; text-align: left; background: #f9f9f9; padding: 12px; border-radius: 6px; margin-top: 16px;">
                <strong>系统保护机制：</strong><br />
                引擎会自动为您当前的最新状态创建一个名为 [PreRestore] 的保护快照。<br /><br />
                🚨 注意：恢复完成后，整个软件将被强制刷新重载。
            </p>

            <div style="margin-top: 24px; display: flex; gap: 12px; justify-content: center;">
                <button class="btn-outline" @onclick="() => _showRestoreConfirm = false" disabled="@_isRestoring">返回，我再想想</button>
                <button class="btn-solid" style="background: #ff4d4f; box-shadow: 0 4px 12px rgba(255,0,0,0.2);" @onclick="ExecuteRestore" disabled="@_isRestoring">
                    @(_isRestoring ? "正在粉碎并恢复..." : "确认恢复历史版本")
                </button>
            </div>
        </div>
    </div>
}


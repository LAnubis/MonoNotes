@using MonoNotes.Core.Models
@using MonoNotes.Core.Interfaces
@inject ISettingsService SettingsService
@inject IWebDavService WebDavService
@inject MonoNotes.UI.Services.VisualEngineService VisualEngine

<div class="global-settings-overlay" @onclick="CancelSettings">
    <div class="global-settings-content" @onclick:stopPropagation="true">

        <div class="settings-sidebar">
            <div class="sidebar-title">全局设置</div>

            <div class="settings-nav-item @(_settingsActiveTab == "sync" ? "active" : "")"
                 @onclick="@(() => _settingsActiveTab = "sync")">
                ☁️ 同步 (WebDAV)
            </div>

            <div class="settings-nav-item @(_settingsActiveTab == "appearance" ? "active" : "")"
                 @onclick="@(() => _settingsActiveTab = "appearance")">
                🎨 外观与行为
            </div>
        </div>

        <div class="settings-body">
            <div class="settings-header">
                <h3>@(_settingsActiveTab == "sync" ? "WebDAV 同步配置" : "外观与行为")</h3>
                <button class="settings-close-btn" @onclick="CancelSettings">×</button>
            </div>

            @if (_settingsActiveTab == "sync")
            {
                <div class="setting-row" style="padding-bottom: 20px; border-bottom: 1px solid var(--nt-border, #eaeaea);">
                    <div>
                        <div class="setting-label">开启后台自动同步</div>
                        <div class="setting-desc">开启后，应用会在后台静默合并云端数据（笔记与小说库共享此配置）。</div>
                    </div>
                    <input type="checkbox" @bind="_appSettings.EnableWebDavSync" class="setting-checkbox" />
                </div>

                <div class="setting-group">
                    <label class="setting-label">服务器地址 (Server URL)</label>
                    <input type="text" class="setting-input" @bind="_appSettings.WebDavUrl" placeholder="https://dav.jianguoyun.com/dav/" />
                    <div class="setting-desc">推荐使用坚果云。只填根目录即可，应用会自动创建子文件夹。</div>
                </div>

                <div class="setting-group">
                    <label class="setting-label">账号 (Username)</label>
                    <input type="text" class="setting-input" @bind="_appSettings.WebDavUsername" placeholder="例如：your-email@example.com" />
                </div>

                <div class="setting-group">
                    <label class="setting-label">应用授权密码 (App Password)</label>
                    <input type="password" class="setting-input" @bind="_webDavPassword" placeholder="请填入坚果云的第三方应用授权密码" />
                    <div class="setting-warning">
                        ⚠️ 绝不上传服务器。密码将调用底层的 DPAPI/Keychain 进行硬件级加密保护。
                    </div>
                </div>
            }

            @if (_settingsActiveTab == "appearance")
            {
                <div class="setting-group">
                    <div class="setting-label" style="margin-bottom: 12px;">主题模式 (Theme)</div>
                    <select class="setting-select" @bind="_appSettings.Theme" @bind:after="ApplyVisualPreview">
                        <option value="System">💻 跟随系统</option>
                        <option value="Light">☀️ 浅色模式</option>
                        <option value="Dark">🌙 深色模式</option>
                    </select>
                </div>

                <div class="setting-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <div class="setting-label">界面缩放 (Zoom)</div>
                        <div style="font-size: 13px; color: #1976d2; font-weight: 600;">@Math.Round(_appSettings.ZoomLevel * 100)%</div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 16px;">
                        <span style="font-size: 12px; color: #999;">A</span>
                        <input type="range" min="0.8" max="1.3" step="0.05" style="flex: 1; cursor: pointer;"
                               @bind="_appSettings.ZoomLevel" @bind:event="oninput" @bind:after="ApplyVisualPreview" />
                        <span style="font-size: 18px; color: #999;">A</span>
                    </div>
                    <div class="setting-desc" style="margin-top: 8px;">全局放大或缩小界面的字体与元素大小。</div>
                </div>
            }

            <div class="settings-footer">
                <div class="footer-msg">
                    @if (_settingsActiveTab == "sync" && !string.IsNullOrEmpty(_connectionTestResult))
                    {
                        <span style="color: @(_connectionTestSuccess ? "#52c41a" : "#ff4d4f");">@_connectionTestResult</span>
                    }
                    @if (!string.IsNullOrEmpty(_warningMessage))
                    {
                        <span style="color: #52c41a;">@_warningMessage</span>
                    }
                </div>
                <div class="footer-actions">
                    @if (_settingsActiveTab == "sync")
                    {
                        <button type="button" class="btn-outline" @onclick="TestWebDavConnection" disabled="@_isTestingConnection">
                            @(_isTestingConnection ? "正在连接..." : "🔌 测试连接")
                        </button>
                    }
                    <button type="button" class="btn-outline" @onclick="CancelSettings">取消</button>
                    <button type="button" class="btn-solid" @onclick="SaveSettings">💾 保存配置</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* 🌟 绝对脱离文档流，铺满全屏，强制弹性居中 */
    .global-settings-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(3px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2147483647; /* 保证在最顶层 */
    }

    .global-settings-content {
        width: 720px;
        min-height: 500px;
        display: flex;
        flex-direction: row;
        background: var(--nt-bg-main, #ffffff);
        color: var(--nt-text-main, #333333);
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        overflow: hidden;
        animation: scaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .settings-sidebar {
        width: 180px;
        background: var(--nt-bg-sidebar, #f7f8fa);
        border-right: 1px solid var(--nt-border, #eaeaea);
        padding: 24px 16px;
    }

    .sidebar-title {
        font-size: 11px;
        font-weight: 600;
        color: var(--nt-text-gray, #888);
        padding-left: 8px;
        margin-bottom: 16px;
        letter-spacing: 1px;
    }

    .settings-nav-item {
        padding: 12px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 4px;
        transition: all 0.2s;
        color: var(--nt-text-main, #444);
    }

        .settings-nav-item:hover {
            background-color: rgba(0,0,0,0.04);
        }

        .settings-nav-item.active {
            background-color: rgba(25, 118, 210, 0.1);
            color: #1976d2;
            font-weight: bold;
        }

    .settings-body {
        flex: 1;
        padding: 32px 40px;
        display: flex;
        flex-direction: column;
    }

    .settings-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
    }

        .settings-header h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 800;
        }

    .settings-close-btn {
        background: transparent;
        border: none;
        font-size: 24px;
        color: #999;
        cursor: pointer;
        transition: color 0.2s;
    }

        .settings-close-btn:hover {
            color: #333;
        }

    .setting-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .setting-group {
        margin-bottom: 24px;
    }

    .setting-label {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .setting-desc {
        font-size: 12px;
        color: #888;
        margin-top: 6px;
    }

    .setting-warning {
        font-size: 12px;
        color: #e65100;
        background: #fff3e0;
        padding: 8px 12px;
        border-radius: 6px;
        margin-top: 8px;
    }

    .setting-input, .setting-select {
        width: 100%;
        border: 1px solid var(--nt-border, #ccc);
        padding: 10px 14px;
        background: transparent;
        color: inherit;
        border-radius: 8px;
        font-size: 14px;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.2s;
    }

        .setting-input:focus, .setting-select:focus {
            border-color: #1976d2;
        }

    .setting-select {
        width: 200px;
        cursor: pointer;
    }

        .setting-select option {
            color: #333;
        }

    .setting-checkbox {
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .settings-footer {
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid var(--nt-border, #eaeaea);
    }

    .footer-msg {
        font-size: 13px;
        font-weight: 500;
    }

    .footer-actions {
        display: flex;
        gap: 12px;
    }

    .btn-outline {
        padding: 8px 16px;
        border: 1px solid var(--nt-border, #ccc);
        background: transparent;
        color: var(--nt-text-main, #333);
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-outline:hover {
            background: rgba(0,0,0,0.03);
        }

    .btn-solid {
        padding: 8px 24px;
        border: none;
        background: #1976d2;
        color: white;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        box-shadow: 0 4px 12px rgba(25, 118, 210, 0.2);
    }

        .btn-solid:hover {
            background: #1565c0;
        }

    @@keyframes scaleIn {
        from {
            transform: scale(0.95);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string _settingsActiveTab = "sync";
    private string _originalTheme = "System";
    private double _originalZoom = 1.0;

    private AppSettings _appSettings = new();
    private string _webDavPassword = string.Empty;

    private bool _isTestingConnection = false;
    private string _connectionTestResult = string.Empty;
    private bool _connectionTestSuccess = false;
    private string _warningMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _appSettings = await SettingsService.GetSettingsAsync();
        _webDavPassword = await SettingsService.GetSecurePasswordAsync("MonoNotes_WebDav_Password");

        _originalTheme = _appSettings.Theme;
        _originalZoom = _appSettings.ZoomLevel;
    }

    private async Task ApplyVisualPreview()
    {
        await VisualEngine.ApplySettingsAsync(_appSettings);
    }

    private async Task SaveSettings()
    {
        await SettingsService.SaveSettingsAsync(_appSettings);
        if (!string.IsNullOrWhiteSpace(_webDavPassword))
        {
            await SettingsService.SaveSecurePasswordAsync("MonoNotes_WebDav_Password", _webDavPassword.Trim());
        }
        else
        {
            SettingsService.RemoveSecurePassword("MonoNotes_WebDav_Password");
        }

        await VisualEngine.ApplySettingsAsync(_appSettings);
        _warningMessage = "设置保存成功！";
        StateHasChanged();

        await Task.Delay(1000);
        await OnClose.InvokeAsync();
    }

    private async Task CancelSettings()
    {
        _appSettings.Theme = _originalTheme;
        _appSettings.ZoomLevel = _originalZoom;
        await VisualEngine.ApplySettingsAsync(_appSettings);
        await OnClose.InvokeAsync();
    }

    private async Task TestWebDavConnection()
    {
        await SaveSettingsSilently();
        _warningMessage = "";
        _isTestingConnection = true;
        _connectionTestResult = "正在向云端发送握手请求...";
        StateHasChanged();

        _connectionTestSuccess = await WebDavService.TestConnectionAsync();
        if (_connectionTestSuccess)
        {
            _connectionTestResult = "✅ 连接成功！服务器响应正常。";
        }
        else
        {
            _connectionTestResult = "❌ 连接失败，请检查账号、密码或网络。";
        }

        _isTestingConnection = false;
        StateHasChanged();
    }

    private async Task SaveSettingsSilently()
    {
        await SettingsService.SaveSettingsAsync(_appSettings);
        if (!string.IsNullOrWhiteSpace(_webDavPassword))
        {
            await SettingsService.SaveSecurePasswordAsync("MonoNotes_WebDav_Password", _webDavPassword.Trim());
        }
        else
        {
            SettingsService.RemoveSecurePassword("MonoNotes_WebDav_Password");
        }
    }
}
@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string _settingsActiveTab = "sync";
    private string _originalTheme = "System";
    private double _originalZoom = 1.0;

    private AppSettings _appSettings = new();
    private string _webDavPassword = string.Empty;
    private Dictionary<string, string> _tempAiKeys = new();

    private bool _isTestingConnection = false;
    private string _connectionTestResult = string.Empty;
    private bool _connectionTestSuccess = false;
    private string _warningMessage = string.Empty;

    // 🌟 灾备相关状态
    private List<BackupFileInfo> _backupFiles = new();
    private bool _showRestoreConfirm = false;
    private BackupFileInfo? _targetRestoreFile;
    private bool _isRestoring = false;

    protected override async Task OnInitializedAsync()
    {
        _appSettings = await SettingsService.GetSettingsAsync();
        _webDavPassword = await SettingsService.GetSecurePasswordAsync("MonoNotes_WebDav_Password");

        if (_appSettings.AiProviders == null) _appSettings.AiProviders = new List<AiProvider>();

        if (!_appSettings.AiProviders.Any())
        {
            var def = new AiProvider { Name = "DeepSeek (推荐)", BaseUrl = "https://api.deepseek.com/v1", ModelName = "deepseek-chat" };
            _appSettings.AiProviders.Add(def);
            _appSettings.ActiveAiProviderId = def.Id;
        }

        foreach (var ai in _appSettings.AiProviders)
        {
            string key = await SettingsService.GetSecurePasswordAsync($"AI_Key_{ai.Id}");
            _tempAiKeys[ai.Id] = string.IsNullOrEmpty(key) ? "" : key;
        }

        _originalTheme = _appSettings.Theme;
        _originalZoom = _appSettings.ZoomLevel;
    }

    private void SwitchTab(string tab)
    {
        _settingsActiveTab = tab;
        _warningMessage = "";

        // 🌟 切到灾备面板时，立刻拉取最新备份列表
        if (tab == "backup")
        {
            LoadBackupFiles();
        }
    }

    private void LoadBackupFiles()
    {
        _backupFiles = BackupService.GetBackupFiles();
    }

    private string GetTabTitle() => _settingsActiveTab switch
    {
        "sync" => "WebDAV 同步配置",
        "backup" => "本地灾备控制台",
        "ai" => "AI 大脑模型管理",
        "appearance" => "外观与行为",
        _ => "设置"
    };

    // --- AI 相关 ---
    private void AddNewAiProvider()
    {
        var newAi = new AiProvider { Name = "新建模型", BaseUrl = "", ModelName = "" };
        _appSettings.AiProviders.Add(newAi);
        _tempAiKeys[newAi.Id] = "";
    }

    private void RemoveAiProvider(AiProvider ai)
    {
        _appSettings.AiProviders.Remove(ai);
        _tempAiKeys.Remove(ai.Id);
        if (_appSettings.ActiveAiProviderId == ai.Id)
            _appSettings.ActiveAiProviderId = _appSettings.AiProviders.FirstOrDefault()?.Id ?? "";
    }

    private void SetDefaultAi(string id)
    {
        _appSettings.ActiveAiProviderId = id;
        StateHasChanged();
    }

    private string GetAiKeyForUI(string id) => _tempAiKeys.TryGetValue(id, out var k) ? k : "";
    private void SetAiKeyForUI(string id, string? val) => _tempAiKeys[id] = val ?? "";

    // --- 🌟 灾备相关 ---
    private async Task TriggerManualBackup()
    {
        _warningMessage = "正在静默打包您的数字宇宙，请稍候...";
        StateHasChanged();
        await Task.Delay(100);

        bool success = await BackupService.ExecuteManualBackupAsync();
        if (success)
        {
            _warningMessage = "✅ 手动备份大成功！列表已刷新。";
            LoadBackupFiles(); // 重新加载列表
        }
        else
        {
            _warningMessage = "❌ 备份失败，可能文件正被系统占用。";
        }
        StateHasChanged();
    }

    private void RequestRestore(BackupFileInfo file)
    {
        _targetRestoreFile = file;
        _showRestoreConfirm = true;
    }

    private async Task ExecuteRestore()
    {
        if (_targetRestoreFile == null) return;

        _isRestoring = true;
        StateHasChanged();
        await Task.Delay(100); // 让 UI 有时间显示“正在粉碎并恢复...”

        bool success = await BackupService.RestoreFromBackupAsync(_targetRestoreFile.FilePath);

        if (success)
        {
            // 🌟 强行重载整个应用，以加载最新的被解压文件
            NavManager.NavigateTo("/", true);
        }
        else
        {
            _isRestoring = false;
            _showRestoreConfirm = false;
            _warningMessage = "❌ 恢复失败！请检查系统权限或日志。";
            StateHasChanged();
        }
    }

    // --- 其他常规配置 ---
    private async Task ApplyVisualPreview() { await VisualEngine.ApplySettingsAsync(_appSettings); }

    private async Task SaveSettings()
    {
        await SettingsService.SaveSettingsAsync(_appSettings);
        if (!string.IsNullOrWhiteSpace(_webDavPassword))
            await SettingsService.SaveSecurePasswordAsync("MonoNotes_WebDav_Password", _webDavPassword.Trim());
        else
            SettingsService.RemoveSecurePassword("MonoNotes_WebDav_Password");

        foreach (var ai in _appSettings.AiProviders)
        {
            string key = GetAiKeyForUI(ai.Id);
            if (!string.IsNullOrWhiteSpace(key))
                await SettingsService.SaveSecurePasswordAsync($"AI_Key_{ai.Id}", key.Trim());
            else
                SettingsService.RemoveSecurePassword($"AI_Key_{ai.Id}");
        }

        await VisualEngine.ApplySettingsAsync(_appSettings);
        _warningMessage = "设置保存成功！";
        StateHasChanged();

        await Task.Delay(1000);
        await OnClose.InvokeAsync();
    }

    private async Task CancelSettings()
    {
        _appSettings.Theme = _originalTheme;
        _appSettings.ZoomLevel = _originalZoom;
        await VisualEngine.ApplySettingsAsync(_appSettings);
        await OnClose.InvokeAsync();
    }

    private async Task TestWebDavConnection()
    {
        // 🌟 1. 移除了 SaveSettingsSilently()，彻底实现不保存直接测试！

        _warningMessage = "";
        _isTestingConnection = true;
        _connectionTestResult = "正在向云端发送握手请求...";
        StateHasChanged();

        try
        {
            // 🌟 2. 调用我们刚写好的带参数方法，直接把输入框里的值传进去
            _connectionTestSuccess = await WebDavService.TestSpecificConnectionAsync(
                _appSettings.WebDavUrl,
                _appSettings.WebDavUsername,
                _webDavPassword);

            if (_connectionTestSuccess)
            {
                _connectionTestResult = "✅ 连接成功！服务器响应正常。";
            }
        }
        catch (Exception ex)
        {
            // 🌟 3. UI 完美接住了底层抛出的 Exception，不会再崩溃了！
            _connectionTestSuccess = false;
            _connectionTestResult = $"❌ {ex.Message}";
        }
        finally
        {
            // 无论成功还是失败，最后都要解除按钮的 Loading 状态
            _isTestingConnection = false;
            StateHasChanged();
        }
    }
}